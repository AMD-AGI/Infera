# Site profile: the MI300X (gfx942) SLURM cluster behind useocpm2m-097-*.
#
#   INFERA_E2E_SITE=mi300x-rccl tests/run_tests.sh e2e vllm mixed
#
# Sourced by tests/run_tests.sh, which defines site_default: each line below
# fills a variable in ONLY if the caller left it unset, so anything exported on
# the command line still wins. See that block for the rest of the reasoning.
#
# Everything here was measured on the fleet; what is deliberately NOT set is
# documented at the bottom, because an absent line is a decision too.

# Pre-staged model tree, read-only mounted into every e2e container and
# resolved per model as <dir>/<hf repo id> (harness/matrix.py: resolve_model).
# On shared NFS, so the compute nodes and the disagg orchestrator all see it.
site_default INFERA_E2E_MODEL_DIR /iad-rccl-shared-3/liyingli/models

# The GPU partition. amd-arad and amd-arad-burst hold the same hardware; rccl is
# the one with the whole fleet in it.
site_default INFERA_E2E_SLURM_PARTITION amd-rccl

# Declared, not probed: the whole fleet is gfx942, while a probe answers for
# whichever host you submit from — and on a GPU-less login host it falls back to
# gfx950 and then builds the gfx950 sglang image for a gfx942 node. Revisit if
# this partition ever gains nodes of another arch, because a declaration is then
# a per-fleet answer to a per-node question. What does and does not verify it:
# manual/wip/gfx942-e2e-matrix.md, open question 4.
site_default INFERA_E2E_GFX_ARCH gfx942

# Always go through the scheduler. The submit hosts on this fleet are themselves
# partition members with eight MI300X each, so the card count that _local_eligible
# uses reads as "run in place" while those cards are in fact carrying somebody
# else's job. _dispatch_slurm re-exports this as 1 on the node it lands on, so the
# remote leg still runs in place as it must.
site_default INFERA_E2E_LOCAL 0

# These nodes reach repo.radeon.com, pypi and github but time out on
# archive.ubuntu.com over both http and https, which breaks every engine image
# in Mooncake's dependencies.sh. Redirect apt at the mirror the hosts themselves
# use (an Oracle regional one); security.ubuntu.com answers, but only over https.
# See deploy/docker/scripts/apt_mirror.sh.
site_default INFERA_E2E_BUILD_ARGS \
    "APT_MIRROR=https://iad-ad-1.clouds.archive.ubuntu.com/ubuntu/,APT_SECURITY_MIRROR=https://security.ubuntu.com/ubuntu/"

# Ten mlx5 rails per node, and Mooncake's auto-discovery puts the two PD legs on
# different ones (seen spread over mlx5_1/6/9), after which the QP never reaches
# RTR and the decode leg reports "Failed to get kvcache from prefill instance".
# MC_TE_FILTERS is Mooncake's own device filter and reaches every engine: it is
# injected into both workers by cluster.kv_transport_env(), and ATOM's conftest
# additionally turns it into its ib_device config key.
site_default INFERA_E2E_WORKER_ENV MC_TE_FILTERS=mlx5_0

# --- deliberately unset ------------------------------------------------------
# INFERA_E2E_GID_INDEX — an RDMA port carries several GIDs and only some are
#     routable; Mooncake has to be pointed at one of those or the handshake times
#     out. cluster.py's DEFAULT_GID_INDEX (1) is already the routable one on this
#     fabric — measured, with vLLM disagg reporting rdma. ci.yml sets 3 because
#     its rail is an mlx5 whose 0 and 1 are both link-local.
# INFERA_E2E_RESERVATION — this fleet has no CI reservation; the tiers queue on
#     the open partition like any other job. Consequence worth knowing: with no
#     reservation, _candidate_nodes falls through to its sinfo branch, so the
#     node-picking predicate (_node_free) is load-bearing here and inert on CI.
