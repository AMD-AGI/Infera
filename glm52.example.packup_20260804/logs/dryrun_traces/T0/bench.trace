### SSH node-P
docker exec glm52_pd bash -c 'mkdir -p /tmp/glm52_bench &&     python3 -m sglang.bench_serving       --backend sglang-oai-chat --base-url http://10.0.0.1:8100       --model glm5.2-mxfp4 --tokenizer /weights/GLM-5.2-MXFP4       --dataset-name random --random-input-len 8192 --random-output-len 1024       --random-range-ratio 1.0       --max-concurrency 8 --num-prompts 80 --request-rate inf       --warmup-requests 8       --cache-report --temperature 1.0 --top-p 0.95       --output-file /tmp/glm52_bench/glm52_isl8192_osl1024_c8.jsonl --output-details 2>&1 | tail -30'
