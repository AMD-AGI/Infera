### SSH node-P
docker exec glm52_pd bash -c "mkdir -p /tmp/kvd /tmp/kvd-long && rm -f /tmp/kvd/kvd.sock && printf '%s\n' '#!/bin/bash' 'exec python3 -m infera.kvd --socket /tmp/kvd/kvd.sock --max-bytes 64G --long-path /tmp/kvd-long --long-bytes 64G --log-level INFO' > /run_kvd.sh && chmod +x /run_kvd.sh"
### SSH node-P
docker exec -d glm52_pd bash -c 'nohup /run_kvd.sh > /tmp/kvd.log 2>&1'
### SSH node-P
docker exec glm52_pd bash -c "test -S /tmp/kvd/kvd.sock && echo '  kvd socket OK on node-P' || { echo '  KVD FAILED on node-P'; tail -20 /tmp/kvd.log; }"
