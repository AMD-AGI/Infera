+    if (const char* value = std::getenv("MC_IB_TIMEOUT")) {
+        auto text = trimConfigToken(value);
+        if (!text.empty() && text.front() == '+') text.erase(0, 1);
+        unsigned parsed = 0;
+        const auto result =
+            std::from_chars(text.data(), text.data() + text.size(), parsed);
+        if (result.ec == std::errc{} &&
+            result.ptr == text.data() + text.size() && parsed >= 1 &&
+            parsed <= 31) {
+            config.ib_timeout = static_cast<int>(parsed);
+        } else {
+            LOG(WARNING) << "Invalid MC_IB_TIMEOUT: " << value
+                         << "; expected an integer in [1, 31], keeping "
+                         << config.ib_timeout;
+        }
+    }
