+// Max concurrent buffer registrations in registerLocalMemoryBatch. Env:
+// MC_REG_MR_BATCH_THREADS. Default: 1 on ROCm builds, unbounded elsewhere.
+static size_t registerBatchConcurrency() {
+    const char *env = std::getenv("MC_REG_MR_BATCH_THREADS");
+    if (env) {
+        long v = std::atol(env);
+        if (v >= 1) return static_cast<size_t>(v);
+    }
+#ifdef USE_HIP
+    return 1;
+#else
+    return std::numeric_limits<size_t>::max();
+#endif
