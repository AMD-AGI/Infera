+@pytest.mark.parametrize("count", [2, 8, 16])
+def test_block_when_whole_port_space_is_ephemeral(monkeypatch, tmp_path, count) -> None:
+    """``ip_local_port_range`` starting at 1024 leaves no room below it.
+
+    Measured on a live node (chi2835: ``1024   65535``), where a prefill leg
+    with ``--dp-size 8 --enable-dp-attention`` died before spawning sglang:
+
+        File "infera/common/net.py", line 107, in free_tcp_port_block
+          randomised = [random.randint(1024, highest) ...]
+        ValueError: empty range for randrange() (1024, 1017, -7)
+
+    The block must come from somewhere valid instead of raising. It cannot sit
+    below the ephemeral range because there is nothing below it, so the only
+    requirements left are: in range, contiguous, bindable, and outside the
+    NodePort window.
+    """
+    fake = tmp_path / "ip_local_port_range"
+    fake.write_text("1024\t65535\n")
+    real_open = open
+
+    def fake_open(path, *a, **kw):
+        if str(path) == "/proc/sys/net/ipv4/ip_local_port_range":
+            return real_open(fake, *a, **kw)
+        return real_open(path, *a, **kw)
+
+    monkeypatch.setattr("builtins.open", fake_open)
+
+    base = free_tcp_port_block(count)
+    assert 1024 <= base and base + count - 1 <= 65535
+    assert not _overlaps(base, count, _DEFAULT_LO, _DEFAULT_HI)
+
+    socks = []
+    try:
+        for off in range(count):
+            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+            s.bind(("127.0.0.1", base + off))
+            socks.append(s)
+    finally:
+        for s in socks:
+            s.close()
