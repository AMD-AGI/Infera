# llr34 (task llrepro 2026-10-26) = llr32 (current best 47,447) with the MTP draft experts in online MXFP4 (our patch, --speculative-draft-model-quantization quark_mxfp4) instead of online FP8 (PTPC off) ONLY. Sim acceptance kept at 2.99 (real MXFP4 acceptance measured lower on REDACTED_NODE: K5 3.16-3.42 vs bf16 3.55).
# moved to our nodes: prefill compute-node-03 GPU4-7, decode compute-node-04 GPU4-7, all 8 ionic rails, C80 3600 s.
export PREFILL_NODE_IP=node-04.invalid DECODE_NODE_IP=node-03.invalid DECODE_SSH=compute-node-04
export MODEL=REDACTED_LOCAL_PATH SERVED_MODEL=glm5.2-mxfp4
export IMAGE=historical-sglang-image-b
export WORK_DIR=REDACTED_LOCAL_PATH
export RDMA_DEVICES=ionic_0,ionic_1,ionic_2,ionic_3,ionic_4,ionic_5,ionic_6,ionic_7 MC_GID_INDEX=1 MOONCAKE_DISABLE_HIP_DMABUF=0
export PREFILL_WORKERS=1 PREFILL0_GPUS=4,5,6,7 PREFILL1_GPUS=4,5,6,7 DECODE_GPUS=4,5,6,7 PP4_CHUNK=8192
export SIM_ACCEPT_LEN=2.99 PREFILL_EXTRA_ARGS='--json-model-override-args {"index_share_for_mtp_iteration":true} --pp-async-batch-depth 1 --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4' DECODE_EXTRA_ARGS='--json-model-override-args {"index_share_for_mtp_iteration":true} --mem-fraction-static 0.93 --stream-interval 30 --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4 --speculative-draft-model-quantization quark_mxfp4' ROUTER_EXTRA_ARGS=
export CONC=96 DURATION=3600 WARMUP_PER_LANE=10
export CTR=historical-e2e-container
export DECODE_MOUNT_EXTRA="REDACTED_LOCAL_PATH REDACTED_LOCAL_PATH REDACTED_LOCAL_PATH REDACTED_LOCAL_PATH"
export DECODE_ENV_EXTRA="PYTHONPATH=REDACTED_LOCAL_PATH INFERA_KERNEL_SPARSE=1 INFERA_KERNEL_INDEXER=1 INFERA_KERNEL_MOE=1 SGLANG_OPT_USE_TOPK_V2=false SGLANG_CLIP_MAX_NEW_TOKENS_ESTIMATION=8"
export DECODE_CUSTOM_AR=1
export PREFILL_ENV_EXTRA="SGLANG_PP_COMM_OVERLAP=1"
