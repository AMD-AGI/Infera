+@triton.jit
+def _sel_est_kernel(logits_ptr, lens_ptr, ctr_ptr, crow_ptr, stride_l, rows,
+                    CH: tl.constexpr, NCH: tl.constexpr, TOPK: tl.constexpr, OVER: tl.constexpr,
+                    WCH: tl.constexpr, RMAX: tl.constexpr, CSTR: tl.constexpr, NB: tl.constexpr):
