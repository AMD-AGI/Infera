+    ro = tl.arange(0, RMAX)
+    La = tl.maximum(tl.load(lens_ptr + ro, mask=ro < rows, other=0), 0)
+    na = (La + (WCH - 1)) // WCH
+    pref = tl.sum(tl.where(ro < r, na, 0), 0)
+    nch = (L + (WCH - 1)) // WCH
