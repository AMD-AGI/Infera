+    m = tl.minimum(m1, m2)
+    return m, tl.where(m1 == m, c1, 0) + tl.where(m2 == m, c2, 0)
+
+
+@triton.jit
+def _maxcnt(m1, c1, m2, c2):
+    m = tl.maximum(m1, m2)
+    return m, tl.where(m1 == m, c1, 0) + tl.where(m2 == m, c2, 0)
