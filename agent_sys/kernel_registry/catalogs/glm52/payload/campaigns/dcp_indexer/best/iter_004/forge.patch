+@gluon.jit
+def _sel_collect_kernel(logits_ptr, lens_ptr, ctr_ptr, crow_ptr, ckey_ptr, cidx_ptr, rows, stride_l,
+                        CAND: gl.constexpr, CSTR: gl.constexpr, NW: gl.constexpr, J: gl.constexpr,
+                        GRID: gl.constexpr):
+    # Warp w of a program handles one warp piece = WCH = 256 * J consecutive logits of one row (lane l holds the
+    # 16-byte vectors jj * 64 + l, coalesced). Selected keys keep their memory order: slot = base + (number of
+    # selected elements before it in the piece) (one warp-local scan), base = one atomic per warp piece, so the
+    # candidate stores of a warp instruction land in a short contiguous span.
+    WCH: gl.constexpr = J * 256
+    L2D: gl.constexpr = gl.BlockedLayout([1, 4], [1, 64], [NW, 1], [1, 0])
+    SW: gl.constexpr = gl.SliceLayout(1, L2D)
+    SE: gl.constexpr = gl.SliceLayout(0, L2D)
+    pid = gl.program_id(0)
+    total = gl.load(ctr_ptr + rows * CSTR)
+    wv = gl.arange(0, NW, layout=SW)
+    e2 = gl.expand_dims(gl.arange(0, WCH, layout=SE), 0)          # [1, WCH]
+    v2 = (e2 // 4) * 4                                             # 16-byte vector start
+    first = e2 == 0
+    for rb in range(pid * NW, total, GRID * NW):
+        wc = rb + wv
+        ok = wc < total
+        ent = gl.load(crow_ptr + wc, mask=ok, other=0)
+        r_w = ent >> 16
+        Lw = gl.load(lens_ptr + r_w, mask=ok, other=0)            # 0 for idle warps -> nothing selected
+        thw = gl.load(ctr_ptr + r_w * CSTR, mask=ok, other=0)
+        s2 = gl.expand_dims((ent & 65535) * WCH, 1)
+        L2 = gl.expand_dims(Lw, 1)
+        i2 = s2 + e2                                               # [NW, WCH] index in the row
+        # 16-byte-granular load mask (row width is a multiple of 64 and >= L, so the tail vector is in bounds);
+        # `i2 < L` gates selection. 32-bit offsets: the host asserts the logits fit in 2**31 bytes.
+        b = gl.amd.cdna3.buffer_load(ptr=logits_ptr, offsets=gl.expand_dims(r_w * stride_l, 1) + i2,
+                                     mask=(s2 + v2) < L2, other=-1)
+        key = gl.where(b >= 0, b, (~b) ^ (-2147483648))
+        sel = ((i2 < L2) & (key >= gl.expand_dims(thw, 1))).to(gl.int32)
+        inc = gl.associative_scan(sel, 1, _sum_combine)
+        cw = gl.sum(sel, 1)
+        old = gl.atomic_add(ctr_ptr + gl.expand_dims(r_w * CSTR + 1, 1) + e2 * 0, gl.expand_dims(cw, 1) + e2 * 0,
+                            mask=first & gl.expand_dims(ok, 1), sem="relaxed")
+        base = gl.sum(gl.where(first, old, 0), 1)                  # lane 0's reservation, broadcast to the warp
+        dst = gl.expand_dims(base, 1) + inc - sel
+        off = gl.expand_dims(r_w * CAND, 1) + dst
+        mm = (sel != 0) & (dst < CAND)
+        gl.amd.cdna3.buffer_store(key, ptr=ckey_ptr, offsets=off, mask=mm)
+        gl.amd.cdna3.buffer_store(i2, ptr=cidx_ptr, offsets=off, mask=mm)
