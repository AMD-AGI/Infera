+@triton.jit
+def _kval(x):
+    # ordered key (int64 holding an int32 key) -> its fp32 value
+    xi = x.to(tl.int32)
+    return tl.where(xi >= 0, xi, (~xi) ^ (-2147483648)).to(tl.float32, bitcast=True)
+
