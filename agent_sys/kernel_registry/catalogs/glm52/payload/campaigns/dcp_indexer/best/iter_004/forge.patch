+@gluon.jit
+def _uniform_i32(x):
+    # v_readfirstlane into an SGPR: the value is provably uniform, so loop bounds / buffer bases stay scalar.
+    return gl.inline_asm_elementwise(
+        "s_nop 4\n v_readfirstlane_b32 $0, $1\n s_nop 4",
+        "=s,v", [x], dtype=gl.int32, is_pure=True, pack=1,
+    )
