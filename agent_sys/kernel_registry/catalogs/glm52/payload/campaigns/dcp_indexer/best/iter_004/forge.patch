+    else:
+        o = o * ks[None, :]
+        o = gl.maximum(o, 0.0)
+        o = o * w[:, None]
+        logits = gl.reduce(o, axis=0, combine_fn=_sum_combine)
+    gl.amd.cdna3.buffer_store(logits, ptr=out_ptr, offsets=cols)
