+@triton.jit
+def _vkey(v):
+    # fp32 value -> ordered key (int64)
+    bi = v.to(tl.int32, bitcast=True)
+    return tl.where(bi >= 0, bi, (~bi) ^ (-2147483648)).to(tl.int64)
