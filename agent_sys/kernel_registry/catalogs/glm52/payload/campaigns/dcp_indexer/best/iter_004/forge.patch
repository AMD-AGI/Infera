+@triton.jit
+def _sel_est_kernel(logits_ptr, lens_ptr, ctr_ptr, crow_ptr, stride_l, rows,
+                    CH: tl.constexpr, NCH: tl.constexpr, TOPK: tl.constexpr, OVER: tl.constexpr,
+                    WCH: tl.constexpr, RMAX: tl.constexpr, CSTR: tl.constexpr, NB: tl.constexpr):
+    r = tl.program_id(0)
+    L = tl.maximum(tl.load(lens_ptr + r), 0)
+    k = tl.minimum(L, TOPK)
+    # collect work table: row r's warp pieces are entries [pref, pref + nch), each (r << 16) | piece
+    ro = tl.arange(0, RMAX)
+    La = tl.maximum(tl.load(lens_ptr + ro, mask=ro < rows, other=0), 0)
+    na = (La + (WCH - 1)) // WCH
+    pref = tl.sum(tl.where(ro < r, na, 0), 0)
+    nch = (L + (WCH - 1)) // WCH
+    if r == 0:
+        tl.store(ctr_ptr + rows * CSTR, tl.sum(na, 0))
