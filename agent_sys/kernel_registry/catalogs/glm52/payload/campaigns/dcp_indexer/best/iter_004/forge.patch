+# ===========================================================================
+# In-file exact local top-k that writes the pack (replaces fast_topk_v2 + pack_candidates_triton).
+#   K1 est     : per row, a threshold from CH * NCH sampled logits (rows with L <= CH * NCH: the whole row) that
+#                leaves ~OVER * k keys above it in the row; also the collect work table and the counter reset.
+#   K2 collect : one pass over the logits; every key >= the row threshold is appended to the row's candidate
+#                buffer. Each warp owns a WCH-element piece of one row and reserves its slots with one atomic.
+#   K3 select  : per row, the exact top-k of the candidates: a bracketed count search (_count_search) for a key t
+#                with count(key >= t) == k, or the k-th largest key t if ties straddle the cut (then the tied keys
+#                with the lowest column indices are kept, as torch.topk does), then the pack
+#                [2, rows, TOPK] = (fp32 score bits, request position), -inf / -1 padded beyond k = min(L, TOPK).
+#                Guard: the candidates hold the exact top-k iff k <= count <= CAND (count >= k means the k-th key
+#                is >= the threshold; count <= CAND means nothing was dropped); otherwise the workgroup runs an
+#                exact count search over the whole row (device-side branch; never taken on the driver's rows).
+# Keys are fp32 bits mapped to order-preserving int32 (-0.0 < +0.0, like torch.topk's radix order).
+# Launch shapes depend only on the number of rows and the logits width (CUDA-graph safe). Pack order is free.
+# ===========================================================================
+_SEL_CAND = 8192          # candidates per row (cap)
+_SEL_OVER = 2             # target candidates = OVER * k
+_SEL_CH = 128             # sample probe length
+_SEL_NCH = 64             # probes per row
+_SEL_CSTR = 64            # int32 gap between rows' counters (separate cache lines for the atomics)
+_COL_NW = 4               # collect warps per program
+_COL_J = 4                # 16-byte vectors per lane -> one warp piece = 256 * J elements
+_COL_GRID = 1024          # persistent collect programs
+_SEL_NW = 4               # select warps
+_SEL_FB = 2048            # fallback tile width
+_SEL_DEBUG = False
