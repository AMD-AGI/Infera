+# Wide-head DCP decode (measured on MI355X, GLM-5.2 DCP4, 64 all-gathered heads, ~512 owned
+# slots per row): one program per row covering all 64 heads. The H=16 head blocks gathered every
+# row's KV 4 times and, with M=16, computed QK^T + softmax redundantly on all 4 waves; with M=64
+# and 16x16 MFMA the 4 waves split the heads. matrix_instr_nonkdim=16 is required: the default
+# picks 32x32 MFMA here, which spills and is slower than the H=16 path.
+_DCP_WIDE_BLOCK_H = 64
+_DCP_WIDE_BLOCK_K = 64
+_DCP_WIDE_PIPE_STAGES = 3
+_DCP_WIDE_NUM_WARPS = 4
+# One [64, 512] q_nope load instead of four [64, 128] ones (see Q_ONE_LOAD). Do not add
+# schedule_hint="memory-bound-attention" (LLVM iterative-ilp): it miscompiles this kernel (SNR ~15 dB).
+_DCP_WIDE_Q_ONE_LOAD = True
+# Empty-row select on the per-row scale (see ROW_SCALE_SELECT).
+_DCP_WIDE_ROW_SCALE_SELECT = True
+# The wide binary needs ~447 registers per lane, so one 4-wave workgroup (= one row) is resident per CU.
+_DCP_WIDE_WG_PER_CU = 1
+
+
+def _dcp_overflow_splits(n_over: int, n_full: int) -> int:
+    """Pieces per overflow row (shape-only): rows past the resident n_full would otherwise run a second, mostly
+    empty round of whole rows; split each into tile ranges so the pieces fill the CUs the full rows free up."""
+    if n_over <= 0 or n_over > n_full // 2:
+        return 1
+    return 4 if n_over <= n_full // 4 else 2
+
+
+def _use_dcp_wide_decode(
+    kv_dtype: torch.dtype,
+    H: int,
+    d_v: int,
+    d_tail: int,
+    kv_dim: int,
+    bs: int,
+    num_cu: int,
+) -> bool:
+    """Shape-only gate (CUDA-graph safe): FP8 gfx950 DCP decode with enough rows."""
+    return (
+        kv_dtype != torch.bfloat16
+        and H % _DCP_WIDE_BLOCK_H == 0
+        and d_v == 512
+        and d_tail == 64
+        and kv_dim == 576
+        and bs * (H // _DCP_WIDE_BLOCK_H) >= num_cu // 2
+        and is_gfx95_supported()
+    )
+
+
+def _launch_dcp_wide(
+    q_nope: torch.Tensor,
+    q_rope: torch.Tensor,
+    kv: torch.Tensor,
+    idx_flat: torch.Tensor,
+    topk_length: torch.Tensor,
+    return_lse: bool,
+    qk_scale: float,
+    stride_qn_t: int,
+    stride_qn_h: int,
+    stride_qr_t: int,
+    stride_qr_h: int,
+    topk: int,
+    H: int,
+    d_v: int,
+    d_tail: int,
+    kv_dim: int,
+    num_cu: int,
+) -> tuple[torch.Tensor, torch.Tensor | None]:
+    """Returns (out [bs, H, d_v] bf16, lse [bs, H] fp32 or None)."""
+    bs = q_nope.shape[0]
+    device = q_nope.device
+    n_full = num_cu * _DCP_WIDE_WG_PER_CU
+    n_over = bs - n_full
+    split_s = 1
+    if return_lse and H == _DCP_WIDE_BLOCK_H:
+        split_s = _dcp_overflow_splits(n_over, n_full)
+    if split_s > 1:
+        # Rows [bs, bs + n_over * split_s) of out/lse hold the pieces' partials
+        # ([n_over, split_s, H(, d_v)]); the caller only sees rows [0, bs).
+        n_part = n_over * split_s
+        out_ext = torch.empty(bs + n_part, H, d_v, device=device, dtype=torch.bfloat16)
