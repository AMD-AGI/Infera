+            q_nope,
+            q_rope,
+            kv,
+            idx_flat,
+            topk_length,
+            out,
+            qk_scale,
+            _FP8_MAX,
+            topk=topk,
+            H=H,
+            KV_DIM=kv_dim,
+            D_V=d_v,
+            D_TAIL=d_tail,
+            NUM_GROUPS=d_v // 128,
+            STRIDE_QN_T=stride_qn_t,
+            STRIDE_QN_H=stride_qn_h,
+            STRIDE_QR_T=stride_qr_t,
+            STRIDE_QR_H=stride_qr_h,
+            USE_FP8_DOT=True,
+            USE_TOPK_LENGTH=True,
