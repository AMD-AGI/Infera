{
  "mcpServers": {
    "envchk_baseline": {
      "type": "stdio",
      "command": "python3",
      "args": ["${CLAUDE_CONFIG_DIR}/servers/envchk_baseline_server.py"],
      "env": {
        "ENVCHK_NONCE": "${ENVCHK_NONCE}"
      }
    },
    "serena": {
      "type": "stdio",
      "command": "${UV_TOOL_BIN_DIR}/serena",
      "args": [
        "start-mcp-server",
        "--context", "claude-code",
        "--project", "${AGENT_SYS_MY_WORKSPACE}",
        "--transport", "stdio"
      ],
      "env": {
        "HOME": "${TMPDIR}"
      }
    }
  }
}
