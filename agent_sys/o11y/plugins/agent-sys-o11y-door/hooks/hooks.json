{
  "description": "agent_sys o11y door: backstop for writes to the run ledger that bypass the door",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/backstop.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
