#!/bin/sh
# The analysis launch contract (design §8.1): o11y-run --kind extract|log|facts [--fleet-dir D] [--force].
# Env from the trigger: AGENT_SYS_O11Y_FLEET_DIR, CLAUDE_CONFIG_DIR, AGENT_SYS_HOME. Exit 0 = drained or the
# kind's lock is busy; non-zero = a failure (one line on stderr).
# Python: the o11y venv in agent_sys's prefix ($AGENT_SYS_HOME, else $HOME/.infera_agent_sys), else python3.
# PYTHONPATH: this server dir, the protocol library (<plugin>/protocol -> agent_sys/o11y/protocol) and the
# door's server dir (<plugin>/door -> ../agent-sys-o11y-door/server; its api is the jobs' only writer).
set -eu
here=$(cd "$(dirname "$0")" && pwd)
[ "${1:-}" = "--kind" ] && [ $# -ge 2 ] || { echo "usage: o11y-run --kind extract|log|facts [--fleet-dir D] [--force]" >&2; exit 2; }
case "$2" in
  extract|log|facts) mod="o11y_$2" ;;
  *) echo "o11y-run: unknown kind: $2" >&2; exit 2 ;;
esac
shift 2
prefix=${AGENT_SYS_HOME:-${HOME:?}/.infera_agent_sys}
py=python3
[ -x "$prefix/share/o11y/venv/bin/python" ] && py="$prefix/share/o11y/venv/bin/python"
PYTHONPATH="$here:$here/../protocol/py:$here/../door${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m "$mod" "$@"
