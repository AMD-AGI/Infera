{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "registry.sessions.v1.schema.json",
 "title": "Normalised fleet registry (registry/sessions.json)",
 "type": "object",
 "required": [
  "v",
  "generated_at",
  "sessions"
 ],
 "properties": {
  "v": {
   "const": 1
  },
  "generated_at": {
   "$ref": "common.v1.schema.json#/$defs/time"
  },
  "main_session_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "sessions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "session_id",
     "pid",
     "alive",
     "role",
     "status"
    ],
    "properties": {
     "session_id": {
      "type": "string",
      "minLength": 1
     },
     "pid": {
      "type": "integer",
      "minimum": 1
     },
     "proc_start": {
      "type": [
       "string",
       "null"
      ]
     },
     "alive": {
      "type": "boolean"
     },
     "crashed": {
      "type": "boolean",
      "description": "record present, process gone or procStart mismatch; a dead former main stays listed (active false) for a retention window"
     },
     "name": {
      "type": [
       "string",
       "null"
      ]
     },
     "cwd": {
      "type": [
       "string",
       "null"
      ]
     },
     "tmux": {
      "type": [
       "string",
       "null"
      ]
     },
     "transcript_path": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "enum": [
       "busy",
       "idle",
       "waiting",
       "shell",
       "unknown"
      ]
     },
     "waiting_for": {
      "type": [
       "string",
       "null"
      ]
     },
     "status_since": {
      "$ref": "common.v1.schema.json#/$defs/time"
     },
     "role": {
      "enum": [
       "main",
       "child",
       "other"
      ]
     },
     "parent_session_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "lineage": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "earlier session ids of the same process (/clear)"
     },
     "started_at": {
      "$ref": "common.v1.schema.json#/$defs/time"
     },
     "updated_at": {
      "$ref": "common.v1.schema.json#/$defs/time"
     },
     "version": {
      "type": [
       "string",
       "null"
      ]
     },
     "kind": {
      "type": [
       "string",
       "null"
      ]
     },
     "purpose": {
      "type": [
       "string",
       "null"
      ]
     },
     "active": {
      "type": "boolean",
      "description": "true for the fleet's active main session (the display shows only for it)"
     },
     "fleet_dir": {
      "type": [
       "string",
       "null"
      ],
      "description": "fleet root this session belongs to"
     },
     "config_dir": {
      "type": [
       "string",
       "null"
      ],
      "description": "the session's Claude configuration directory"
     },
     "launch_dir": {
      "type": [
       "string",
       "null"
      ],
      "description": "directory claude was started in (CLAUDE_PROJECT_DIR)"
     },
     "record_stale": {
      "type": "boolean",
      "description": "true when Claude Code's record was torn or unparsable and this entry is the last good value (spec §3.4)"
     },
     "messaging_socket": {
      "type": [
       "string",
       "null"
      ],
      "description": "Claude Code's messagingSocketPath (full path): a machine-pool notify `uds:<path>` belongs to this session only on an exact match"
     }
    }
   }
  }
 }
}
