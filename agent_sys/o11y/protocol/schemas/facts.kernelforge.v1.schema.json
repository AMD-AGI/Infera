{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "facts.kernelforge.v1.schema.json",
 "title": "Display facts: KernelForge tab",
 "type": "object",
 "required": [
  "v",
  "hot_ops",
  "campaigns",
  "ops"
 ],
 "properties": {
  "v": {
   "const": 1
  },
  "hot_ops": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "profile_id",
     "role",
     "ops"
    ],
    "properties": {
     "profile_id": {
      "type": "string"
     },
     "role": {
      "type": "string"
     },
     "scope": {
      "type": [
       "string",
       "null"
      ]
     },
     "ops": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "name",
        "share_pct"
       ],
       "properties": {
        "name": {
         "type": "string"
        },
        "share_pct": {
         "type": "number"
        },
        "rank": {
         "type": "integer"
        },
        "op_id": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      }
     }
    }
   }
  },
  "campaigns": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "campaign_root",
     "operator_ids",
     "status"
    ],
    "properties": {
     "campaign_root": {
      "type": "string"
     },
     "operator_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "engine": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "enum": [
       "running",
       "paused",
       "completed",
       "interrupted",
       "stale",
       "lost",
       "unknown"
      ]
     },
     "started_at": {
      "$ref": "common.v1.schema.json#/$defs/time"
     },
     "age_s": {
      "type": [
       "number",
       "null"
      ]
     },
     "active_s": {
      "type": [
       "number",
       "null"
      ]
     },
     "iterations": {
      "type": [
       "integer",
       "null"
      ]
     },
     "kept": {
      "type": [
       "integer",
       "null"
      ]
     },
     "start_speedup": {
      "type": [
       "number",
       "null"
      ]
     },
     "best_speedup": {
      "type": [
       "number",
       "null"
      ]
     },
     "gain_pct": {
      "type": [
       "number",
       "null"
      ]
     },
     "gain_pct_per_hour": {
      "type": [
       "number",
       "null"
      ]
     },
     "last_event_at": {
      "$ref": "common.v1.schema.json#/$defs/time"
     },
     "termination_reason": {
      "type": [
       "string",
       "null"
      ]
     },
     "machine": {
      "type": [
       "string",
       "null"
      ]
     },
     "problem": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "ops": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "op_id",
     "stage"
    ],
    "properties": {
     "op_id": {
      "type": "string"
     },
     "stage": {
      "type": "string"
     },
     "share_pct": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "e2e_verdict": {
      "type": [
       "string",
       "null"
      ]
     },
     "e2e_delta_pct": {
      "type": [
       "number",
       "null"
      ]
     },
     "campaign_root": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  }
 },
 "allOf": [
  {
   "$ref": "common.v1.schema.json#/$defs/facts_header"
  }
 ]
}
