+    #[test]
+    fn split_guard_transfers_accounting_without_duplicate_hooks() {
+        let counts = Arc::new(GuardCounts::default());
+        let mut joined = two_guards(counts.clone());
+        let prefill = joined.take_first().unwrap();
+        assert_eq!(*counts.starts.lock().unwrap(), vec!["p", "d"]);
+        assert!(counts.finishes.lock().unwrap().is_empty());
+        drop(prefill);
+        assert_eq!(*counts.finishes.lock().unwrap(), vec!["p"]);
+        drop(joined);
+        assert_eq!(*counts.finishes.lock().unwrap(), vec!["p", "d"]);
+    }
