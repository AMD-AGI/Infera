+    /// Transfer one existing accounting entry without starting or finishing it twice.
+    pub fn take_first(&mut self) -> Option<Self> {
+        if self.entries.is_empty() { return None; }
+        let entry = self.entries.remove(0);
+        Some(Self { policy: self.policy.clone(), entries: vec![entry] })
     }
 }
 
