+def _gluon_paged_mqa_logits(
+    q_fp8: torch.Tensor,
+    kv_cache_fp8: torch.Tensor,
+    weights: torch.Tensor,
+    context_lens: torch.Tensor,
+    block_tables: torch.Tensor,
+    max_model_len: int,
+    group_rows: int,
+) -> torch.Tensor:
+    """The gfx950 kernel scores one query per row, so every MTP verify row gets
+    its own context length and block-table row (already the case when decode
+    is flattened); a request's rows form one longest-first dispatch group."""
+    from vllm.v1.attention.ops.rocm_gluon_paged_mqa_logits import (
+        gluon_fp8_paged_mqa_logits,
+    )
+
+    logger.info_once("Using the gfx950 gluon paged-MQA logits kernel for decode.")
+    batch_size, next_n, heads, dim = q_fp8.shape
+    rows = batch_size * next_n
+    if next_n == 1:
+        row_lens = context_lens.reshape(-1)
+        row_tables = block_tables
+    else:
+        if context_lens.dim() == 2 and context_lens.shape[1] == next_n:
+            row_lens = context_lens.reshape(-1)
+        else:
+            offsets = torch.arange(
+                next_n, device=context_lens.device, dtype=context_lens.dtype
+            ) - (next_n - 1)
+            row_lens = (context_lens.reshape(-1, 1) + offsets).reshape(-1)
+        row_tables = block_tables.repeat_interleave(next_n, dim=0)
+    if row_lens.dtype != torch.int32:
+        row_lens = row_lens.to(torch.int32)
+    (out_logits,) = current_workspace_manager().get_simultaneous(
+        ((rows, max_model_len), torch.float32),
+    )
+    gluon_fp8_paged_mqa_logits(
+        q_fp8.reshape(rows, 1, heads, dim),
+        kv_cache_fp8,
+        weights,
+        out_logits,
+        row_lens,
+        row_tables,
+        max_model_len,
+        Preshuffle=True,
+        KVBlockSize=kv_cache_fp8.shape[1],
+        ChunkK=256,
+        LptGroupRows=group_rows,
+    )
+    return out_logits
+
