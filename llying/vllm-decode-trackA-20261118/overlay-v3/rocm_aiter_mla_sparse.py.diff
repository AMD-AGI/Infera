+def _gluon_group_rows(next_n: int, flat_group_rows: int) -> int:
+    """LPT dispatch group: a request's verify rows, given per request
+    (next_n > 1) or, when decode is flattened to one row per query
+    (next_n == 1), by the caller. The sibling-pair phase pairs rows inside a
+    group, so a group must be even."""
+    group = next_n if next_n > 1 else flat_group_rows
+    return group if group >= 2 and group % 2 == 0 and group <= 8 else 0
+
