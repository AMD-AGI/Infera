+def _localize_fused_shared_expert_ids(topk_ids: torch.Tensor) -> torch.Tensor:
+    """With AITER fused shared experts under EP, the shared-expert columns mark
+    which rows this rank computes the shared expert for (the others get the
+    masked sentinel id), indexed by the row after the dispatch. The all-gather
+    brings every source rank's own marking instead, so a token's shared expert
+    ran on every rank or on none. Restore this rank's marking."""
+    from vllm.model_executor.layers.fused_moe.experts import rocm_aiter_moe
+
+    meta = rocm_aiter_moe.aiter_topK_meta_data
+    cols = rocm_aiter_moe.aiter_topK_shared_cols
+    if meta is None or not rocm_aiter_moe.aiter_topK_is_ep or cols == 0 or topk_ids.dim() != 2:
+        return topk_ids
+    meta_ids = meta[1]
+    rows = topk_ids.shape[0]
+    if topk_ids.shape[1] != meta_ids.shape[1] or rows > meta_ids.shape[0]:
+        return topk_ids
+    topk_ids[:, -cols:] = meta_ids[:rows, -cols:]
+    return topk_ids
+
