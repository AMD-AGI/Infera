@@ -1,14 +1,19 @@
 #!/usr/bin/env bash
-# Correctness gate of a P4D4 deployment with real MTP acceptance (the chain_v2 checks in gate.sh: smoke, GSM8K 200,
-# 16k long context x 64, acceptance from the engine counters), run by p4d4_run.sh with P4D4_STEP=gate_p4d4.sh so the
-# deployment env is the scoring one minus the simulated acceptance.   gate_p4d4.sh RUN
+# AUS: the correctness step of a P4D4 deployment is InferenceX's own eval (kit/eval.sh: lm-eval GSM8K 1,319 at the
+# benchmark concurrency + AL gate) on a deployment with REAL MTP acceptance, instead of crusoe's gate.sh probes.
+# Run by p4d4_run.sh with P4D4_STEP=gate_p4d4.sh (pair12 S_GATE=1), so the deployment env is the scoring one minus the
+# simulated acceptance.   gate_p4d4.sh RUN
 set -uo pipefail
 R=${R:-/perf_apps/liyingli/bench_agentx/vllm-p4d4-aus-20261127/replay/R}
 run=${1:?run id}
 unset SIM_ACCEPT_LEN
 bash "$R/scripts/pd1_up.sh" "$run" || { echo "$(date -u +%m%d-%T) gate $run: deployment failed" | tee -a "$R/logs/summary.out"; exit 1; }
 IP=$(ip -o -4 route get 8.8.8.8 | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}')
-PREFILL_NUM_WORKERS=1 bash "$R/scripts/gate.sh" "$run" "$(cat "$R/runs/$run/router_url")" "http://$IP:27201 http://$IP:27301"
+o=$R/results/gate-$run
+IMAGE=${IMAGE:-infera-vllm:v0340-0fcce333} MTP_N=$(python3 -c 'import json, os; print(json.loads(os.environ["SPEC"])["num_speculative_tokens"])') \
+    bash /perf_apps/liyingli/bench_agentx/vllm-p4d4-aus-20261127/kit/eval.sh "$o" "$(cat "$R/runs/$run/router_url")" "${CONC:?}" \
+    "http://$IP:27201 http://$IP:27301" > "$o.log" 2>&1
 rc=$?
 for c in vpd-prefill vpd-decode vpd-router; do docker logs "$c" > "$R/runs/$run/$c.log" 2>&1; done
+echo "$(date -u +%m%d-%T) gate $run: ix-eval C$CONC $(cat "$o/eval-rc.txt" 2>/dev/null) $(grep -a -E 'GSM8K rc|AL gate rc' "$o.log" | tr '\n' ' ')" | tee -a "$R/logs/summary.out"
 exit $rc
