# D: C (upstream PRs) + the local-only items that cannot go upstream as vLLM changes:
#   THP off in every engine Python process (kit/local/thp_off.py via a .pth; a host-level workaround for THP-driven
#   compaction stalls, needed on these hosts like GEM), and the decode BF16 GEMM tuning table (an aiter data file).
. "$(dirname "${BASH_SOURCE[0]}")/${D_BASE:-C1}.env"
L=/perf_apps/liyingli/bench_agentx/vllm-p4d4-aus-20261127/kit/local
ENGINE_MOUNT_X="$L/thp_off.py:@SP@/thp_off.py:ro $L/vpd_thp_off.pth:@SP@/vpd_thp_off.pth:ro ${ENGINE_MOUNT_X:-}"
D_MOUNT_X="$L/glm52_decode_bf16_tuned_gemm.csv:@SP@/aiter/configs/model_configs/glm52_bf16_tuned_gemm.csv:ro ${D_MOUNT_X:-}"
