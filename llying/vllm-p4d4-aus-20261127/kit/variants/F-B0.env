# F-B0: C1 with the decode DP rank chosen by the Infera router instead of by vLLM: the decode registers one target per
# DP rank (no INFERA_VLLM_DP_ENGINE_LB), the router pins each request with X-Data-Parallel-Rank, picking by booked input
# tokens + DECODE_REQUEST_WEIGHT x held requests (--decode-input-demand on); vLLM's own balancer and its KV weight are
# not used. Everything else is C1.
. "$(dirname "${BASH_SOURCE[0]}")/C1.env"
D_ENV_X="${D_ENV_X/INFERA_VLLM_DP_ENGINE_LB=1/}"
D_ARGS_X="${D_ARGS_X/--data-parallel-lb-kv-weight 14/}"
ROUTER_ARGS="--router-policy kv-aware --kv-prefill-overlap-weight 20 --kv-decode-overlap-weight 2 --session-affinity prefill --pd-prefill-guard-release completion --decode-input-demand on --decode-request-weight ${DECODE_REQUEST_WEIGHT:-0}"
