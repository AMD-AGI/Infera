# F-B0: C0 engine, decode DP rank chosen by the Infera router (one target per vLLM DP rank, X-Data-Parallel-Rank header),
# by booked input tokens + DECODE_REQUEST_WEIGHT x held requests; vLLM's own balancer is not used (no #250, no fork #7 W).
IMAGE=${IMAGE:-infera-vllm:nightly-de7cf7f8-C0}
D_ENV_X="${D_ENV_X:-}"
ROUTER_ARGS="--router-policy kv-aware --kv-prefill-overlap-weight 20 --kv-decode-overlap-weight 2 --session-affinity prefill --pd-prefill-guard-release completion --decode-input-demand on --decode-request-weight ${DECODE_REQUEST_WEIGHT:-0}"
