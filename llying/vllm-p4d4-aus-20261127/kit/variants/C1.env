# C1: C0 + the three new fork PRs (llying-001/vllm#15 FP4 dispatch, #16 one all-gather per MoE layer, #17 Triton exact
# decode top-k for the DSA indexer), switched on at the decode.
IMAGE=${IMAGE:-infera-vllm:nightly-de7cf7f8-C1}
D_ENV_X="INFERA_VLLM_DP_ENGINE_LB=1 VLLM_ROCM_USE_AITER_MOE_FP4_DISPATCH=1 VLLM_ROCM_USE_AITER_MOE_FP4_DISPATCH_PACK=1 VLLM_ROCM_USE_TRITON_INDEXER_DECODE_TOPK=1 ${D_ENV_X:-}"
D_ARGS_X="--data-parallel-lb-kv-weight 14 ${D_ARGS_X:-}"
