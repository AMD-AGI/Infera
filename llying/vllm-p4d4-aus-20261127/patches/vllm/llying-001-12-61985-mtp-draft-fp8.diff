+def _is_mtp_draft_layer(vllm_config, prefix: str) -> bool:
+    """Whether ``prefix`` is an MTP draft layer: the model being built is an MTP
+    model, or the layer index is past the target's decoder layers."""
+    model_config = vllm_config.model_config
+    if any("MTP" in arch for arch in model_config.architectures or ()):
+        return True
+    num_layers = getattr(model_config.hf_text_config, "num_hidden_layers", None)
+    m = re.search(r"layers\.(\d+)\.", prefix)
+    return num_layers is not None and m is not None and int(m.group(1)) >= num_layers
