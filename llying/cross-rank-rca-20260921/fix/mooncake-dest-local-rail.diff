+++ b/mooncake-transfer-engine/src/transport/rdma_transport/rdma_transport.cpp
@@ -54,6 +54,24 @@ static std::string resolveBufferLocation(
     return location;
 }
 
+// MC_ENABLE_DEST_LOCAL_RAIL: post a WRITE on the HCA the peer prefers for the
+// destination buffer; dest device affinity keeps the peer on that same rail.
+// A cross-NUMA transfer then crosses the socket on the sender's DMA reads, not
+// on the receiver's DMA writes, which a receiving NIC drops under load.
+static std::string destinationLocalHca(
+    TransferMetadata::SegmentDesc *peer_desc,
+    const Transport::TransferRequest &request) {
+    if (!globalConfig().enable_dest_local_rail ||
+        request.opcode != Transport::TransferRequest::WRITE)
+        return {};
+    int buffer_id = -1, device_id = -1;
+    if (RdmaTransport::selectDevice(peer_desc, request.target_offset,
+                                    request.length, buffer_id, device_id) ||
+        static_cast<size_t>(device_id) >= peer_desc->devices.size())
+        return {};
+    return peer_desc->devices[device_id].name;
+}
+
 // Calculate remaining bytes in buffer for 'address'.
 // Caches 'last_buffer_idx' across sequential slices to avoid rescanning
 // buffers.
@@ -883,8 +901,9 @@ Status RdmaTransport::submitTransferTask(
 
         auto request_buffer_id = -1, request_device_id = -1;
         if (selectDevice(local_segment_desc.get(), (uint64_t)request.source,
-                         request.length, request_buffer_id,
-                         request_device_id)) {
+                         request.length,
+                         destinationLocalHca(target_segment_desc.get(), request),
+                         request_buffer_id, request_device_id)) {
             request_buffer_id = -1;
             request_device_id = -1;
         }
