+    const char* ib_timeout_env = std::getenv("MC_IB_TIMEOUT");
+    if (ib_timeout_env) {
+        try {
+            int val = std::stoi(ib_timeout_env);
+            if (val >= 1 && val <= 31) {
+                config.ib_timeout = val;
+            } else {
+                LOG(WARNING)
+                    << "Ignore value from environment variable MC_IB_TIMEOUT, "
+                    << "value " << ib_timeout_env
+                    << " out of range (should be 1-31)";
+            }
+        } catch (const std::exception& e) {
+            LOG(WARNING) << "Invalid MC_IB_TIMEOUT environment value: "
+                         << ib_timeout_env << ". Error: " << e.what();
+        }
+    }
