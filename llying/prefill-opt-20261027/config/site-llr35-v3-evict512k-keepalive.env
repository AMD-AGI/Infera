# E1 + E7c: received PP tensors kept alive for 2 * (pp_loop_size + 2) receives instead of record_stream (kit
# patches/pp-recv-keepalive, config/pp-recv-keepalive.patch). E7's record_stream fixed the bad starts but its E7 trace shows
# 200 ms hipMemcpy waits in kv_to_page_indices on the scheduler thread (allocator syncing record_stream events under memory
# pressure, suspected); keep-alive gives the same lifetime guarantee with no events.
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-evict512k.env
export PREFILL_MOUNT_EXTRA="$PREFILL_MOUNT_EXTRA /home/liyingli/bench_agentx/baseline/2p1d-kit/llr35/patches/pp-recv-keepalive/scheduler_pp_mixin.py:/sgl-workspace/sglang/python/sglang/srt/managers/scheduler_pp_mixin.py:ro"
