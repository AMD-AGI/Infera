# Correctness gate for E1 (eviction headroom): the prefill device KV pool capped at 300K tokens per PP rank so that two
# identical 16k x 128 long-context passes keep evicting with write_back backups and the second pass loads them back.
# Headroom 64K on the 300K pool: above every single allocation (8K chunk), so each eviction is padded as in production
# (512K on the 10.7M-token pool), but below the pool so the padded target stays reachable.
EVICT_HEADROOM=${EVICT_HEADROOM:-65536}
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-evict512k.env
export PREFILL_EXTRA_ARGS="$PREFILL_EXTRA_ARGS --max-total-tokens 300000"
