# E1 + E7b + E3: batched write-back eviction (kit patches/evict-batch/unified_radix_cache.py = E1's file +
# config/evict-batch-on-e1.patch; SGLANG_EVICT_BATCH_NODES=0 restores one fence + wait per victim). 10-28 E1 trace: one
# host load-back that needs room triggers two 512K evictions of ~560 ms each on PP0, and every PP rank repeats them one beat
# apart (mirrored tree), so the ring stalls ~4 beats of ~1.1 s -- the long-beat tail. Each eviction queued ~116 victims
# one at a time; batching 32 per fence lets start_writing merge them into one transfer and the walk overlap the copy.
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-evict512k-recvrecord.env
export PREFILL_MOUNT_EXTRA="${PREFILL_MOUNT_EXTRA/evict-headroom\/unified_radix_cache.py/evict-batch/unified_radix_cache.py}"
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA SGLANG_EVICT_BATCH_NODES=${EVICT_BATCH_NODES:-32}"
