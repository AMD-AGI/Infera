+    def _pre_write_back(self, budget: int) -> None:
+        """E9: back up the unbacked device-LRU tail (up to ``budget`` tokens counted from the tail, backed-up nodes
+        included) through the write-through path: locked during the copy, acked by the non-blocking writing_check."""
+        if budget <= 0 or self.cache_controller is None or not self.is_write_back:
+            return
+        tc = self.tree_core
+        ct = BASE_COMPONENT_TYPE
+        lru = tc.lru_lists[ct]
+        pt = lru._pt
+        picked: list[NodeId] = []
+        covered = 0
+        x = lru.tail.lru_prev[pt]
+        while x is not None and x is not lru.head and covered < budget:
+            cd = x.component_data[ct]
+            if (
+                x is not tc.root_node
+                and cd.value is not None
+                and all(c.lock_ref == 0 for c in x.component_data)
+                and x.load_back_pending_id is None
+            ):
+                covered += len(cd.value)
+                if (
+                    cd.host_value is None
+                    and x.write_through_pending_id is None
+                    and len(cd.value) > 0
+                ):
+                    picked.append(x.id)
+            x = x.lru_prev[pt]
+        if not picked:
+            return
+        prewb = tc.prewb_nodes
+        tc.prewb_spare_only = True
+        written_nodes = 0
+        try:
+            for nid in picked:
+                if self._execute_and_commit_kv_backup(BackupKV(node_ids=[nid])) <= 0:
+                    break
+                prewb.add(nid)
+                written_nodes += 1
+                self._prewb_digest = (
+                    getattr(self, "_prewb_digest", 0) * 1000003 + nid + 1
+                ) & _PREWB_DIGEST_MASK
+        finally:
+            tc.prewb_spare_only = False
+        if written_nodes == 0:
+            return
+        mods = _prewb_quota_modules() if _PREWB_BLOCK_QUOTA > 0 else ()
+        saved = [m._BACKUP_BLOCK_QUOTA for m in mods]
+        for m in mods:
+            m._BACKUP_BLOCK_QUOTA = _PREWB_BLOCK_QUOTA
+        try:
+            self.cache_controller.start_writing(wait_for_forward=True)
+        finally:
+            for m, q in zip(mods, saved):
+                m._BACKUP_BLOCK_QUOTA = q
+        self._prewb_nodes_total = getattr(self, "_prewb_nodes_total", 0) + written_nodes
+        if len(prewb) > 4096:
+            # Lazy deregistration: keep only nodes still on device.
+            arena = tc._node_arena
+            tc.prewb_nodes = {
+                n
+                for n in prewb
+                if (node := arena.get(n)) is not None
+                and node.component_data[ct].value is not None
+            }
