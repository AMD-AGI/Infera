# Correctness gate for the no-write-fence patch: the prefill device KV pool capped at 300K tokens per PP rank so that
# a 16k x 128 long-context pass (~2M prompt tokens) keeps evicting with write_back backups while forwards run, and a
# second identical pass loads those prefixes back from host (a backup that raced a forward would come back corrupt).
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-nofence.env
export PREFILL_EXTRA_ARGS="$PREFILL_EXTRA_ARGS --max-total-tokens 300000"
