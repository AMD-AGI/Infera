# llr35 + patch v3 + eviction headroom: a write_back eviction frees at least 512K tokens per call (prefill only).
# 10-27 trace: 35% of each prefill scheduler's time is hipEventSynchronize in writing_check, 79% of it waiting for the
# running forward to end (the write fence), so the scheduler cannot run ahead and the GPU idles ~46% between steps.
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3.env
K=/home/liyingli/bench_agentx/baseline/2p1d-kit/llr35/patches/evict-headroom
export PREFILL_MOUNT_EXTRA="$PREFILL_MOUNT_EXTRA $K/unified_radix_cache.py:/sgl-workspace/sglang/python/sglang/srt/mem_cache/unified_radix_cache.py:ro"
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA SGLANG_EVICT_HEADROOM_TOKENS=${EVICT_HEADROOM:-524288}"
unset K
