# Diagnostic only (correctness, never performance): E1 with the PD KV checksum on both roles. Prefill hashes each request's
# KV pages (Adler-32) when it sends the last chunk; decode re-hashes after the transfer and aborts the request on a mismatch
# ("KV checksum mismatch" in the decode log). Tells whether the stack's ~0.4 % "bad start" outputs come from KV that differs
# from what prefill sent (e.g. decode starting before every PP rank's pages landed).
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-evict512k.env
export PREFILL_EXTRA_ARGS="$PREFILL_EXTRA_ARGS --disaggregation-enable-kv-checksum"
export DECODE_EXTRA_ARGS="$DECODE_EXTRA_ARGS --disaggregation-enable-kv-checksum"
