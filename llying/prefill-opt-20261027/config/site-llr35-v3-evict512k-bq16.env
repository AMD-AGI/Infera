# E1 + E10: the write_back eviction's D->H copy (transfer_kv_all_layer_mla_lf_pf, KV in pool_host/mla.py and the DSA
# indexer in pool_host/dsa.py) launches block_quota workgroups instead of the kernel default 2, which caps it at ~22 GB/s
# on MI355X; 16 reaches ~49 GB/s on 138 GPUs 4-7 (scripts/bench_hicache_backup.py), byte-exact for every setting.
# Unset or 2 = the image's behaviour (config/hicache-backup-quota.patch).
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-evict512k.env
K=/home/liyingli/bench_agentx/baseline/2p1d-kit/llr35/patches/hicache-backup-quota
PH=/sgl-workspace/sglang/python/sglang/srt/mem_cache/pool_host
export PREFILL_MOUNT_EXTRA="$PREFILL_MOUNT_EXTRA $K/mla.py:$PH/mla.py:ro $K/dsa.py:$PH/dsa.py:ro"
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA SGLANG_HICACHE_BACKUP_BLOCK_QUOTA=${BACKUP_BLOCK_QUOTA:-16}"
unset K PH
