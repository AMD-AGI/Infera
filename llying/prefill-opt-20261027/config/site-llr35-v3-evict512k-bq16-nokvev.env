# E11 = E1 + E10 + KV events off on the prefill (same flags the decode already uses).
# The prefill is the only prefill worker, so the kv-aware router has a single candidate either way;
# SGLang only records events on PP0, so PP1-PP3 already run the events-disabled code path.
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-evict512k-bq16.env
export PREFILL_EXTRA_ARGS="$PREFILL_EXTRA_ARGS --no-enable-kv-events --kv-events off"
