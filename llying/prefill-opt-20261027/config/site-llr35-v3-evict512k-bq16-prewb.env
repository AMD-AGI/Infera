# E9 = E1 + E10 + background pre-write-back of the device-LRU tail (kit patches/pre-write-back: E1's
# unified_radix_cache.py + _pre_write_back, unified_tree_core.py with the reclaim pass-1 sparing). Replaces E1's mount
# of unified_radix_cache.py (same container path) and adds the tree core. See README 10-29 15:20.
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-evict512k-bq16.env
K=/home/liyingli/bench_agentx/baseline/2p1d-kit/llr35/patches
MC=/sgl-workspace/sglang/python/sglang/srt/mem_cache
export PREFILL_MOUNT_EXTRA="${PREFILL_MOUNT_EXTRA//$K\/evict-headroom\/unified_radix_cache.py/$K/pre-write-back/unified_radix_cache.py} $K/pre-write-back/unified_tree_core.py:$MC/unified_cache/unified_tree_core.py:ro"
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA SGLANG_HICACHE_PREWB_TOKENS=${PREWB_TOKENS:-1048576} SGLANG_HICACHE_PREWB_TRIGGER=${PREWB_TRIGGER:-2000000} SGLANG_HICACHE_PREWB_BLOCK_QUOTA=${PREWB_BLOCK_QUOTA:-2}"
unset K MC
