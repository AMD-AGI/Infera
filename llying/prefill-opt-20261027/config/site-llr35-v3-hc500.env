# llr35 + patch v3 with the prefill HiCache host tier at 500 GB per PP rank (kit: 250; 4 ranks = 2 TB of 138's 2.75 TB).
# The extra args come last on the command line, so this --hicache-size wins over the kit's.
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3.env
export PREFILL_EXTRA_ARGS="$PREFILL_EXTRA_ARGS --hicache-size 500"
