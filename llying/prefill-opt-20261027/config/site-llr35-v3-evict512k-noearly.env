# E1 + E4: no early send of the device-resident cached prefix (SGLANG_DISAGG_PREFILL_EARLY_SEND_CACHED_PREFIX=0, an
# upstream default-on optimisation; the final send then covers the whole range). 10-28 four-rank trace: the early send
# runs in run_batch before the forward launch and its kv_to_page_indices .cpu() on schedule_stream waits for the previous
# forward (89-140 ms per call, 49-70 calls per 120 steps per rank), so the next forward cannot be queued behind it.
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-evict512k.env
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA SGLANG_DISAGG_PREFILL_EARLY_SEND_CACHED_PREFIX=0"
