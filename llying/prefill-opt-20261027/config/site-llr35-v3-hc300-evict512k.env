# llr35 + patch v3 + E1 (eviction headroom 512K) + host tier 300 GB per PP rank: the largest pool inside the InferenceX
# mi355x-amds DRAM budget (dram-utilization 1.0 = 1499 GB per 4-GPU server, InferenceX #4045 / #4308). --hicache-size
# counts KV only; the DSA indexer host pool adds ~23%, so 4 x 300 GB x 1.23 = ~1476 GB.
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-evict512k.env
export PREFILL_EXTRA_ARGS="$PREFILL_EXTRA_ARGS --hicache-size 300"
