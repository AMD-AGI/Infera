# E1 + E7d + E8: idle-time device eviction on the PP prefill (kit patches/pp-idle-evict = E7d's scheduler_pp_mixin.py +
# config/pp-idle-evict-on-e7d.patch): when a loop pass has no microbatch and fewer than LOW token slots are free, evict
# up to HIGH free. 10-28 E1 trace: a load-back that needs room evicts on PP0 (~1.2 s), and each PP rank repeats it one beat
# apart (mirrored tree), stalling the ring ~4 beats; prefill has no queue 18-37 % of the time, so evict then instead.
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-evict512k-recvstream-ka.env
export PREFILL_MOUNT_EXTRA="${PREFILL_MOUNT_EXTRA/pp-recv-stream-keepalive\/scheduler_pp_mixin.py/pp-idle-evict/scheduler_pp_mixin.py}"
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA SGLANG_PP_IDLE_EVICT_LOW=${IDLE_EVICT_LOW:-786432} SGLANG_PP_IDLE_EVICT_HIGH=${IDLE_EVICT_HIGH:-1048576}"
