# E1 + E7d + HWQ8: prefill GPU_MAX_HW_QUEUES 4 (HIP default) -> 8. E7 / E7d (receives on their own stream) run 6-13 % slower and
# E7's trace shows ~200 ms scheduler-stream hipMemcpy waits; suspected: the extra stream shares a hardware queue with the
# scheduler stream, so its early, spinning NCCL recv kernel blocks the scheduler's small copies.
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-evict512k-recvstream-ka.env
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA GPU_MAX_HW_QUEUES=${HWQ:-8}"
