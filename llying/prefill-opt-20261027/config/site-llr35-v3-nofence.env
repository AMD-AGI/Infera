# llr35 + patch v3 + no HiCache write fence (prefill only): a write_back eviction's D->H backup no longer waits for
# the running forward (cache_controller.start_writing), so the scheduler is not blocked until that forward ends.
# GLM-5.2 has no SWA; the fence's stated purpose is evicted SWA pages of unfinished checkpoints.
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3.env
K=/home/liyingli/bench_agentx/baseline/2p1d-kit/llr35/patches/no-write-fence
export PREFILL_MOUNT_EXTRA="$PREFILL_MOUNT_EXTRA $K/cache_controller.py:/sgl-workspace/sglang/python/sglang/srt/managers/cache_controller.py:ro"
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA SGLANG_HICACHE_NO_WRITE_FENCE=1"
unset K
