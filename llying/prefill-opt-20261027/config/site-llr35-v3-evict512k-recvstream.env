# E1 + E7: PP receives on their own CUDA stream (kit patches/pp-recv-stream, scheduler_pp_mixin.py; SGLANG_PP_RECV_STREAM=0
# turns it off). 10-28 four-rank trace: on the shared PP comm stream an irecv is ordered behind the rank's earlier send
# commits and forward fences, so the proxy send kernel PP0->PP1 runs 73 ms median (p90 328) instead of ~4 ms, and PP0's
# output recv from PP3 (d2h sync before every launch) waits for the whole downstream chain (ring closure 617 ms median).
. /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-opt-20261027/config/site-llr35-v3-evict512k.env
export PREFILL_MOUNT_EXTRA="$PREFILL_MOUNT_EXTRA /home/liyingli/bench_agentx/baseline/2p1d-kit/llr35/patches/pp-recv-stream/scheduler_pp_mixin.py:/sgl-workspace/sglang/python/sglang/srt/managers/scheduler_pp_mixin.py:ro"
