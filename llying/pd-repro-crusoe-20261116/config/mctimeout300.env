# crusoe v3 cross-node: under C208 load a KV transfer occasionally stalls past Mooncake's 30 s sync-batch timeout
# (11-16 07:57 / 08:13, the receiving ionic QP stalls; see llying/cross-rank-rca-20260921). Wait up to 300 s instead of
# failing the request (MC_TRANSFER_TIMEOUT, mooncake-integration/transfer_engine/transfer_engine_py.cpp).
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA MC_TRANSFER_TIMEOUT=300" DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA MC_TRANSFER_TIMEOUT=300"
