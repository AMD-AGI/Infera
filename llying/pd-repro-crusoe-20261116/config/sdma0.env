# crusoe v3 nodes (amdgpu 6.16.13, kernel 6.8.12-*.crusoe): SGLang weight load hangs in SDMA copies
# (yihou/glm52.dcp4-pd.packup_20261022/notes.md section 1); blit-kernel copies on both legs.
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA HSA_ENABLE_SDMA=0" DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA HSA_ENABLE_SDMA=0"
