-# Host libionic, so the entrypoint can match the host ionic kernel ABI.
-[[ ! -e /lib/x86_64-linux-gnu/libionic.so ]] ||
+# Host libionic, so the entrypoint can match the host ionic kernel ABI. KIT_NO_HOST_LIBIONIC=1 keeps the image's own
+# provider: on hosts newer than the image (crusoe v3: Ubuntu 24.04 libionic needs GLIBC_2.38, the image has 2.35) the
+# swapped-in provider fails to load, ibv_get_device_list() returns no ionic device and Mooncake silently uses TCP.
+[[ "${KIT_NO_HOST_LIBIONIC:-0}" == 1 || ! -e /lib/x86_64-linux-gnu/libionic.so ]] ||
     mounts+=(-v /lib/x86_64-linux-gnu/libionic.so:/host-libionic/libionic.so:ro)
 
