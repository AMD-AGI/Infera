# DRIVER619-20261113 formal delivery: GEM-backed KV pools through Mooncake's native support (mooncake.allocator.
# HipGemAllocator, kvcache-ai/Mooncake PR) and SGLang's AMD_GEM pool type (sgl-project/sglang PR), instead of the preloaded
# shim of gemkv.env. Image: the production image with Mooncake faae8dd4 + the PR backported (kfd619/mc). Everything else
# keeps the arm's values, including MOONCAKE_DISABLE_HIP_DMABUF=1 (Mooncake registers GEM buffers through dma-buf
# regardless) and Mooncake's HIP transport (it leaves GEM buffers to RDMA).
G=/perf_apps/liyingli/bench_agentx/kfd619/sglang-native
S=/sgl-workspace/sglang/python/sglang/srt/disaggregation/mooncake
export IMAGE=infera-sglang:v0522-fdbafb60-hipgem
_gem_mnt="$G/utils.py:$S/utils.py:ro $G/conn.py:$S/conn.py:ro"
export PREFILL_ENV_EXTRA="${PREFILL_ENV_EXTRA:-} SGLANG_MOONCAKE_CUSTOM_MEM_POOL=AMD_GEM"
export DECODE_ENV_EXTRA="${DECODE_ENV_EXTRA:-} SGLANG_MOONCAKE_CUSTOM_MEM_POOL=AMD_GEM"
export PREFILL_MOUNT_EXTRA="${PREFILL_MOUNT_EXTRA:-} $_gem_mnt" DECODE_MOUNT_EXTRA="${DECODE_MOUNT_EXTRA:-} $_gem_mnt"
