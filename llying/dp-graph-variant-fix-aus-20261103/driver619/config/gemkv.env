# DRIVER619-20261113: on top of an arm, both roles keep their KV pools in amdgpu GEM BOs (kfd619/gemalloc), so the
# RDMA-pinned KV is charged once by the KFD allocation limit of amdgpu-dkms 6.18.4 .. 7.1.9 (6.19.14 pilot nodes).
# Mooncake registers them through dma-buf; the allocator (preloaded) answers its HIP / HSA queries for those buffers,
# refuses peer-memory ibv_reg_mr there, and aborts unless MOONCAKE_DISABLE_HIP_DMABUF=0, MC_HIP_KFD_PIN_FIX=0 and
# MC_DISABLE_HIP=1. The patched mooncake/utils.py adds SGLANG_MOONCAKE_CUSTOM_MEM_POOL=AMD_GEM.
G=/perf_apps/liyingli/bench_agentx/kfd619
export MOONCAKE_DISABLE_HIP_DMABUF=0
_gem_env="MC_HIP_KFD_PIN_FIX=0 MC_DISABLE_HIP=1 SGLANG_MOONCAKE_CUSTOM_MEM_POOL=AMD_GEM SGLANG_AMD_GEM_ALLOCATOR=$G/gemalloc/build/libhip_gem_alloc.so LD_PRELOAD=$G/gemalloc/build/libhip_gem_alloc.so"
_gem_mnt="$G/sglang/mooncake_utils.py:/sgl-workspace/sglang/python/sglang/srt/disaggregation/mooncake/utils.py:ro $G/gemalloc/build:$G/gemalloc/build:ro"
export PREFILL_ENV_EXTRA="${PREFILL_ENV_EXTRA:-} $_gem_env" DECODE_ENV_EXTRA="${DECODE_ENV_EXTRA:-} $_gem_env"
export PREFILL_MOUNT_EXTRA="${PREFILL_MOUNT_EXTRA:-} $_gem_mnt" DECODE_MOUNT_EXTRA="${DECODE_MOUNT_EXTRA:-} $_gem_mnt"
