# C production (E11 + the fix) + decode DP balance by held requests: infera-router rebuilt from fdbafb60 + 565461b3
# (--decode-request-weight, ../../router-decode-request-weight.diff), weight 1,000,000 tokens per held request
# (../../../Infera/llying/1p1d-decode-balance-aus-20261021: 1P1D C88 +2.7 % tok/s, interactivity p90 +43 %).
. "$PKG/config/arm-C-prod.env"
export ROUTER_MOUNT_EXTRA="$PKG/../router-src/rust/target/release/infera-router:/usr/local/bin/infera-router:ro"
export ROUTER_ENV_EXTRA="INFERA_DECODE_REQUEST_WEIGHT=${DPBAL_WEIGHT:-1000000}"
