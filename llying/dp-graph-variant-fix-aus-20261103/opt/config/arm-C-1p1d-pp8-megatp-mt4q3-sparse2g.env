# arm-C-1p1d-pp8-megatp-mt4q3 with the KF sparse MLA decode kernel reading the > 2 GiB per-layer KV pool (TP8: 4.09M
# slots, 2.36 GB) as two 32-bit-addressable halves (kit/overlay-variants/kf_sparse_mla_split2g.py, generated by
# kopt-20261109/bench/make_kf_sparse_split2g.py from overlay-kopt's copy; KERNEL-PROGRESS-20261109 section 15).
# Microbench 11-11: bit-identical output, 60-96 rows 3-7% faster (88 rows 61 -> 57 us); pools <= 2 GiB unchanged.
# Compare with arm-C-1p1d-pp8-megatp-mt4q3-kvcap (pool capped below 2 GiB instead) on the same node pair.
. "$PKG/config/arm-C-1p1d-pp8-megatp-mt4q3.env"
export DECODE_MOUNT_EXTRA="$DECODE_MOUNT_EXTRA $PKG/kit/overlay-variants/kf_sparse_mla_split2g.py:/yihou_overlay/yihou_kf/kf_sparse_mla.py:ro"
