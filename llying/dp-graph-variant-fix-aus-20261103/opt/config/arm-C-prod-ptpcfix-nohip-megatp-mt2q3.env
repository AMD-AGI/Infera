# arm-C-prod-ptpcfix-nohip-megatp-mt2q2 with lb_q 3 (aiter tapers the 12 GEMM2 column chunks to [3, 3, 3, 2, 1]).
# bench/megatp_cgw.py on real weights 11-11 16:15 / 16:57 (TP4, mt 2, npp 2, lb_min 64; q 3 measured 5 times),
# 128 / 192 / 256 / 384 global tokens 184.8-186.2 / 213.4-215.1 / 216.2-217.8 / 232.1-233.7 us vs q 2
# 188.2-188.6 / 218.4-219.1 / 219.3-220.2 / 239.2-240.0 us, same SNR (29.6-30.0 dB).
. "$PKG/config/arm-C-prod-ptpcfix-nohip-megatp.env"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA AITER_MEGAMOE_TP_LB_MT=2 AITER_MEGAMOE_TP_LB_MT_SMALL=2 AITER_MEGAMOE_TP_LB_NPP=2 AITER_MEGAMOE_TP_LB_Q=3 AITER_MEGAMOE_TP_LB_MIN=64"
