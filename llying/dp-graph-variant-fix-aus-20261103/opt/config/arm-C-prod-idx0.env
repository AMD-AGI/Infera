# Acceptance bisection: C production with index_share_for_mtp_iteration at the kit default (false) on both legs.
. "$PKG/config/arm-C-prod.env"
export PREFILL_EXTRA_ARGS="${PREFILL_EXTRA_ARGS/\"index_share_for_mtp_iteration\":true/\"index_share_for_mtp_iteration\":false}"
export DECODE_EXTRA_ARGS="${DECODE_EXTRA_ARGS/\"index_share_for_mtp_iteration\":true/\"index_share_for_mtp_iteration\":false}"
