# C production with the FP8 draft MoE actually running as FP8: SGLang #45800 (merged 10-29, after v0.5.22) backported to the
# image's models/glm4_moe.py (../../ptpc-fix/, mounted on the decode). Without it Quark's leaf excludes keep the fused
# draft experts unquantized while the loader casts their weights to FP8 (real acceptance ~1.2, RESULT 4.3).
. "$PKG/config/arm-C-prod.env"
export DECODE_MOUNT_EXTRA="$DECODE_MOUNT_EXTRA $PKG/../ptpc-fix/glm4_moe.py:/sgl-workspace/sglang/python/sglang/srt/models/glm4_moe.py:ro"
