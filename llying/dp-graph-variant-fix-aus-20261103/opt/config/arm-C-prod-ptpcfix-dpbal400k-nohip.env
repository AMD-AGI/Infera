# DP balance 400k (arm-C-prod-ptpcfix-dpbal400k: router decode request weight) on one-node 4+4 with the HIP transport off
# (MC_DISABLE_HIP=1, see arm-C-prod-ptpcfix-nohip.env); its reference is one-node no-HIP C104 53,209.
. "$PKG/config/arm-C-prod-ptpcfix-dpbal400k.env"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA MC_DISABLE_HIP=1" PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA MC_DISABLE_HIP=1"
