# arm-C-1p1d-pp8-megatp-mt4q3-gemmtab with the DSA indexer's wk and weights_proj computed in the attention's fused_qkv_a
# GEMM in decode / verify graphs of 49+ rows per rank (kit/overlay-gemmmerge/kopt_gemm_merge, KOPT_GEMM_MERGE=1; q_b_proj
# + wq_b stays separate unless KOPT_GEMM_MERGE_QB=1), with table rows for the merged shapes
# (kit/aiter_csv/kopt_glm52_decode_merged_bf16_tuned_gemm.csv; without them the merged 2784-column GEMM is slower).
# Microbench 11-12 (tuned tables): rows 48-104, 21.8-27.6 us separate -> 11.8-16.4 us merged per indexer layer
# (21 layers, about 0.2-0.25 ms per step). The decode log has "[kopt-gemm-merge]" lines.
. "$PKG/config/arm-C-1p1d-pp8-megatp-mt4q3-gemmtab.env"
export DECODE_MOUNT_EXTRA="$DECODE_MOUNT_EXTRA $PKG/kit/aiter_csv/kopt_glm52_decode_merged_bf16_tuned_gemm.csv:/sgl-workspace/aiter/aiter/configs/model_configs/kopt_glm52_decode_merged_bf16_tuned_gemm.csv:ro $PKG/kit/overlay-gemmmerge/sitecustomize.py:/yihou_overlay/sitecustomize.py:ro $PKG/kit/overlay-gemmmerge:/kopt_overlay_extra:ro"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA KOPT_GEMM_MERGE=1"
