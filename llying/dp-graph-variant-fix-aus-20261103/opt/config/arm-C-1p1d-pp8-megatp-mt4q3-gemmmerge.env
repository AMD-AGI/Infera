# arm-C-1p1d-pp8-megatp-mt4q3 with the DSA indexer's wk and weights_proj computed in the attention's fused_qkv_a GEMM
# in decode / verify graphs of 49+ rows per rank (kit/overlay-gemmmerge/kopt_gemm_merge, KOPT_GEMM_MERGE=1; q_b_proj +
# wq_b stays separate unless KOPT_GEMM_MERGE_QB=1). Microbench 11-12 (tuned tables): rows 64 / 88 / 96 20.4 / 24.0 /
# 26.1 -> 12.8 / 15.6 / 15.5 us per indexer layer (21 layers). The decode log has "[kopt-gemm-merge]" lines.
. "$PKG/config/arm-C-1p1d-pp8-megatp-mt4q3.env"
export DECODE_MOUNT_EXTRA="$DECODE_MOUNT_EXTRA $PKG/kit/overlay-gemmmerge/sitecustomize.py:/yihou_overlay/sitecustomize.py:ro $PKG/kit/overlay-gemmmerge:/kopt_overlay_extra:ro"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA KOPT_GEMM_MERGE=1"
