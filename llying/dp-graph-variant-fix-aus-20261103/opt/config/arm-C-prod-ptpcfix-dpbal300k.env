# Best correct 4+4 config + decode DP balance at a milder weight (300,000 tokens per held request; 1,000,000 gave
# interactivity p90 +7.7 % at the same throughput but TTFT mean +22 %): less TTFT cost, or more throughput?
. "$PKG/config/arm-C-prod-ptpcfix.env"
export ROUTER_MOUNT_EXTRA="$PKG/../router-src/rust/target/release/infera-router:/usr/local/bin/infera-router:ro"
export ROUTER_ENV_EXTRA="INFERA_DECODE_REQUEST_WEIGHT=${DPBAL_WEIGHT:-300000}"
