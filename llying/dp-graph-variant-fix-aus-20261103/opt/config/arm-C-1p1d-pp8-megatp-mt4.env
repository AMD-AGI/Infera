# arm-C-1p1d-pp8-megatp with MegaMoeTP's large-batch row tile 64 (lb_mt 4, also <= 512 tokens) and 2 GEMM1 column blocks
# per A pass (lb_npp 2): bench/megatp_sweep.py on real weights 11-10 19:10, 384 / 640 / 768 global tokens
# 171.3 / 190.6 / 196.8 us vs the default (mt 3, npp 1) 173.0 / 203.7 / 220.2 us, same SNR.
. "$PKG/config/arm-C-1p1d-pp8-megatp.env"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA AITER_MEGAMOE_TP_LB_MT=4 AITER_MEGAMOE_TP_LB_MT_SMALL=4 AITER_MEGAMOE_TP_LB_NPP=2"
