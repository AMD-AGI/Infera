# arm-C-prod-ptpcfix-nohip-megatp (TP4 decode, 4+4 on one node) with MegaMoeTP's large-batch knobs tuned at TP4:
# bench/megatp_sweep.py --nproc 4 on real weights 11-10 19:47 (n01-21), 256 / 320 / 384 global tokens: mt 2 / npp 2 / q 2
# 219.0 / 230.5 / 240.2 us vs the default (mt 3, npp 1, q 1) 238.3 / 246.7 / 254.4 us, same SNR (29.8 dB). lb_min 64: below the
# default 256 global tokens MegaMoeTP ran its dynamic schedule (192 tokens 272.7 us, in-graph bs 12 +24 us vs production);
# the large-batch tile there: 128 / 192 tokens 252.4 -> 188.6, 272.7 -> 219.0 us (61e, 11-11 00:50).
. "$PKG/config/arm-C-prod-ptpcfix-nohip-megatp.env"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA AITER_MEGAMOE_TP_LB_MT=2 AITER_MEGAMOE_TP_LB_MT_SMALL=2 AITER_MEGAMOE_TP_LB_NPP=2 AITER_MEGAMOE_TP_LB_Q=2 AITER_MEGAMOE_TP_LB_MIN=64"
