# arm-C-1p1d-pp8-kopt without #3 (no --max-total-tokens cap): #1 (MoE token=1024 row -> block_m 32 atomic) and #2 (MLA
# absorb BMM configs) only. kopt (all three) scored 53,341 vs 56,593 with decode prealloc-wait 4.0 -> 11.9: tests
# whether the 10 % smaller decode KV pool caused the drop. Same kernels as production otherwise (sparse MLA keeps the
# 64-bit page offsets above 2 GiB).
. "$PKG/config/arm-C-1p1d-pp8-kopt.env"
export DECODE_EXTRA_ARGS="${DECODE_EXTRA_ARGS/ --max-total-tokens 3680000/}"
