# 2P1D (TP8 / DP8 decode) for a decode trace under AgentX C208: kernels inside the replayed graphs visible
# (DEBUG_CLR_GRAPH_PACKET_CAPTURE=0). Kernel breakdown at TP8 shapes (KF kernels were tuned on TP4).
. "$PKG/config/arm-C-2p1d.env"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA DEBUG_CLR_GRAPH_PACKET_CAPTURE=0"
