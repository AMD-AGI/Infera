# REPORT-20261110 section 6: one-node production C arm with a Mooncake knob against the amdgpu 6.19 start-up segfault: MC_ENABLE_PARALLEL_REG_MR=0 MC_MAX_CONCURRENT_REG_MR=1 (prefill and decode).
. "$PKG/config/arm-C-prod-ptpcfix-nohip.env"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA MC_ENABLE_PARALLEL_REG_MR=0 MC_MAX_CONCURRENT_REG_MR=1"
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA MC_ENABLE_PARALLEL_REG_MR=0 MC_MAX_CONCURRENT_REG_MR=1"
