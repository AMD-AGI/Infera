# C + PTPC/#45800 with Mooncake's HIP transport off on both legs (MC_DISABLE_HIP=1: hip route priority 0, so a same-host
# KV transfer goes over RDMA; MC_DISABLE_HIP_TRANSPORT, which the kit sets, is read nowhere in Mooncake faae8dd4, see
# yihou/samenode-kv-transfer-slow.brief.yihou.md). With MC_ENABLE_DEST_LOCAL_RAIL=1 both ends use the destination GPU's
# ionic device (same-device loopback; two different devices of one host do not connect). For one-node 4+4 only.
. "$PKG/config/arm-C-prod-ptpcfix.env"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA MC_DISABLE_HIP=1" PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA MC_DISABLE_HIP=1"
export DURATION="${NOHIP_DURATION:-1500}"
