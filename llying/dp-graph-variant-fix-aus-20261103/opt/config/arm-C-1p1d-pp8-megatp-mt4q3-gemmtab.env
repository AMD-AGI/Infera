# arm-C-1p1d-pp8-megatp-mt4q3 plus aiter bf16 GEMM table rows for the decode verify M values (4-128 rows per rank) of
# q_b_proj, fused_qkv_a and the indexer's wq_b / wk (kit/aiter_csv/kopt_glm52_decode_bf16_tuned_gemm.csv, 32 rows, only
# rows at least 0.2 us faster than the production tables). Microbench 11-12: about 0.1 ms per step (q_b_proj -0.8,
# fused_qkv_a -0.5, wq_b -0.4 us per call at 48-104 rows). Table only, no code change.
. "$PKG/config/arm-C-1p1d-pp8-megatp-mt4q3.env"
export DECODE_MOUNT_EXTRA="$DECODE_MOUNT_EXTRA $PKG/kit/aiter_csv/kopt_glm52_decode_bf16_tuned_gemm.csv:/sgl-workspace/aiter/aiter/configs/model_configs/kopt_glm52_decode_bf16_tuned_gemm.csv:ro"
