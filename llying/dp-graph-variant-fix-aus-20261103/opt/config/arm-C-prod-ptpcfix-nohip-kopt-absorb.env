# KERNEL-PROGRESS-20261109 #2: the one-node 4+4 C arm (C + PTPC/#45800, MC_DISABLE_HIP=1) with the two MLA absorb BMM
# decode configs mounted over aiter's gfx950 files (M <= 256 buckets retuned for 64 heads per rank; prefill's
# M >= 512 buckets unchanged). Decode leg only.
. "$PKG/config/arm-C-prod-ptpcfix-nohip.env"
KOPT_CFG=/perf_apps/liyingli/bench_agentx/kopt-20261109/configs
KOPT_GEMM=/sgl-workspace/aiter/aiter/ops/triton/configs/gfx950/triton/gemm
KOPT_KC=FUSED-FP8-BMM-ROPE-CAT-AND-CACHE-MLA-N=512-K=192.json
KOPT_VC=BATCHED_GEMM-A8W8-A_PER_TOKEN_GROUP_PREQUANT_W_PER_BATCHED_TENSOR_QUANT-N=256-K=512.json
export DECODE_MOUNT_EXTRA="$DECODE_MOUNT_EXTRA $KOPT_CFG/$KOPT_KC:$KOPT_GEMM/fused_fp8_bmm_rope_cat_and_cache_mla/$KOPT_KC:ro $KOPT_CFG/$KOPT_VC:$KOPT_GEMM/batched_gemm_a8w8_a_per_token_group_prequant_w_per_batched_tensor_quant/$KOPT_VC:ro"
