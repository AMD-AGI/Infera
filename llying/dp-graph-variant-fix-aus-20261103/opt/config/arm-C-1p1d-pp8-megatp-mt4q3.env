# arm-C-1p1d-pp8-megatp-mt4 with lb_q 3: 12 GEMM2 chunks of 512 columns make aiter taper the column groups to
# [3, 3, 3, 2, 1], which shortens the wait on the last GEMM2 units. bench/megatp_cgw.py on real weights 11-11 16:15 / 16:50
# (two runs), 256 / 384 / 512 / 640 / 768 global tokens 143.4 / 153.1 / 159.2 / 171.5 / 178.1 us vs q 2
# 148.2 / 157.9 / 163.2 / 175.5 / 185.3 us, same SNR (29.0-29.6 dB against production).
. "$PKG/config/arm-C-1p1d-pp8-megatp.env"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA AITER_MEGAMOE_TP_LB_MT=4 AITER_MEGAMOE_TP_LB_MT_SMALL=4 AITER_MEGAMOE_TP_LB_NPP=2 AITER_MEGAMOE_TP_LB_Q=3"
