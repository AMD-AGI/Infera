# arm-C-1p1d-pp8-megatp-mt4q3 with the decode KV pool capped below 2 GiB per layer (--max-total-tokens 3680000, as in
# arm-C-1p1d-pp8-kopt), so KF sparse MLA keeps 32-bit buffer loads: microbench 88 rows 61 -> 46 us, at 9% less KV
# capacity. The kernel-side alternative is arm-C-1p1d-pp8-megatp-mt4q3-sparse2g.
. "$PKG/config/arm-C-1p1d-pp8-megatp-mt4q3.env"
export DECODE_EXTRA_ARGS="$DECODE_EXTRA_ARGS --max-total-tokens 3680000"
