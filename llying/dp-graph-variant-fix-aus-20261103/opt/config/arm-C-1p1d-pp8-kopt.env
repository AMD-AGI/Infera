# KERNEL-PROGRESS-20261109 #1-#3 on the 1P(PP8) + 1D(TP8 / DP8) arm (arm-C-1p1d-pp8, 56,593 at C208), decode leg only:
#   #1 aiter's glm5_fp4_tuned_fmoe.csv with the (6144, 256, 257, token=1024) row set to the token=512 row's kernels
#      (block_m 32, atomic stage 2): decode M 576-832 (graph bs 18-26) no longer get the block_m 64 + reduce pair;
#   #2 the two MLA absorb BMM decode configs (M <= 256 buckets retuned for 64 heads per rank);
#   #3 --max-total-tokens 3680000: each layer's KV pool stays below 2^31 bytes (3,728,270 slots of 576 B), where the KF
#      sparse-MLA kernel keeps 32-bit page offsets (+33 % above it); KV capacity 4.07M -> 3.68M tokens. Check after start-up: the KF log line "sparse_mla ... kv=(N, 1, 576)" needs N <= 3,728,270.
. "$PKG/config/arm-C-1p1d-pp8.env"
KOPT_CFG=/perf_apps/liyingli/bench_agentx/kopt-20261109/configs
KOPT_GEMM=/sgl-workspace/aiter/aiter/ops/triton/configs/gfx950/triton/gemm
KOPT_KC=FUSED-FP8-BMM-ROPE-CAT-AND-CACHE-MLA-N=512-K=192.json
KOPT_VC=BATCHED_GEMM-A8W8-A_PER_TOKEN_GROUP_PREQUANT_W_PER_BATCHED_TENSOR_QUANT-N=256-K=512.json
export DECODE_MOUNT_EXTRA="$DECODE_MOUNT_EXTRA $KOPT_CFG/glm5_fp4_tuned_fmoe.csv:/sgl-workspace/aiter/aiter/configs/model_configs/glm5_fp4_tuned_fmoe.csv:ro $KOPT_CFG/$KOPT_KC:$KOPT_GEMM/fused_fp8_bmm_rope_cat_and_cache_mla/$KOPT_KC:ro $KOPT_CFG/$KOPT_VC:$KOPT_GEMM/batched_gemm_a8w8_a_per_token_group_prequant_w_per_batched_tensor_quant/$KOPT_VC:ro"
export DECODE_EXTRA_ARGS="$DECODE_EXTRA_ARGS --max-total-tokens 3680000"
