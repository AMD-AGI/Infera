# Dense FP8 on the prefill only (decode keeps the bf16 linears), one-node 4+4 with MC_DISABLE_HIP=1. Both legs dense FP8
# (11-05, 15): C104 53,176 = no-HIP 53,209, prefill full chunk 311 ms (331), TTFT p90 7.36 s (9.64), but decode steps
# slower at 9-22 running on the busiest rank (an activation quant kernel before each FP8 GEMM) and interactivity p90 55.4
# (61.0). This keeps the prefill gain without the decode cost.
. "$PKG/config/arm-C-prod-ptpcfix-nohip.env"
_q=/sgl-workspace/sglang/python/sglang/srt/layers/quantization/quark/quark.py
_u=/sgl-workspace/sglang/python/sglang/srt/models/deepseek_common/utils.py
export PREFILL_MOUNT_EXTRA="$PREFILL_MOUNT_EXTRA $PKG/../dense-fp8/patched/layers/quantization/quark/quark.py:$_q:ro $PKG/../dense-fp8/patched/models/deepseek_common/utils.py:$_u:ro"
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA SGLANG_QUARK_EXCLUDED_ONLINE_FP8=self_attn.fused_qkv_a_proj_with_mqa,self_attn.q_b_proj,self_attn.o_proj,mlp.gate_up_proj,mlp.down_proj SGLANG_USE_AITER_FP8_PER_TOKEN=1"
for _t in "$PKG"/../dense-fp8/tune/glm52_densefp8*_a8w8_bpreshuffle_tuned_gemm.csv; do
    [[ -s "$_t" ]] || continue
    export PREFILL_MOUNT_EXTRA="$PREFILL_MOUNT_EXTRA $_t:/sgl-workspace/aiter/aiter/configs/model_configs/$(basename "$_t"):ro"
done
export DURATION=3600
unset _q _u _t
