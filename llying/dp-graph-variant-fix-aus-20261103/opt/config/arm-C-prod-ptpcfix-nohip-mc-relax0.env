# REPORT-20261110 section 6: one-node production C arm with a Mooncake knob against the amdgpu 6.19 start-up segfault: MC_IB_PCI_RELAXED_ORDERING=0 (prefill and decode).
. "$PKG/config/arm-C-prod-ptpcfix-nohip.env"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA MC_IB_PCI_RELAXED_ORDERING=0"
export PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA MC_IB_PCI_RELAXED_ORDERING=0"
