# REPORT-20261110 section 6: the one-node 4+4 production C arm with Mooncake registering KV VRAM through peer memory
# instead of dma-buf (MOONCAKE_DISABLE_HIP_DMABUF=1, kit README note 5). On amdgpu 6.19.14 firmware-pilot nodes the
# default dma-buf registration is the suspected cause of the start-up segfault in c10::hip::HIPStream::stream().
. "$PKG/config/arm-C-prod-ptpcfix-nohip.env"
export MOONCAKE_DISABLE_HIP_DMABUF=1
