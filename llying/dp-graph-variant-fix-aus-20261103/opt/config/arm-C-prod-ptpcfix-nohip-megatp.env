# KERNEL-PROGRESS-20261109 section 14: the one-node 4+4 production C arm with only the TP4 decode MoE layers as aiter's
# MegaMoeTP (overlay-kopt/kopt_megatp, bf16 comm; all-gather + MoE + reduce-scatter in one kernel inside the decode CUDA
# graphs). Isolates the overlay for an end-to-end PD gate on one node (the TP8 PP8 arm needs two). overlay-kopt with
# its defaults equals the production overlay, so KOPT_MEGATP is the only change.
. "$PKG/config/arm-C-prod-ptpcfix-nohip.env"
export DECODE_MOUNT_EXTRA="${DECODE_MOUNT_EXTRA/\/overlay:\/yihou_overlay:ro//overlay-kopt:/yihou_overlay:ro}"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA KOPT_MEGATP=1 KOPT_MEGATP_COMM=bf16 HSA_ENABLE_IPC_MODE_LEGACY=1"
