# Acceptance bisection: C production with yihou's KF kernels off (stock sparse MLA / indexer / MoE on the decode).
. "$PKG/config/arm-C-prod.env"
export DECODE_ENV_EXTRA="${DECODE_ENV_EXTRA//YIHOU_KF_SPARSE=1/YIHOU_KF_SPARSE=0}"
export DECODE_ENV_EXTRA="${DECODE_ENV_EXTRA//YIHOU_KF_INDEXER=1/YIHOU_KF_INDEXER=0}"
export DECODE_ENV_EXTRA="${DECODE_ENV_EXTRA//YIHOU_KF_MOE=1/YIHOU_KF_MOE=0}"
