# Dense FP8 (arm-C-prod-ptpcfix-densefp8) with Mooncake's HIP transport off on both legs (MC_DISABLE_HIP=1, see
# arm-C-prod-ptpcfix-nohip.env): one-node 4+4.
. "$PKG/config/arm-C-prod-ptpcfix-densefp8.env"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA MC_DISABLE_HIP=1" PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA MC_DISABLE_HIP=1"
