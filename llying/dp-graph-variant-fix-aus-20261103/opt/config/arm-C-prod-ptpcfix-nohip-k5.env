# C + PTPC/#45800, one-node 4+4 with MC_DISABLE_HIP=1, MTP K5 (EAGLE 5/1/6) at the golden acceptance 3.61: with the K3
# run at the same CONC it gives two step-time-by-load curves, so the K3/K5 crossover (AL / step time) can be computed
# per busiest-rank load instead of guessed per CONC.
. "$PKG/config/arm-C-prod-ptpcfix-nohip.env"
export SIM_ACCEPT_LEN=3.61 DURATION="${K_DURATION:-3600}"
export PREFILL_EXTRA_ARGS="${PREFILL_EXTRA_ARGS/--speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4/--speculative-num-steps 5 --speculative-eagle-topk 1 --speculative-num-draft-tokens 6}"
export DECODE_EXTRA_ARGS="${DECODE_EXTRA_ARGS/--speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4/--speculative-num-steps 5 --speculative-eagle-topk 1 --speculative-num-draft-tokens 6}"
