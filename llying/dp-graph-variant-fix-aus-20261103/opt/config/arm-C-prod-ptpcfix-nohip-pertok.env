# no-HIP baseline + SGLANG_USE_AITER_FP8_PER_TOKEN=1 on the decode only (no dense FP8): in the dense FP8 trace this
# switched the NextN draft MoE (PTPC FP8) to aiter fmoe_bf16_pertokenFp8, draft + draft_extend about -0.8 ms per step.
. "$PKG/config/arm-C-prod-ptpcfix-nohip.env"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA SGLANG_USE_AITER_FP8_PER_TOKEN=1" DURATION=3600
