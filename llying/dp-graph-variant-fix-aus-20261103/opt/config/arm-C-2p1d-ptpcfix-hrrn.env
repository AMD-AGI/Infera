# 2P1D (arm-C-2p1d-ptpcfix) with the prefill queue ordered by HRRN (highest response ratio next, token-based aging,
# in v0.5.22) instead of shortest-prefill-first, which starves long cold prompts (> 128K uncached: TTFT p99 1,017 s).
. "$PKG/config/arm-C-2p1d-ptpcfix.env"
export PREFILL_EXTRA_ARGS="$PREFILL_EXTRA_ARGS --schedule-policy hrrn"
