# 2P1D on the same two nodes: C production (E11 + the fix) with two TP1 x PP4 prefills (GPUs 0-3, 4-7 of the prefill
# node, HiCache each) and a TP8 / DP8-attention decode (all 8 GPUs of the decode node). Scored at C208 (104 lanes per
# prefill, as in 4+4). best-4p4-51k README 4.3: per-GPU MoE weights halve, per-GPU KV +32 %; estimate 0 to +10 %.
. "$PKG/config/arm-C-prod.env"
export PREFILL_WORKERS=2 PREFILL0_GPUS=0,1,2,3 PREFILL1_GPUS=4,5,6,7 DECODE_GPUS=0,1,2,3,4,5,6,7 CONC=208
