# 1P1D on 16 GPUs: one TP1 x PP8 prefill (all 8 GPUs of the prefill node, one radix tree + HiCache 8 x 250 GB) and the
# TP8 / DP8 decode; C + PTPC/#45800 as in arm-C-2p1d-ptpcfix. Against 2 x PP4: no duplicated prefixes across two
# instances (2P1D recomputes ~8.5 % more), half the weights per prefill GPU; 8 pipeline stages. Last stage holds the
# LM head and the NextN layer, so it takes two fewer layers (as 20,20,20,18 for PP4).
. "$PKG/config/arm-C-prod-ptpcfix.env"
export PREFILL_WORKERS=1 PREFILL0_GPUS=0,1,2,3,4,5,6,7 PREFILL1_GPUS=0,1,2,3,4,5,6,7 DECODE_GPUS=0,1,2,3,4,5,6,7 CONC=208
export PP_LAYER_PARTITION=10,10,10,10,10,10,10,8
