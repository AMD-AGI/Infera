# KERNEL-PROGRESS-20261109 K5 alone on the one-node 4+4 C arm: overlay-kopt with the KF indexer fused2 grouped by the
# 4 verify rows of a K3 request (DSA_LPT_GROUP_ROWS=4, DSA_LPT_NG2=32). No absorb configs, KF MoE gate unchanged.
. "$PKG/config/arm-C-prod-ptpcfix-nohip.env"
export DECODE_MOUNT_EXTRA="${DECODE_MOUNT_EXTRA/\/overlay:\/yihou_overlay:ro//overlay-kopt:/yihou_overlay:ro}"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA DSA_LPT_GROUP_ROWS=4 DSA_LPT_NG2=32"
