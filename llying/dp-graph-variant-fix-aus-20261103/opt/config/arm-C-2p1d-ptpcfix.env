# 2P1D on the best correct 4+4 config: C + PTPC with SGLang #45800 (real draft acceptance ~3.6). Two TP1 x PP4 prefills
# (GPUs 0-3, 4-7 of the prefill node) and a TP8 / DP8-attention decode. Scored at C208 (104 lanes per prefill).
. "$PKG/config/arm-C-prod-ptpcfix.env"
export PREFILL_WORKERS=2 PREFILL0_GPUS=0,1,2,3 PREFILL1_GPUS=4,5,6,7 DECODE_GPUS=0,1,2,3,4,5,6,7 CONC=208
