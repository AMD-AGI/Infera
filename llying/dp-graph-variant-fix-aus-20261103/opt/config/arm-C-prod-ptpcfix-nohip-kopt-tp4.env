# KERNEL-PROGRESS-20261109: the TP4-side kernel changes on the one-node 4+4 C arm, cumulative:
#   #2  the two MLA absorb BMM decode configs (arm-C-prod-ptpcfix-nohip-kopt-absorb);
#   K5  KF indexer fused2 grouped by the 4 verify rows of a K3 request (DSA_LPT_GROUP_ROWS=4) and ranking up to 32
#       groups (DSA_LPT_NG2=32), so every K3 row count up to 128 takes fused2 (bit-identical to preshuffle);
#   K8  KF MoE only up to M 416 (YIHOU_KF_MOE_M_HI=416): aiter is faster from M ~432 at TP4.
# K5 / K8 need overlay-kopt (the production overlay with those constants read from the environment; defaults unchanged).
. "$PKG/config/arm-C-prod-ptpcfix-nohip-kopt-absorb.env"
export DECODE_MOUNT_EXTRA="${DECODE_MOUNT_EXTRA/\/overlay:\/yihou_overlay:ro//overlay-kopt:/yihou_overlay:ro}"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA DSA_LPT_GROUP_ROWS=4 DSA_LPT_NG2=32 YIHOU_KF_MOE_M_HI=416"
