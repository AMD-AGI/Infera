# C + PTPC / #45800 + online FP8 for the target model's Quark-excluded bf16 linears (dense-fp8/patched quark.py, ROCm
# only, opt-in by SGLANG_QUARK_EXCLUDED_ONLINE_FP8): attention fused_qkv_a_proj_with_mqa / q_b_proj / o_proj and the
# dense MLP of layers 0-2; weights per output channel at load, activations per token (SGLANG_USE_AITER_FP8_PER_TOKEN=1).
# Kept bf16: the NextN draft (model.decoder.* / index >= num_hidden_layers), kv_b_proj, the indexer (the gfx950 fused
# indexer caches a bf16 [wk ; weights_proj] at init), router gate, lm_head, embeddings. Both legs.
. "$PKG/config/arm-C-prod-ptpcfix.env"
_q=/sgl-workspace/sglang/python/sglang/srt/layers/quantization/quark/quark.py
_u=/sgl-workspace/sglang/python/sglang/srt/models/deepseek_common/utils.py
# utils.py: _is_block_scale_fp8 reads the online per-channel [1, N] weight scale as block-scale (prefill MHA q_b_proj
# took the fused group-quant path and asserted, 11-04 22:02); quark.py marks these layers and utils.py skips them.
_m="$PKG/../dense-fp8/patched/layers/quantization/quark/quark.py:$_q:ro $PKG/../dense-fp8/patched/models/deepseek_common/utils.py:$_u:ro"
_e="SGLANG_QUARK_EXCLUDED_ONLINE_FP8=self_attn.fused_qkv_a_proj_with_mqa,self_attn.q_b_proj,self_attn.o_proj,mlp.gate_up_proj,mlp.down_proj SGLANG_USE_AITER_FP8_PER_TOKEN=1"
export DECODE_MOUNT_EXTRA="$DECODE_MOUNT_EXTRA $_m" PREFILL_MOUNT_EXTRA="$PREFILL_MOUNT_EXTRA $_m"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA $_e" PREFILL_ENV_EXTRA="$PREFILL_ENV_EXTRA $_e"
unset _q _u _m _e
