# C production (E11 + the fix) for a decode trace under AgentX load: DEBUG_CLR_GRAPH_PACKET_CAPTURE=0 makes the
# kernels inside the replayed graphs visible to the profiler (11-02 night33: output unchanged).
. "$PKG/config/arm-C-prod.env"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA DEBUG_CLR_GRAPH_PACKET_CAPTURE=0"
