+++ opt-aus-20261103/pkg/kit/engine/up.sh	2026-11-03 16:51:35.752073000 +0000
@@ -43,7 +43,12 @@
 
 echo "===== 3. router: kv-aware, session affinity on prefill picks ====="
 read -ra router_extra <<<"$ROUTER_EXTRA_ARGS"
-docker run -d --name "$CTR-router" --network host -v "$MODEL:$MODEL:ro" "$IMAGE" \
+# Router-only hooks: ROUTER_MOUNT_EXTRA (space-separated src:dst:ro, e.g. a rebuilt infera-router over
+# /usr/local/bin/infera-router) and ROUTER_ENV_EXTRA (space-separated KEY=VAL, e.g. INFERA_DECODE_REQUEST_WEIGHT).
+router_opts=()
+for mx in ${ROUTER_MOUNT_EXTRA:-}; do router_opts+=(-v "$mx"); done
+for kv in ${ROUTER_ENV_EXTRA:-}; do router_opts+=(-e "$kv"); done
+docker run -d --name "$CTR-router" --network host -v "$MODEL:$MODEL:ro" "${router_opts[@]}" "$IMAGE" \
     python3 -m infera.server --host 0.0.0.0 --port "$ROUTER_PORT" --router-backend rust \
     --discovery-backend etcd --etcd-endpoint "$PREFILL_NODE_IP:$ETCD_PORT" \
     --request-transport http --kv-event-transport zmq --router-tokenizer-path "$MODEL" \
