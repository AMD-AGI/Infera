diff -ru vfix-20261103/kit/engine/up.sh opt-aus-20261103/pkg/kit/engine/up.sh
--- vfix-20261103/kit/engine/up.sh	2026-11-03 13:10:30.814182400 +0000
+++ opt-aus-20261103/pkg/kit/engine/up.sh	2026-11-03 16:51:35.752073000 +0000
@@ -43,7 +43,12 @@
 
 echo "===== 3. router: kv-aware, session affinity on prefill picks ====="
 read -ra router_extra <<<"$ROUTER_EXTRA_ARGS"
-docker run -d --name "$CTR-router" --network host -v "$MODEL:$MODEL:ro" "$IMAGE" \
+# Router-only hooks: ROUTER_MOUNT_EXTRA (space-separated src:dst:ro, e.g. a rebuilt infera-router over
+# /usr/local/bin/infera-router) and ROUTER_ENV_EXTRA (space-separated KEY=VAL, e.g. INFERA_DECODE_REQUEST_WEIGHT).
+router_opts=()
+for mx in ${ROUTER_MOUNT_EXTRA:-}; do router_opts+=(-v "$mx"); done
+for kv in ${ROUTER_ENV_EXTRA:-}; do router_opts+=(-e "$kv"); done
+docker run -d --name "$CTR-router" --network host -v "$MODEL:$MODEL:ro" "${router_opts[@]}" "$IMAGE" \
     python3 -m infera.server --host 0.0.0.0 --port "$ROUTER_PORT" --router-backend rust \
     --discovery-backend etcd --etcd-endpoint "$PREFILL_NODE_IP:$ETCD_PORT" \
     --request-transport http --kv-event-transport zmq --router-tokenizer-path "$MODEL" \
diff -ru vfix-20261103/kit/engine/worker.sh opt-aus-20261103/pkg/kit/engine/worker.sh
--- vfix-20261103/kit/engine/worker.sh	2026-11-03 13:10:30.818879600 +0000
+++ opt-aus-20261103/pkg/kit/engine/worker.sh	2026-11-04 21:54:35.058034900 +0000
@@ -83,7 +83,7 @@
     env+=(SGLANG_HICACHE_HOST_REGISTER_CHUNK_GB=512)
     # PP4 x TP1 prefill (as GB300 Dynamo+SGLang): the last stage also holds
     # the LM head and the NextN draft layer, so it takes two fewer layers.
-    env+=(SGLANG_PP_LAYER_PARTITION=20,20,20,18)
+    env+=(SGLANG_PP_LAYER_PARTITION=${PP_LAYER_PARTITION:-20,20,20,18})
     args+=(
         --tp-size 1 --pp-size "$n_gpus" --disable-overlap-schedule
         --chunked-prefill-size "${PP4_CHUNK:-16384}" --max-prefill-tokens "${PP4_CHUNK:-16384}"
@@ -140,7 +140,8 @@
 # Both prefills run with --ipc host on one node, and RCCL names shared memory
 # after process ids, which start low in every container: prefill 1 burns
 # 30,000 pids first so its ranks never collide with prefill 0's (README note 4).
-if [[ "$role" == prefill && "$idx" == 1 ]]; then
+# A decode on the prefill node (DECODE_NODE_IP == PREFILL_NODE_IP) shares the same namespace and burns them the same way.
+if [[ "$role" == prefill && "$idx" == 1 ]] || [[ "$role" == decode && "$DECODE_NODE_IP" == "$PREFILL_NODE_IP" ]]; then
     cmd=(bash -c 'i=0; while [ $i -lt 30000 ]; do ( : ); i=$((i + 1)); done; exec "$@"' _ "${cmd[@]}")
 fi
 
