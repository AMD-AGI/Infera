+    def _excluded_layer_online_fp8(self, prefix: str) -> bool:
+        """Whether an excluded (bf16) target linear is converted to FP8 online."""
+        names = _excluded_online_fp8_names()
+        if not names or not is_hip():
+            return False
+        match = _EXCLUDED_ONLINE_FP8_TARGET_LAYER.match(prefix)
+        if match is None:
+            return False
+        if self.num_hidden_layers is not None and int(match.group(1)) >= (
+            self.num_hidden_layers
+        ):
+            return False
+        return match.group(2) in names
+
