+# A Quark checkpoint keeps the linears in its "exclude" list in bf16. On ROCm,
+# SGLANG_QUARK_EXCLUDED_ONLINE_FP8 (comma-separated module names under
+# model.layers.<i>., e.g. "self_attn.o_proj,mlp.down_proj") converts those target
+# layers to FP8 online: weights per output channel at load, activations per token
+# with SGLANG_USE_AITER_FP8_PER_TOKEN=1. Draft layers are never converted (the
+# draft runs at the precision it ships in): a NextN block loads under
+# model.decoder.*, an appended MTP layer has index >= num_hidden_layers.
+_EXCLUDED_ONLINE_FP8_TARGET_LAYER = re.compile(r"^model\.layers\.(\d+)\.(.+)$")
+
+
+def _excluded_online_fp8_names() -> frozenset[str]:
+    names = os.environ.get("SGLANG_QUARK_EXCLUDED_ONLINE_FP8", "")
+    return frozenset(name.strip() for name in names.split(",") if name.strip())
+
 _MOE_SHARED_EXPERT_QUANT_LAYER0_BASES: tuple[str, ...] = (
     "model.layers.0",
