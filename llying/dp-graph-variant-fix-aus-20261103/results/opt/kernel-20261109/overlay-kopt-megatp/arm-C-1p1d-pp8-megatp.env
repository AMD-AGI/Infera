# KERNEL-PROGRESS-20261109 section 14: arm-C-1p1d-pp8-kopt-nocap (#1 MoE token=1024 row -> block_m 32 atomic, #2 MLA
# absorb BMM configs; 56,595 at C208) plus the TP8 decode MoE layers as aiter's MegaMoeTP (overlay-kopt/kopt_megatp:
# all-gather + MoE + reduce-scatter in one kernel inside the decode CUDA graphs, bf16 comm; 8-GPU op test ~204 us per
# layer at 704 global tokens vs ~250 us). The decode log has "[kopt-megatp]" lines for the instance and each new shape.
. "$PKG/config/arm-C-1p1d-pp8-kopt-nocap.env"
export DECODE_MOUNT_EXTRA="${DECODE_MOUNT_EXTRA/\/overlay:\/yihou_overlay:ro//overlay-kopt:/yihou_overlay:ro}"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA KOPT_MEGATP=1 KOPT_MEGATP_COMM=bf16 HSA_ENABLE_IPC_MODE_LEGACY=1"
