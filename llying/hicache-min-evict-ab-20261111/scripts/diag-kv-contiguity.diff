+# e1ab diagnostic (not for upstream): contiguity of the page lists that PD KV transfer groups into blocks.
+_KVDIAG = {"calls": 0, "idx": 0, "blocks": 0, "src_brk": 0, "dst_brk": 0}
+_KVDIAG_LOCK = threading.Lock()
+
+
+def _kvdiag_count(src, dst, brk):
+    import logging
+    import time
+
+    with _KVDIAG_LOCK:
+        d = _KVDIAG
+        d["calls"] += 1
+        d["idx"] += int(src.size)
+        d["blocks"] += int(brk.size) + 1
+        d["src_brk"] += int(np.count_nonzero(np.diff(src) != 1))
+        d["dst_brk"] += int(np.count_nonzero(np.diff(dst) != 1))
+        if d["calls"] % 200 == 0:
+            logging.getLogger(__name__).warning(
+                "KVDIAG t=%.1f calls=%d idx=%d blocks=%d src_brk=%d dst_brk=%d idx/block=%.2f",
+                time.time(), d["calls"], d["idx"], d["blocks"], d["src_brk"], d["dst_brk"],
+                d["idx"] / max(d["blocks"], 1),
+            )
+
+
