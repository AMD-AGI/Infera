diff --git a/src/umbp/include/umbp/local/host_mem_allocator.h b/src/umbp/include/umbp/local/host_mem_allocator.h
index 4b4162c..2528dfc 100644
--- a/src/umbp/include/umbp/local/host_mem_allocator.h
+++ b/src/umbp/include/umbp/local/host_mem_allocator.h
@@ -35,6 +35,11 @@ enum class HostBufferBacking : int {
   // backed (MFD_HUGETLB+MAP_HUGETLB): some RDMA NICs have a small MTT table
   // and cannot register a large 4 KiB-paged region.
   kAnonymousShmHugetlb = 3,
+  // Pinned host memory allocated by the driver (hipHostMalloc, Portable | Mapped). Unlike anonymous pages registered
+  // with hipHostRegister -- which the kernel may still migrate (compaction), and which the GPU driver tracks as userptr
+  // and revalidates whole, with the process's GPU queues evicted, after any such migration -- these pages are never
+  // migrated. Not fd-shareable. Falls back to kAnonymous when the allocation fails.
+  kHipPinned = 4,
 };
 
 struct HostBufferOptions {
diff --git a/src/umbp/local/host_mem_allocator.cpp b/src/umbp/local/host_mem_allocator.cpp
index cae1c17..253a235 100644
--- a/src/umbp/local/host_mem_allocator.cpp
+++ b/src/umbp/local/host_mem_allocator.cpp
@@ -22,6 +22,7 @@
 #include "umbp/local/host_mem_allocator.h"
 
 #include <fcntl.h>
+#include <hip/hip_runtime_api.h>
 #include <sys/mman.h>
 #include <unistd.h>
 
@@ -246,6 +247,40 @@ HostBufferHandle AllocAnonymous(size_t size, const HostBufferOptions& opts) {
   return handle;
 }
 
+HostBufferHandle AllocHipPinned(size_t size, const HostBufferOptions& opts) {
+  HostBufferHandle handle;
+  if (size == 0) return handle;
+
+  const size_t page_size = GetPageSize();
+  const std::optional<size_t> mapped_size = AlignUpChecked(size, page_size);
+  if (!mapped_size.has_value()) return handle;
+
+  // Non-coherent like registered memory: GPU accesses may be cached; host and device synchronize through the
+  // stream and event APIs, as they already do for the hipHostRegister'd tier.
+  void* ptr = nullptr;
+  const hipError_t status = hipHostMalloc(
+      &ptr, *mapped_size, hipHostMallocPortable | hipHostMallocMapped | hipHostMallocNonCoherent);
+  if (status != hipSuccess || ptr == nullptr) {
+    MORI_UMBP_WARN(
+        "HostMemAllocator: hipHostMalloc of {} MiB failed: {}; falling back to anonymous pages",
+        *mapped_size >> 20, hipGetErrorString(status));
+    (void)hipGetLastError();
+    HostBufferOptions fallback = opts;
+    fallback.backing = HostBufferBacking::kAnonymous;
+    return AllocAnonymous(size, fallback);
+  }
+  if (opts.numa_node >= 0) {
+    MORI_UMBP_WARN("HostMemAllocator: numa_node={} is not applied to hipHostMalloc memory", opts.numa_node);
+  }
+
+  handle.ptr = ptr;
+  handle.requested_size = size;
+  handle.mapped_size = *mapped_size;
+  handle.actual_backing = HostBufferBacking::kHipPinned;
+  handle.actual_alignment = page_size;
+  return handle;
+}
+
 HostBufferHandle AllocAnonymousShm(size_t size, const HostBufferOptions& opts) {
   HostBufferHandle handle;
   if (size == 0) return handle;
@@ -443,6 +478,8 @@ HostBufferHandle HostMemAllocator::Alloc(size_t size, const HostBufferOptions& o
       return AllocAnonymousShm(size, opts);
     case HostBufferBacking::kAnonymousShmHugetlb:
       return AllocAnonymousShmHugetlb(size, opts);
+    case HostBufferBacking::kHipPinned:
+      return AllocHipPinned(size, opts);
     default:
       return {};
   }
@@ -451,6 +488,18 @@ HostBufferHandle HostMemAllocator::Alloc(size_t size, const HostBufferOptions& o
 void HostMemAllocator::Free(HostBufferHandle& handle) {
   if (!handle.valid()) return;
 
+  if (handle.actual_backing == HostBufferBacking::kHipPinned) {
+    void* ptr = handle.ptr;
+    handle.ptr = nullptr;
+    handle.requested_size = 0;
+    handle.mapped_size = 0;
+    if (hipHostFree(ptr) != hipSuccess) {
+      MORI_UMBP_WARN("HostMemAllocator: hipHostFree({}) failed", ptr);
+      (void)hipGetLastError();
+    }
+    return;
+  }
+
   void* ptr_to_unmap = handle.ptr;
   size_t size_to_unmap = handle.mapped_size;
   bool defer_unmap = false;
diff --git a/src/umbp/local/tiers/host_registration.cpp b/src/umbp/local/tiers/host_registration.cpp
index 9566fb5..c21775e 100644
--- a/src/umbp/local/tiers/host_registration.cpp
+++ b/src/umbp/local/tiers/host_registration.cpp
@@ -75,7 +75,7 @@ HostTierRegistration::HostTierRegistration(void* base, size_t bytes)
 HostTierRegistration::~HostTierRegistration() {
   if (worker_.joinable()) worker_.join();
   if (registered_bytes_.load(std::memory_order_acquire) == 0) return;
-  if (hipHostUnregister(base_) != hipSuccess) (void)hipGetLastError();
+  if (owns_registration_ && hipHostUnregister(base_) != hipSuccess) (void)hipGetLastError();
 }
 
 void HostTierRegistration::Register() {
@@ -88,8 +88,18 @@ void HostTierRegistration::Register() {
   //
   // hipHostRegisterPortable so every rank's device can reach the tier;
   // hipHostRegisterMapped so a kernel can dereference it directly.
+  // Memory that is pinned host memory already (a kHipPinned pool from hipHostMalloc) needs no registration, only its
+  // device aliases; registering it again would fail.
+  unsigned int existing_flags = 0;
+  if (hipHostGetFlags(&existing_flags, base_) == hipSuccess) {
+    owns_registration_ = false;
+  } else {
+    (void)hipGetLastError();
+  }
   const hipError_t status =
-      hipHostRegister(base_, bytes_, hipHostRegisterMapped | hipHostRegisterPortable);
+      owns_registration_
+          ? hipHostRegister(base_, bytes_, hipHostRegisterMapped | hipHostRegisterPortable)
+          : hipSuccess;
   if (status != hipSuccess) {
     MORI_UMBP_WARN(
         "[DRAMTier] hipHostRegister of {} MiB failed: {}; the GPU gather path stays off and "
@@ -119,9 +129,10 @@ void HostTierRegistration::Register() {
     if (alias != nullptr) ++gatherable;
   }
   MORI_UMBP_INFO(
-      "[DRAMTier] host memory registered for GPU access: {} MiB in {:.1f} s ({}/{} devices "
+      "[DRAMTier] host memory {} for GPU access: {} MiB in {:.1f} s ({}/{} devices "
       "gatherable)",
-      bytes_ >> 20, seconds, gatherable, alias_bases_.size());
+      owns_registration_ ? "registered" : "pinned at allocation, mapped", bytes_ >> 20, seconds, gatherable,
+      alias_bases_.size());
 }
 
 bool HostTierRegistration::RecordDeviceAliases() {
