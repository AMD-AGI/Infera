+def _decode_radix_spec_allowed(cfg) -> bool:
+    # Chain drafts only: with topk == 1 the accepted tokens are a prefix of the
+    # draft slots, so the committed KV the tree inserts is contiguous.
+    if os.environ.get(_DECODE_RADIX_SPEC_ENV, "0") != "1":
+        return False
+    algorithm = str(cfg.speculative_algorithm).upper()
+    return algorithm in ("EAGLE", "NEXTN") and cfg.speculative_eagle_topk == 1
+
 
