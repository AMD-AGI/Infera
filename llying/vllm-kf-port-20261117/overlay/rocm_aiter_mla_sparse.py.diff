+def _gluon_group_rows(next_n: int) -> int:
+    """LPT dispatch group: a request's verify rows, given per request
+    (next_n > 1) or flattened one per row (next_n == 1). The sibling-pair
+    phase pairs rows inside a group, so a group must be even."""
+    group = next_n if next_n > 1 else _gluon_lpt_group_rows()
+    return group if group >= 2 and group % 2 == 0 and group <= 8 else 0
+
