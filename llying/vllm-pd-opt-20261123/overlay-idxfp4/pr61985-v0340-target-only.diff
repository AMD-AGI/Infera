+def _vpd_is_draft_indexer(vllm_config, prefix: str) -> bool:
+    """MTP draft indexers keep the FP8 cache (InferenceX: no MXFP4 on the draft).
+
+    A layer is the draft's when the model being built is an MTP model or its
+    layer index is >= the target's layer count (GLM-5.2: layers.78)."""
+    if _VPD_IDX_MXFP4_DRAFT:
+        return False
+    model_config = vllm_config.model_config
+    archs = set(getattr(model_config, "architectures", None) or ())
+    if any("MTP" in a for a in archs):
+        return True
+    m = re.search(r"layers\.(\d+)\.", prefix)
+    return m is not None and int(m.group(1)) >= _VPD_DRAFT_MIN_LAYER
