# a34 side B: a25 config + online FP8 (PTPC) on the target model's BF16 dense layers via v0.34.0's own --quantization-config
# (overlay-dfp8/dense_fp8_qcfg.json; MTP draft layer 78 and kv_b_proj untouched), prefill and decode. Numerics change: gate first
# (GSM8K, long context, garbage, real acceptance), then score. Decode KV about +9% (about 11.7 GiB weights per rank); the 1-GPU
# microbenchmark (results/dfp8-bench) gives about -1.2 ms per decode step at M = 56, prefill GEMMs 33-54% faster.
S_TAG=a34B-dfp8-pmnbt4096-plongthr2048-topkv3-a8cfg-3600
S_LB=1
S_KV_W=14
S_GEMM=1
S_FP4=1
S_TOPK=1
S_TOPK_IMPL=triton
S_D_ARGS="--max-num-batched-tokens 2048"
S_D_ENV="VPD_DP_LB_KV_CAP_TOKENS=3141120"
S_P_ARGS="--max-num-batched-tokens 4096 --long-prefill-token-threshold 2048"
S_DFP8=1
S_GATE=1
