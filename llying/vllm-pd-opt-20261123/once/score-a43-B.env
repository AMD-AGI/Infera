# a43 side B: the best config (a42 B: + item 8 packed FP4 dispatch) with the KV-aware DP balance weight 14 -> 5. Refit of the decode step on a42's steplog:
# 27.5 ms + 0.592 ms / request + 0.83 ms / M context (max rank); the a3 fit was 0.74 / 3.9, so the context term shrank ~5x (MXFP4 indexer, Triton top-k).
# With the refit the imbalance costs 0.79 ms / step and is almost all request count (busiest by cost = busiest by requests 96%), so W 14 over-weights KV.
# Config only, no numerics change, single run compared with a42 B (59,470).
S_TAG=a43B-kvw5-dfp8idxfp4-thpoff-kvoff-fp4pack-pmnbt4096-plongthr2048-topkv3-a8cfg-3600
S_LB=1
S_KV_W=5
S_GEMM=1
S_FP4=1
S_TOPK=1
S_TOPK_IMPL=triton
S_D_ARGS="--max-num-batched-tokens 2048"
S_D_ENV="VPD_DP_LB_KV_CAP_TOKENS=3141120"
S_P_ARGS="--max-num-batched-tokens 4096 --long-prefill-token-threshold 2048"
S_DFP8=1
S_IDXFP4=1
S_THPOFF=1
S_KVOFF=1
S_FP4PACK=1
