# a36 side B: a25 config + THP disabled in every engine process (S_THPOFF=1, prctl PR_SET_THP_DISABLE from dev/pd_opt/vllm_dsv41_agentx),
# same node and telemetry as side A. Removes the compaction the engines trigger themselves; does not fix evictions caused by other jobs.
S_TAG=a36B-thpoff-pmnbt4096-plongthr2048-topkv3-a8cfg-3600
S_LB=1
S_KV_W=14
S_GEMM=1
S_FP4=1
S_TOPK=1
S_TOPK_IMPL=triton
S_D_ARGS="--max-num-batched-tokens 2048"
S_D_ENV="VPD_DP_LB_KV_CAP_TOKENS=3141120"
S_P_ARGS="--max-num-batched-tokens 4096 --long-prefill-token-threshold 2048"
S_THPOFF=1
