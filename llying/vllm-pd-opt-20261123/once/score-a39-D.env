# a39 side D: a38 D config (a25 + dense FP8 + MXFP4 indexer) + THP disabled in every engine process (S_THPOFF=1), on v3-252 right after a38.
# a38 D on v3-252 had a 190 s prefill stall with KFD evictions of the four prefill workers coinciding with khugepaged collapses (thp_collapse_alloc) and page migrations;
# THP off should stop the collapses (PR_SET_THP_DISABLE also covers khugepaged). Same node, same config as a38 D, only the THP switch differs.
S_TAG=a39D-dfp8idxfp4-thpoff-pmnbt4096-plongthr2048-topkv3-a8cfg-3600
S_LB=1
S_KV_W=14
S_GEMM=1
S_FP4=1
S_TOPK=1
S_TOPK_IMPL=triton
S_D_ARGS="--max-num-batched-tokens 2048"
S_D_ENV="VPD_DP_LB_KV_CAP_TOKENS=3141120"
S_P_ARGS="--max-num-batched-tokens 4096 --long-prefill-token-threshold 2048"
S_DFP8=1
S_IDXFP4=1
S_THPOFF=1
