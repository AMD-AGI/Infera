# a31 side B: a25 config + Mooncake MC_RDMA_SIGNAL_INTERVAL=32 MC_MAX_WR=4096 on prefill and decode (one completion signal per
# 32 work requests, deeper send queues; the vLLM Mooncake RFC #63006 setting). Each request pulls 4 x 1.44 GB in ~33k 44 KB
# descriptors per PP stage at ~8 GB/s; the 8 NICs average ~1.9 GB/s, so the per-transfer descriptor rate is the target.
# B only on v3-037 next to the two a25-config runs (56,342 / 56,448). No numerics change, no gate.
S_TAG=a31B-mcsig32wr4096-pmnbt4096-plongthr2048-topkv3-a8cfg-3600
S_LB=1
S_KV_W=14
S_GEMM=1
S_FP4=1
S_TOPK=1
S_TOPK_IMPL=triton
S_D_ARGS="--max-num-batched-tokens 2048"
S_D_ENV="VPD_DP_LB_KV_CAP_TOKENS=3141120 MC_RDMA_SIGNAL_INTERVAL=32 MC_MAX_WR=4096"
S_P_ARGS="--max-num-batched-tokens 4096 --long-prefill-token-threshold 2048"
S_P_ENV="MC_RDMA_SIGNAL_INTERVAL=32 MC_MAX_WR=4096"
