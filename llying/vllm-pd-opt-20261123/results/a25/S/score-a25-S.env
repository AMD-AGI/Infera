# a25 side S (run first, PAIR_SIDES="S B"): gate only, Triton top-k v3 on all layers + shadow check (VPD_TOPK_SHADOW=1), the
# a23 run again with the reader fixed (it copies the counters only 150 s after the last captured call). "[vpd-topk-shadow]"
# lines in the decode log: t_val_bad = rows where Triton's selected values differ from vLLM's exact in-tree top-k.
S_TAG=a25S-gate-shadow
S_LB=1
S_KV_W=14
S_GEMM=1
S_FP4=1
S_TOPK=1
S_TOPK_IMPL=triton
S_GATE=1
S_SCORE=0
S_D_ARGS="--max-num-batched-tokens 2048 --gpu-memory-utilization 0.92"
S_D_ENV="VPD_DP_LB_KV_CAP_TOKENS=3141120 VPD_TOPK_SHADOW=1 VPD_TOPK_SHADOW_EVERY=15"
