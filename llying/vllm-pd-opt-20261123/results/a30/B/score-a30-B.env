# a30 side B (p4d4-pair4.sh): a25 config with the prefill -> decode KV moved over HIP IPC (XGMI) instead of Mooncake RDMA loopback
# on the decode GPU's NIC (each request pulls 4 x 1.44 GB at ~8 GB/s per PP stage, ~0.42 s in "KV fetch in progress").
# Needs KV pools outside GEM BOs (no IPC handle) and a shared PID namespace (pd1_up.sh MC_PROTO=hip). Gated first: if the
# deployment or the gate fails, no scoring. Compare with a25 B / a28 A on v3-037 (56,342 / 56,448).
S_TAG=a30B-mchip-nogem-pmnbt4096-plongthr2048-topkv3-a8cfg-3600
S_P_GEM=0
S_D_GEM=0
S_MC_PROTO=hip
S_LB=1
S_KV_W=14
S_GEMM=1
S_FP4=1
S_TOPK=1
S_TOPK_IMPL=triton
S_GATE=1
S_D_ARGS="--max-num-batched-tokens 2048"
S_D_ENV="VPD_DP_LB_KV_CAP_TOKENS=3141120"
S_P_ARGS="--max-num-batched-tokens 4096 --long-prefill-token-threshold 2048"
