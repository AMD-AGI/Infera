# a32 side B: a25 config + PP prefill scheduling overlay (vLLM #68614 + #68560 backported to v0.34.0, prefill only):
# admission past idle empty steps (at most one in flight; with a free batch slot a new request is scheduled at once
# instead of after a whole PP4 pass), microbatch cap max(2048, uncached backlog / 4) under the 4096 budget, and the
# 2048 threshold applied to a lone prefill too. Scheduling only, no numerics change, no gate.
S_TAG=a32B-ppsched-admit-mb2048-lone-pmnbt4096-plongthr2048-topkv3-a8cfg-3600
S_LB=1
S_KV_W=14
S_GEMM=1
S_FP4=1
S_TOPK=1
S_TOPK_IMPL=triton
S_D_ARGS="--max-num-batched-tokens 2048"
S_D_ENV="VPD_DP_LB_KV_CAP_TOKENS=3141120"
S_P_ARGS="--max-num-batched-tokens 4096 --long-prefill-token-threshold 2048"
S_PPSCHED=1
S_P_ENV="VPD_PP_ADMIT=1 VPD_PP_MICROBATCH_MIN_TOKENS=2048 VPD_PP_LONE_THRESHOLD=1"
