# a42 side B: the best config (a41 B: a25 + dense FP8 + MXFP4 indexer + THP off + CPU-tier overlay) + item 8: one all-gather per MoE layer (S_FP4PACK=1:
# HIP quant + pack + 1 AG + split; 4-GPU test 313322 bit-exact, graph saving 8.6-8.9 us per MoE layer at 8-64 rows per rank, about 0.65 ms per step).
# Gate first (dispatch layout change), then score; single run compared with a41 B (59,070). pair11: THP off now also reaches the decode.
S_TAG=a42B-dfp8idxfp4-thpoff-kvoff-fp4pack-pmnbt4096-plongthr2048-topkv3-a8cfg-3600
S_LB=1
S_KV_W=14
S_GEMM=1
S_FP4=1
S_TOPK=1
S_TOPK_IMPL=triton
S_D_ARGS="--max-num-batched-tokens 2048"
S_D_ENV="VPD_DP_LB_KV_CAP_TOKENS=3141120"
S_P_ARGS="--max-num-batched-tokens 4096 --long-prefill-token-threshold 2048"
S_DFP8=1
S_IDXFP4=1
S_THPOFF=1
S_KVOFF=1
S_FP4PACK=1
