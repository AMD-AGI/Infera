# a23 side B: gate only, Triton top-k v3 on all layers + shadow check (VPD_TOPK_SHADOW=1): every decode top-k call also
# runs vLLM's exact in-tree top-k and aiter's on the production logits; counters per target / draft scope go to the decode
# log ("[vpd-topk-shadow]"). Answers whether the real-acceptance drop (a21: target path) comes from non-exact rows or
# only from a different choice among tied elements. Decode memory 0.92 leaves room for the comparison's temporaries.
S_TAG=a23B-gate-shadow
S_LB=1
S_KV_W=14
S_GEMM=1
S_FP4=1
S_TOPK=1
S_TOPK_IMPL=triton
S_GATE=1
S_SCORE=0
S_D_ARGS="--max-num-batched-tokens 2048 --gpu-memory-utilization 0.92"
S_D_ENV="VPD_DP_LB_KV_CAP_TOKENS=3141120 VPD_TOPK_SHADOW=1 VPD_TOPK_SHADOW_EVERY=15"
