# N0: positive control for part 2 (DECODE-mode graphs): no speculative decoding on either leg, stock kernels (KF off), E11 collectives, no fix.
. "$PKG/config/site.local.env"
. "$PKG/config/recipe-e10.env"
export KIT_NO_SPEC=1
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA YIHOU_KF_SPARSE=0 YIHOU_KF_INDEXER=0 YIHOU_KF_MOE=0 SGLANG_USE_ROCM700A=0"
