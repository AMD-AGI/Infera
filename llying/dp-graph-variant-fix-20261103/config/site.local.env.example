# Copy to config/site.local.env and fill in. Every cluster-specific value of the verification lives here; a value already
# in the environment wins (scripts/slurm_verify.sbatch sets the node values for the allocated pair).
#
# Prefill node: runs etcd, the router, the prefill, the clients and the scripts. Decode node: reached with
# `ssh $DECODE_SSH` (passwordless, docker without sudo; on a Slurm cluster without that, tools/sshshim/ssh).
export PREFILL_NODE_IP="${PREFILL_NODE_IP:-<prefill node IP>}"
export DECODE_NODE_IP="${DECODE_NODE_IP:-<decode node IP>}"
export DECODE_SSH="${DECODE_SSH:-<decode node ssh name>}"
# GPUs used on each node (the 51k measurements used 4-7 on both).
export PREFILL0_GPUS="${PREFILL0_GPUS:-4,5,6,7}"
export DECODE_GPUS="${DECODE_GPUS:-4,5,6,7}"
# GLM-5.2-MXFP4 weights, same path on both nodes.
export MODEL="${MODEL:-/shared_nfs/huggingface_models/amd/GLM-5.2-MXFP4}"
# The image every patch here was cut against: Infera fdbafb60, deploy/docker/Dockerfile.sglang (REPRODUCE step 1), on both
# nodes. run_verify.sh checks the 11 base files against patches/BASE_MD5SUMS before anything starts.
export IMAGE="${IMAGE:-infera-sglang:v0522-fdbafb60}"
# scripts/slurm_image.sbatch: the Infera clone to build from (needs commit fdbafb60), and where the image tar is kept
# (loaded on a node that lacks the image; written after a build).
export INFERA_REPO="${INFERA_REPO:-<path to an AMD-AGI/Infera clone>}"
export IMAGE_TAR="${IMAGE_TAR:-<shared path>/infera-sglang-v0522-fdbafb60.tar}"
# Prefill-node scratch (runs/, cache/: InferenceX checkout for lm-eval, AgentX client cache).
export WORK_DIR="${WORK_DIR:-<prefill-node scratch dir>}"
# Where run_verify.sh writes its logs (readable from wherever you check progress).
export LOG_ROOT="${LOG_ROOT:-<log dir>}"
# KV transfer rails and RoCEv2 GID index. MOONCAKE_DISABLE_HIP_DMABUF: 0 on crusoe m2m; 1 on AUS smci355 (0 segfaults there).
export RDMA_DEVICES="${RDMA_DEVICES:-ionic_0,ionic_1,ionic_2,ionic_3,ionic_4,ionic_5,ionic_6,ionic_7}"
export MC_GID_INDEX="${MC_GID_INDEX:-1}"
export MOONCAKE_DISABLE_HIP_DMABUF="${MOONCAKE_DISABLE_HIP_DMABUF:-0}"
# A deployment starts only once the used GPUs are below this VRAM share (%) on both nodes; after a HiCache tear-down the
# driver frees the VRAM 10-40 minutes later. Raise it only if idle GPUs of the cluster sit above 1 % with nothing running.
export VRAM_IDLE_PCT="${VRAM_IDLE_PCT:-1}"
