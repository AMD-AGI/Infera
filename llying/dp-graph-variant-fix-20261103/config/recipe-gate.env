# The capped-pool gate of E10: prefill device KV pool 300K tokens per PP rank and 64K eviction headroom, so the two
# identical 16k x 128 long-context passes keep evicting through the write_back copy and the second pass loads those
# copies back. Same as ../../prefill-opt-20261027/config/site-llr35-v3-evict-bq16-gate.env. This is the condition in
# which the bad start showed in 6 of 8 controls (3-8 of 200) on crusoe 138 -> 140.
EVICT_HEADROOM=${EVICT_HEADROOM:-65536}
. "$PKG/config/recipe-e10.env"
export PREFILL_EXTRA_ARGS="$PREFILL_EXTRA_ARGS --max-total-tokens 300000"
