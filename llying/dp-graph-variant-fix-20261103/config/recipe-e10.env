# The E10 recipe (GLM-5.2 AgentX PD 4+4, 51,374 tok/s/GPU at C104 on crusoe 138 -> 140, 11-03): yihou's llr35 stack
# (prefill TP1 x PP4 with async depth 1 and PP comm overlap, HiCache write_back 250 GB/rank; decode TP4 / DP4 attention
# with KF kernels, FP8 draft MoE, tuned GEMM rows, custom all-reduce; EAGLE 3/1/4) plus three prefill patches:
# v3 pp-chunk-wait, E1 evict-headroom (512K), E10 hicache-backup-quota (16). Values match
# ../../prefill-opt-20261027/config/site-llr35-v3-evict512k-bq16.env with the site values moved to site.local.env.
# Needs PKG (the directory above config/), set by the scripts.
K=$PKG/kit
SRT=/sgl-workspace/sglang/python/sglang/srt
export SERVED_MODEL=glm5.2-mxfp4 PREFILL_WORKERS=1 PREFILL1_GPUS="$PREFILL0_GPUS" PP4_CHUNK=8192 CTR=glm52_2p1d
export SIM_ACCEPT_LEN=2.99
export PREFILL_EXTRA_ARGS='--json-model-override-args {"index_share_for_mtp_iteration":true} --pp-async-batch-depth 1 --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4'
export DECODE_EXTRA_ARGS='--json-model-override-args {"index_share_for_mtp_iteration":true} --mem-fraction-static 0.95 --stream-interval 30 --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4'
export ROUTER_EXTRA_ARGS=
export CONC=104 DURATION=3600 WARMUP_PER_LANE=10
export DECODE_MOUNT_EXTRA="$K/overlay:/yihou_overlay:ro $K/aiter_csv/yihou_glm52_dpa_bf16_tuned_gemm.csv:/sgl-workspace/aiter/aiter/configs/model_configs/yihou_glm52_dpa_bf16_tuned_gemm.csv:ro $K/aiter_csv/yihou_glm52_ptpc_bf16_tuned_gemm.csv:/sgl-workspace/aiter/aiter/configs/model_configs/yihou_glm52_ptpc_bf16_tuned_gemm.csv:ro"
export DECODE_ENV_EXTRA="PYTHONPATH=/yihou_overlay YIHOU_KF_SPARSE=1 YIHOU_KF_INDEXER=1 YIHOU_KF_MOE=1 SGLANG_OPT_USE_TOPK_V2=false SGLANG_CLIP_MAX_NEW_TOKENS_ESTIMATION=8 SGLANG_GLM_NEXTN_MOE_PTPC=1"
export DECODE_CUSTOM_AR=1
export PREFILL_MOUNT_EXTRA="$K/patches/pp-chunk-wait/prefill.py:$SRT/disaggregation/prefill.py:ro $K/patches/evict-headroom/unified_radix_cache.py:$SRT/mem_cache/unified_radix_cache.py:ro $K/patches/hicache-backup-quota/mla.py:$SRT/mem_cache/pool_host/mla.py:ro $K/patches/hicache-backup-quota/dsa.py:$SRT/mem_cache/pool_host/dsa.py:ro"
export PREFILL_ENV_EXTRA="SGLANG_PP_COMM_OVERLAP=1 SGLANG_EVICT_HEADROOM_TOKENS=${EVICT_HEADROOM:-524288} SGLANG_HICACHE_BACKUP_BLOCK_QUOTA=${BACKUP_BLOCK_QUOTA:-16}"
unset K SRT
