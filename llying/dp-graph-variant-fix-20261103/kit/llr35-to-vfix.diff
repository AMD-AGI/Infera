diff -ru llr35/engine/common.sh llr35-vfix/engine/common.sh
--- llr35/engine/common.sh	2026-10-27 09:56:41.520833906 +0000
+++ llr35-vfix/engine/common.sh	2026-11-03 08:44:00.095546718 +0000
@@ -21,12 +21,13 @@
 # The env.sh settings of a deployment (not the benchmark ones): recorded per
 # run, and forwarded to the decode node.
 PREFILL_MOUNT_EXTRA="${PREFILL_MOUNT_EXTRA:-}"
+KIT_NO_SPEC="${KIT_NO_SPEC:-0}"
 KIT_VARS=(PREFILL_NODE_IP DECODE_NODE_IP DECODE_SSH MODEL SERVED_MODEL IMAGE WORK_DIR
     RDMA_DEVICES MC_GID_INDEX MOONCAKE_DISABLE_HIP_DMABUF PREFILL_WORKERS PREFILL0_GPUS PREFILL1_GPUS DECODE_GPUS
     SIM_ACCEPT_LEN PREFILL_EXTRA_ARGS DECODE_EXTRA_ARGS ROUTER_EXTRA_ARGS
     ETCD_PORT ETCD_PEER_PORT ROUTER_PORT PREFILL_PORT DECODE_PORT BOOTSTRAP_PORT
     KV_EVENTS_PORT KV_SNAPSHOT_PORT ETCD_IMAGE CTR
-    DECODE_ENV_EXTRA DECODE_MOUNT_EXTRA DECODE_CUSTOM_AR PREFILL_ENV_EXTRA PREFILL_MOUNT_EXTRA)   # yihou llrepro: decode-only hooks (KF kernels) + prefill env hook
+    DECODE_ENV_EXTRA DECODE_MOUNT_EXTRA DECODE_CUSTOM_AR PREFILL_ENV_EXTRA PREFILL_MOUNT_EXTRA KIT_NO_SPEC)   # yihou llrepro: decode-only hooks (KF kernels) + prefill env hook
 
 INFERENCEX_REPO="${INFERENCEX_REPO:-https://github.com/SemiAnalysisAI/InferenceX.git}"
 INFERENCEX_REF="${INFERENCEX_REF:-918524ff94045b3f091115f1051c22a8588edf2b}"
diff -ru llr35/engine/worker.sh llr35-vfix/engine/worker.sh
--- llr35/engine/worker.sh	2026-10-27 09:38:35.560609707 +0000
+++ llr35-vfix/engine/worker.sh	2026-11-03 08:43:49.748068440 +0000
@@ -115,6 +115,16 @@
     read -ra extra <<<"$DECODE_EXTRA_ARGS"
 fi
 args+=("${extra[@]}")
+# KIT_NO_SPEC=1: both legs without speculative decoding (every --speculative-* flag and its value dropped).
+if [[ "${KIT_NO_SPEC:-0}" == 1 ]]; then
+    _a=() _skip=0
+    for x in "${args[@]}"; do
+        if [[ $_skip == 1 ]]; then _skip=0; continue; fi
+        if [[ "$x" == --speculative-* ]]; then _skip=1; continue; fi
+        _a+=("$x")
+    done
+    args=("${_a[@]}")
+fi
 # yihou llrepro: DECODE_CUSTOM_AR=1 removes --disable-custom-all-reduce on the decode (custom all-reduce on).
 if [[ "$role" == decode && "${DECODE_CUSTOM_AR:-0}" == 1 ]]; then
     _a=(); for x in "${args[@]}"; do [[ "$x" == --disable-custom-all-reduce ]] || _a+=("$x"); done; args=("${_a[@]}")
