# E11 WITHOUT capture copy-in, decode graphs pinned to the DSA sparse variant on every rank (patches/dsa-force-sparse).
# The image captures a dense (max_kv_len <= 2048) and a sparse decode graph per size and each DP rank picks one from its own
# batch (idle ranks: sparse), so ranks can replay different graphs in one step. Tests whether that mismatch is what makes
# the registered-input aiter collectives read stale peer data.
. /home/liyingli/bench_agentx/baseline/Infera/llying/car-copyin-141-20261103/config/site-141-e11.env
GV=/sgl-workspace/sglang/python/sglang/srt/layers/attention/graph_variants.py
export DECODE_MOUNT_EXTRA="$DECODE_MOUNT_EXTRA /home/liyingli/bench_agentx/baseline/Infera/llying/car-copyin-141-20261103/patches/dsa-force-sparse/graph_variants.py:$GV:ro"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA SGLANG_DSA_GRAPH_FORCE_SPARSE=1"
unset GV
