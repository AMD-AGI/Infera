# Control + decode aiter custom all-reduce capture copy-in: under CUDA-graph capture the all-reduce input is copied into the
# pre-registered IPC buffer instead of registering the graph-pool tensor (enable_register_for_capturing=False).
# The patched file's base is byte-identical to the image's custom_all_reduce.py (md5 03643d4f...).
. /home/liyingli/bench_agentx/baseline/Infera/llying/car-copyin-141-20261103/config/site-141-ctl.env
CA=/sgl-workspace/sglang/python/sglang/srt/distributed/device_communicators/custom_all_reduce.py
export DECODE_MOUNT_EXTRA="$DECODE_MOUNT_EXTRA /home/liyingli/bench_agentx/baseline/Infera/llying/prefill-car-20261023/patches/custom_all_reduce.py:$CA:ro"
export DECODE_ENV_EXTRA="$DECODE_ENV_EXTRA SGLANG_AITER_AR_CAPTURE_COPY_IN=1"
unset CA
