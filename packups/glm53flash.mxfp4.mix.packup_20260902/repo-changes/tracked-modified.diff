--- a/deploy/docker/Dockerfile.sglang
+++ b/deploy/docker/Dockerfile.sglang
@@ -3,10 +3,24 @@
 # the command.
 #
 # ⚠️ The base tag is PINNED and must stay pinned: the GLM-5.2 DSA patches near
