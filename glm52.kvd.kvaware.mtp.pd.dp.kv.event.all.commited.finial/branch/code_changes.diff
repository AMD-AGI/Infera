+        {
+            "findmnt": "/dev/sda1[/some/where] ext4\n",
+            "lsblk": "sda sata 0\n",
+        }
+    )
+    info = classify_storage(Path("/some/where"))
+    assert info.mount_source == "/dev/sda1"
+    assert info.devices, "bind-mounted device should still be resolved"
