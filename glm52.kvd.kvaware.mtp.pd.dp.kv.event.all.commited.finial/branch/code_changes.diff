index e64f696..e13f6f2 100644
--- a/deploy/docker/Dockerfile.sglang
+++ b/deploy/docker/Dockerfile.sglang
@@ -1,6 +1,11 @@
 # Infera SGLang engine image: layers the infera source onto the ROCm SGLang
 # base and sets an entrypoint that injects the host's libionic before exec'ing
 # the command.
+#
+# ⚠️ The base tag is PINNED and must stay pinned: the GLM-5.2 DSA patches near
+# the end of this file are context diffs applied at --fuzz=0 against this exact
+# sglang commit. Bumping the base fails the build there rather than silently
+# mis-applying. Build with APPLY_SGLANG_DSA_PATCHES=0 if you need a newer base.
 ARG SGLANG_BASE_IMAGE=lmsysorg/sglang:v0.5.15.post1-rocm720-mi35x
 FROM ${SGLANG_BASE_IMAGE}
 
@@ -52,6 +57,73 @@ COPY deploy/docker/patches/sglang/ /tmp/sglang-patches/
 RUN for f in /tmp/sglang-patches/*.py; do echo "[sglang-patch] $f"; python "$f" || echo "[sglang-patch] skipped $f"; done \
     && rm -rf /tmp/sglang-patches
 
+# ---- sglang PD patches (mooncake early-send KV wait event) ------------------
+# REQUIRED FOR CORRECTNESS on any PD deployment doing chunked prefill over
+# mooncake: without it every chunk but the last is RDMA-read while the forward is
+# still writing those pages, so prompts longer than one chunk come back partially
+# wrong with nothing in any log. Self-locating and idempotent like the loop
+# above, and reports "already present" once the base sglang carries the fix.
+# NOT tolerant, unlike that loop: a script here exits non-zero only when its
+# anchors drifted, i.e. when the fix did NOT go in -- and an engine image that
+# silently corrupts long prompts is worse than a failed build.
+#
+# Placed before the DSA layer to match the order the merge experiment validated;
+# the two touch disjoint sglang files, so the order is not load-bearing.
+COPY deploy/docker/patches/sglang_disagg/ /tmp/sglang-disagg-patches/
+RUN set -eu; \
+    for f in /tmp/sglang-disagg-patches/*.py; do echo "[sglang-patch] $f"; python "$f"; done; \
+    rm -rf /tmp/sglang-disagg-patches
+
+# ---- GLM-5.2 DSA patch set (PD + DP-attention + EAGLE MTP on gfx950) --------
+# Three patches that together make PD disaggregation + DP-attention + EAGLE MTP
+# work for GLM-5.2. Without them the combination crashes on the first batch or
+# deadlocks the whole DP group under concurrency:
+#
+#   dsa_indexer_hip_dp_padded_rows      the HIP/aiter paged-MQA path sizes its
+#                                       output from DP-PADDED rows while
+#                                       `lengths` is sized to REAL rows ->
+#                                       "Expected lengths.size(0) == B". Shaped
+#                                       after upstream PR #32762 (same bug class,
+#                                       NPU): one boolean gates both trim and
+#                                       restore, and the post-kernel row count is
+#                                       ASSERTED before padding is re-attached.
+#   dsa_backend_dp_sync_and_page_table  (a) `seq_lens.max().item()` is a host sync
+#                                       on a branch only SOME DP ranks take,
+#                                       desynchronizing DP collectives; (b)
+#                                       page_table_1 has one row per REQUEST while
+#                                       topk_indices has one per TOKEN under MTP
+#                                       -> assert on unequal rows.
+#   draft_cuda_graph_dp_vote            the draft-graph/eager choice in
+#                                       EagleDraftWorker.draft() is made PER RANK
+#                                       from rank-dependent inputs and diverges on
+#                                       the PD decode leg, where the DSA top-k seed
+#                                       arrives by RDMA. Graph replay and the eager
+#                                       loop do not issue the same collectives ->
+#                                       deadlock. Shaped after upstream PR #32209:
+#                                       the vote rides the MLP-sync all-gather the
+#                                       scheduler ALREADY performs, adding zero
+#                                       extra collectives.
+#
+# The nextn eh_proj fix is NOT here -- the patch loop above already applies it;
+# the script asserts it as a prerequisite.
+#
+# Unlike the loop above these are context diffs applied at --fuzz=0 against the
+# pinned base (sglang 0b3bb0cbe31873994c9f989fddfe2f87ca839fdd, release/v0.5.15).
+# Bumping SGLANG_BASE_IMAGE will FAIL the build here rather than silently
+# mis-apply -- intended, not a defect. The script also verifies each patch reached
+# the BYTECODE, not just the source: a stale __pycache__ entry silently reverts a
+# patch and has already invalidated a full experiment. Set
+# APPLY_SGLANG_DSA_PATCHES=0 for a stock engine (e.g. to A/B the patches).
+ARG APPLY_SGLANG_DSA_PATCHES=1
+COPY deploy/docker/patches/sglang_dsa/ /tmp/sglang_dsa/
+COPY deploy/docker/scripts/apply_sglang_dsa_patches.sh /tmp/apply_sglang_dsa_patches.sh
+RUN if [ "${APPLY_SGLANG_DSA_PATCHES}" = "1" ]; then \
+        PATCH_DIR=/tmp/sglang_dsa bash /tmp/apply_sglang_dsa_patches.sh; \
+    else \
+        echo "APPLY_SGLANG_DSA_PATCHES=0 — stock sglang, GLM-5.2 PD+DPA+MTP will NOT work"; \
+    fi \
+    && rm -rf /tmp/apply_sglang_dsa_patches.sh /tmp/sglang_dsa
+
 # ---- Rust router (multi-core data plane; --router-backend rust) ----
 # The ROCm base ships cargo; use it (install a minimal toolchain only if
 # absent). Needs cc for linking and libclang (onig_sys/bindgen). Removes
