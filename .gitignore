*.py[cod]
*.so
.eggs/
*.egg-info/
# setuptools-scm generated
infera/_version.py

# Build / packaging
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtualenv / env
.venv/
.env

# Editors / OS
.idea/
.vscode/
*.swp
