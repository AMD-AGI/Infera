# Python
__pycache__/
*.py[cod]
*.so
.eggs/
*.egg-info/
# setuptools-scm generated
infera/_version.py

# Build / packaging
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtualenv / env
.venv/
.env

# Editors / OS
.idea/
.vscode/
*.swp
*.log
.DS_Store

# uv-managed lockfile; regenerate via `uv sync` rather than commit.
uv.lock

# Preflight generated reports / JSON
output/
preflight_result/

# Bench artifacts — keep code, exclude generated CSV/PNG/MD/JSON results
bench/**/results/*.csv
bench/**/results/*.png
bench/**/results/*.svg
bench/**/results/*.md
bench/**/results/*.json
bench/kv_cache_cliff/results/

# Vendored third-party sources (UCX / RIXL) — too large, fetch/build on demand
deploy/docker/third_party/

# Local scratch — not for review.
.review-drafts/
temp/
CLAUDE.md
# A task definition handed to an agent session: local input, never a deliverable.
mission.md
# ...except the shared repo conventions, which are meant for review and for
# everyone's agent sessions. Excluding `.claude/*` rather than `.claude/` is what
# makes the negation possible — git will not descend into an excluded directory,
# so a re-include under `.claude/` would never be reached. Everything else stays
# out: settings.local.json is per-developer, and worktrees/ holds whole nested
# checkouts.
.claude/*
!.claude/CLAUDE.md
.spur_job_*.sh
.spur_ns_*.sh
spur-*.out

# --- Experiment scratch: raw traces and compiler caches (yihou) ---
# These are produced by benchmark runs inside the container and must never be
# committed: they are either regenerable build artefacts or bulk per-iteration
# traces.
#
# CORRECTION (2026-09-15): an earlier revision of this comment claimed these were
# "moved out of the repo to ../glm52_internal_bench_rawdata_yihou_20260915/
# (nothing was deleted)". That directory does not exist and never did -- searched
# /home/yihou, /var/tmp and the parent directory. The files matching these patterns
# were removed from the working tree by commit be73937f, not relocated.
# They are not lost: they were committed before that removal, so every one of them
# is recoverable with `git show be73937f^:<path>` or `git checkout be73937f^ -- <path>`.
# Do not go looking for a backup directory; use git history.
cache/jit-*/
cache/torch/
cache/triton/
cache/flashinfer/
**/steps*.jsonl
**/wave_*steps*.jsonl
**/benchmark.jsonl
**/console.log
**/bench_snapshot/

# --- Agent scratch workspaces (yihou) ---
# Per-experiment working directories: iterations, logs, raw traces, scratch notes.
# They hold NO code — the shared harness lives in
# sglang_decode_internal_bench_and_profiling/ and published results live in packups/.
# Kept on disk for reference, deliberately out of the repo: they are ~390 MB of
# regenerable artefacts and committing them would grow git history permanently.
temp_workspace/

# Serena (LSP agent) per-project cache — tool state, not a deliverable.
.serena/
