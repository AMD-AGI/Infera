# Bench artifacts — keep code, exclude generated CSV/PNG/MD/JSON results
bench/**/results/*.csv
bench/**/results/*.png
bench/**/results/*.svg
bench/**/results/*.md
bench/**/results/*.json
bench/kv_cache_cliff/results/

# Vendored third-party sources (UCX / RIXL) — too large, fetch/build on demand
deploy/docker/third_party/

# Local scratch — not for review.
.review-drafts/
temp/
CLAUDE.md
# ...except the shared repo conventions, which are meant for review and for
# everyone's agent sessions. Excluding `.claude/*` rather than `.claude/` is what
# makes the negation possible — git will not descend into an excluded directory,
# so a re-include under `.claude/` would never be reached. Everything else stays
# out: settings.local.json is per-developer, and worktrees/ holds whole nested
# checkouts.
.claude/*
!.claude/CLAUDE.md
.spur_job_*.sh
.spur_ns_*.sh
spur-*.out

# Generated by rust/router/tests/data/gen_kimi_k3_golden.py: encoder output, not
# source. Reproducible in seconds next to the engine that defines it.
rust/router/tests/data/kimi_k3_golden.json
