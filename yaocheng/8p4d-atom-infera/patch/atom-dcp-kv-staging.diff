+    def _execute_staged_kv(
+        self,
+        target: str,
+        regions: list[tuple[int, int]],
+        plan,
+        dst_block_ids: list[int],
+        req_id: str,
+        kv_cache_ready_event: torch.cuda.Event | None,
+        *,
+        engine=None,
+    ) -> bool:
+        """GPU-gather each latent MLA layer's DCP share, then RDMA whole pages."""
+        chunk_pages = self._KV_STAGING_TOKENS // self.block_size
+        dst_ids = np.asarray(dst_block_ids, dtype=np.int64)
+        for start in range(0, len(dst_ids), chunk_pages):
+            chunk = plan.slice_pages(start, min(start + chunk_pages, len(dst_ids)))
+            keep = chunk.valid
+            src_tok = (
+                chunk.src_block_id_per_run[keep] * self.block_size + chunk.src_token[keep]
+            )
+            dst_tok = (
+                dst_ids[start + chunk.dst_page[keep]] * self.block_size
+                + chunk.dst_token[keep]
+            )
+            rows = len(src_tok)
+            if rows == 0:
+                continue
+            for first in range(0, len(regions), self._KV_STAGING_LAYERS):
+                slot = self._kv_staging_slots.get()
+                stream = self._kv_staging_streams[slot]
+                try:
+                    with torch.cuda.stream(stream):
+                        if kv_cache_ready_event is not None:
+                            stream.wait_event(kv_cache_ready_event)
+                        src_index = torch.from_numpy(src_tok).to(self._cuda_device)
+                    src_addrs: list[int] = []
+                    dst_addrs: list[int] = []
+                    sizes: list[int] = []
+                    offset = 0
+                    for region_idx, dst_base in regions[
+                        first : first + self._KV_STAGING_LAYERS
+                    ]:
+                        view = self._kv_token_views[region_idx]
+                        unit = view.shape[1]
+                        staged = self._kv_staging[
+                            slot, offset : offset + rows * unit
+                        ].view(rows, unit)
+                        with torch.cuda.stream(stream):
+                            torch.index_select(view, 0, src_index, out=staged)
+                        src, dst, length = coalesce_contiguous(
+                            staged.data_ptr() + np.arange(rows, dtype=np.int64) * unit,
+                            dst_base + dst_tok * unit,
+                            np.full(rows, unit, dtype=np.int64),
+                        )
+                        src_addrs += src.tolist()
+                        dst_addrs += dst.tolist()
+                        sizes += length.tolist()
+                        offset += rows * unit
+                    stream.synchronize()
+                    if not self._rdma_write_with_retry(
+                        target, src_addrs, dst_addrs, sizes, req_id, "staged-kv",
+                        engine=engine,
+                    ):
+                        logger.error(
+                            "[PRODUCER] staged KV transfer failed for req %s", req_id
+                        )
+                        return False
+                finally:
+                    self._kv_staging_slots.put(slot)
+        return True
