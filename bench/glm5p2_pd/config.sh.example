#!/usr/bin/env bash
# Copy to config.sh. Every value can be overridden as VAR=value on a command.

# Shared paths and service identity.
ROCM_LLM_BENCH_DIR="${ROCM_LLM_BENCH_DIR:/home/liyingli/bench_agentx/rocm-llm-bench}"
ROCM_OPT_BASE_IMAGE="${ROCM_OPT_BASE_IMAGE:-rocm-llm-bench:glm52-v518-402df1e-2c71811}"
IMAGE="${IMAGE:-infera/engine-sglang:glm52-v518-402df1e-2c71811}"
MODEL="${MODEL:-/shared_nfs/huggingface_models/amd/GLM-5.2-MXFP4}"
SERVED_MODEL="${SERVED_MODEL:-glm5.2-mxfp4}"
CONTROL_NODE="${CONTROL_NODE:-worker-01}"
INFERENCEX_DIR="${INFERENCEX_DIR:-$ROCM_LLM_BENCH_DIR/third_party/InferenceX}"
REMOTE_BENCH_DIR="${REMOTE_BENCH_DIR:-}"
SSH_OPTS="${SSH_OPTS:--o BatchMode=yes -o ConnectTimeout=10}"

# Hardware and container names.
NODE_GPU_COUNT="${NODE_GPU_COUNT:-8}"
PREFILL_GPU_DEVICES="${PREFILL_GPU_DEVICES:-0,1,2,3,4,5,6,7}"
DECODE_GPU_DEVICES="${DECODE_GPU_DEVICES:-0,1,2,3,4,5,6,7}"
CONTAINER_PREFIX="${CONTAINER_PREFIX:-glm52-pd}"
GPU_IDLE_VRAM_PCT="${GPU_IDLE_VRAM_PCT:-2}"
GPU_IDLE_TIMEOUT="${GPU_IDLE_TIMEOUT:-3600}"
CONTAINER_STOP_TIMEOUT="${CONTAINER_STOP_TIMEOUT:-300}"

# Ports. A worker's row number is added to each worker port base.
ETCD_PORT="${ETCD_PORT:-2379}"
ETCD_PEER_PORT="${ETCD_PEER_PORT:-2380}"
ROUTER_PORT="${ROUTER_PORT:-8000}"
ENGINE_PORT_BASE="${ENGINE_PORT_BASE:-29001}"
BOOTSTRAP_PORT_BASE="${BOOTSTRAP_PORT_BASE:-8998}"
KV_EVENT_PORT_BASE="${KV_EVENT_PORT_BASE:-5557}"
SNAPSHOT_PORT_BASE="${SNAPSHOT_PORT_BASE:-8801}"
INFERA_NODEPORT_RANGE="${INFERA_NODEPORT_RANGE:-30000-32767}"

# Prefill worker settings.
PREFILL_TP="${PREFILL_TP:-8}"
PREFILL_EP="${PREFILL_EP:-1}"
PREFILL_DP="${PREFILL_DP:-1}"
PREFILL_DPA="${PREFILL_DPA:-0}"
PREFILL_CHUNK_SIZE="${PREFILL_CHUNK_SIZE:-32768}"
PREFILL_MAX_RUNNING="${PREFILL_MAX_RUNNING:-32}"
PREFILL_GRAPH_MAX_BS="${PREFILL_GRAPH_MAX_BS:-32}"
PREFILL_MEM_FRACTION="${PREFILL_MEM_FRACTION:-0.85}"
PREFILL_HICACHE="${PREFILL_HICACHE:-1}"
PREFILL_HICACHE_RATIO="${PREFILL_HICACHE_RATIO:-1.5}"
PREFILL_HICACHE_WRITE_POLICY="${PREFILL_HICACHE_WRITE_POLICY:-write_through}"
PREFILL_HICACHE_IO_BACKEND="${PREFILL_HICACHE_IO_BACKEND:-kernel}"
PREFILL_HICACHE_MEM_LAYOUT="${PREFILL_HICACHE_MEM_LAYOUT:-page_first}"

# Decode worker settings.
DECODE_TP="${DECODE_TP:-8}"
DECODE_EP="${DECODE_EP:-1}"
DECODE_DP="${DECODE_DP:-1}"
DECODE_DPA="${DECODE_DPA:-0}"
DECODE_CHUNK_SIZE="${DECODE_CHUNK_SIZE:-32768}"
DECODE_MAX_RUNNING="${DECODE_MAX_RUNNING:-32}"
DECODE_GRAPH_MAX_BS="${DECODE_GRAPH_MAX_BS:-32}"
DECODE_MEM_FRACTION="${DECODE_MEM_FRACTION:-0.85}"
DECODE_HICACHE="${DECODE_HICACHE:-0}"
DECODE_HICACHE_RATIO="${DECODE_HICACHE_RATIO:-1.5}"
DECODE_HICACHE_WRITE_POLICY="${DECODE_HICACHE_WRITE_POLICY:-write_through}"
DECODE_HICACHE_IO_BACKEND="${DECODE_HICACHE_IO_BACKEND:-kernel}"
DECODE_HICACHE_MEM_LAYOUT="${DECODE_HICACHE_MEM_LAYOUT:-page_first}"
DECODE_MTP="${DECODE_MTP:-1}"
DECODE_SPEC_STEPS="${DECODE_SPEC_STEPS:-5}"
DECODE_SPEC_DRAFT_TOKENS="${DECODE_SPEC_DRAFT_TOKENS:-6}"
DECODE_SPEC_TOPK="${DECODE_SPEC_TOPK:-1}"
# Empty disables simulated acceptance for correctness/final measurements.
DECODE_SIMULATE_ACC_LEN="${DECODE_SIMULATE_ACC_LEN-3.61}"
# Required by GLM-5.2 MTP with DP attention; empty keeps the model default.
JSON_MODEL_OVERRIDE_ARGS="${JSON_MODEL_OVERRIDE_ARGS:-}"

# KV transfer and router settings.
RDMA_DEVICE="${RDMA_DEVICE:-ionic_0,ionic_1,ionic_2,ionic_3,ionic_4,ionic_5,ionic_6,ionic_7}"
MC_GID_INDEX="${MC_GID_INDEX:-1}"
MC_TE_FILTERS="${MC_TE_FILTERS:-$RDMA_DEVICE}"
MC_ENABLE_DEST_DEVICE_AFFINITY="${MC_ENABLE_DEST_DEVICE_AFFINITY:-1}"
MOONCAKE_DISABLE_HIP_DMABUF="${MOONCAKE_DISABLE_HIP_DMABUF:-0}"
RDMAV_FORK_SAFE="${RDMAV_FORK_SAFE:-1}"
KV_P2P_TRANSFER="${KV_P2P_TRANSFER:-mooncake}"
ENABLE_KV_AWARE="${ENABLE_KV_AWARE:-1}"
KV_PREFILL_OVERLAP_WEIGHT="${KV_PREFILL_OVERLAP_WEIGHT:-20.0}"
KV_DECODE_OVERLAP_WEIGHT="${KV_DECODE_OVERLAP_WEIGHT:-2.0}"
HOST_RDMA_LIB="${HOST_RDMA_LIB:-/lib/x86_64-linux-gnu/libionic.so}"
HOST_RDMA_MOUNT="${HOST_RDMA_MOUNT:-/host-libionic/libionic.so}"

# Image build and runtime timeouts.
BUILD_CONTEXT="${BUILD_CONTEXT:-/path/to/bench_agentx/Infera}"
BUILD_DOCKERFILE="${BUILD_DOCKERFILE:-$BUILD_CONTEXT/deploy/docker/Dockerfile.sglang}"
BUILDER_NODE="${BUILDER_NODE:-$CONTROL_NODE}"
BUILD_NETWORK="${BUILD_NETWORK:-host}"
BUILD_NO_CACHE="${BUILD_NO_CACHE:-0}"
APPLY_SGLANG_PD_ROCM_REJECTION_PATCH="${APPLY_SGLANG_PD_ROCM_REJECTION_PATCH:-1}"
READY_TIMEOUT="${READY_TIMEOUT:-3600}"
ROUTER_READY_TIMEOUT="${ROUTER_READY_TIMEOUT:-300}"
HEALTH_INTERVAL="${HEALTH_INTERVAL:-10}"
PREFLIGHT_TIMEOUT="${PREFLIGHT_TIMEOUT:-1800}"
SGLANG_TIMEOUT_KEEP_ALIVE="${SGLANG_TIMEOUT_KEEP_ALIVE:-900}"

# Benchmark defaults. Deployment facts are detected from the running service.
AGENTX_DURATION="${AGENTX_DURATION:-3600}"
AGENTX_FAILED_REQUEST_THRESHOLD="${AGENTX_FAILED_REQUEST_THRESHOLD:-0.10}"
EVAL_CONCURRENCY="${EVAL_CONCURRENCY:-64}"
EVAL_LIMIT="${EVAL_LIMIT:-}"
TOTAL_CPU_DRAM_GB="${TOTAL_CPU_DRAM_GB:-}"
LOG_DIR="${LOG_DIR:-}"
