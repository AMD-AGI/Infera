> # YIHOU (task v0521cap Track B, user rule 2026-10-12): admit a prealloc request onto a decode DP rank only if
> #   (candidate tokens + KV already held on the rank) - KV held by running requests  <  (1 - SHARE) * pool
> # i.e. all non-running KV (in-flight transfers, arrived-not-yet-batched, deferred releases, page slack) plus the new
> # request stays below (1 - SHARE) of the pool, so running requests always have >= SHARE of the pool to grow into.
> # SHARE = YIHOU_DECODE_RUNNING_KV_SHARE (0 / unset = off = stock behaviour; 0.5 = the user's 50 % rule).
> _YIHOU_RUN_SHARE = float(os.environ.get("YIHOU_DECODE_RUNNING_KV_SHARE", "0") or 0)
> # v2 (pc40c showed a likely regression from FIFO head-of-line blocking behind ~0.7 M-token prompts): a request that does
> # not fit under the cap is SKIPPED (smaller ones behind it may still enter) instead of stopping the scan, unless the
> # oldest blocked request has waited longer than YIHOU_RUNSHARE_MAX_WAIT_S; then admission stops (stock FIFO break) so the
> # big request enters as soon as in-flight KV drains (anti-starvation).
> _YIHOU_RUNSHARE_MAX_WAIT_S = float(os.environ.get("YIHOU_RUNSHARE_MAX_WAIT_S", "5") or 5)
