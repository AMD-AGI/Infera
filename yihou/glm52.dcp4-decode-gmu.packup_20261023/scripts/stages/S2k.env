# gmu S2k: S2e (0.88) with memlog-ec overlay: empty_cache() at the Decode-batch log point when device free < 6 GiB
# Source on the node before the kit scripts:  NK=<node key> NODE_IP=<data ip> source S2.env
: "${NK:?set NK (node key, e.g. 105)}"; : "${NODE_IP:?set NODE_IP (node data IP)}"
export PREFILL_NODE_IP=$NODE_IP DECODE_NODE_IP=$NODE_IP DECODE_SSH=local
export MODEL=/shared_nfs/huggingface_models/amd/GLM-5.2-MXFP4 SERVED_MODEL=glm5.2-mxfp4
export IMAGE=${IMAGE:-infera-sglang:v0522-d395c3b3-1020-mc4340}
export WORK_DIR=/shared_nfs/yihou_glm52/llying_dcp_20261022/work/S2k-$NK
export PREFILL_WORKERS=1 PREFILL0_GPUS=0,1,2,3 DECODE_GPUS=4,5,6,7 PP4_CHUNK=8192 PP4_HICACHE=${PP4_HICACHE:-1}
export SIM_ACCEPT_LEN=${SIM_ACCEPT_LEN-3.61}
export CONC=80 DURATION=1800 WARMUP_PER_LANE=10
export CTR=yihou-dcp-pd-$NK-s2k
export MC_TE_FILTERS_OVERRIDE=yihou_no_such_rdma_device
export DISAGG_IB_DEVICE='{"0":"ionic_0","1":"ionic_1","2":"ionic_2","3":"ionic_3"}'
export INDEX_SHARE=true
export SGLANG_OVERLAY=/shared_nfs/yihou_glm52/dcp_pd_20261021/src/sglang-ab7a898b77-memlog-ec.yihou/python/sglang
export DECODE_LAYOUT=dcp4
export DECODE_ENV="SGLANG_DSA_DCP_KEEP_KV_B_BF16=1 SGLANG_DSA_DCP_SPLIT_DECODE_INDEXER=1 SGLANG_DSA_DCP_SPLIT_INDEXER_TRITON=1 SGLANG_LOG_DECODE_SEQ_LENS=1"
export PREFILL_EXTRA_ARGS=
export DECODE_EXTRA_ARGS="--mem-fraction-static 0.88"
