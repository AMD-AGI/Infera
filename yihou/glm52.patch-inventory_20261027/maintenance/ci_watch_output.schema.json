{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLM-5.2 bounded CI maintenance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "prs",
    "actions",
    "unresolved",
    "tests"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "prs": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "description": "Exactly one row per monitored PR, ordered 33059, 46820, 46830, 45524, 46918, 47276, 47278, 47897, 47872, 49732. The launcher also validates unique numbers.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "head",
          "state",
          "base_run_url",
          "base_attempt",
          "base_status",
          "base_summary",
          "action",
          "next_action",
          "evidence_urls",
          "needs_user"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "enum": [
              33059,
              46820,
              46830,
              45524,
              46918,
              47276,
              47278,
              47897,
              47872,
              49732
            ]
          },
          "head": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "base_run_url": {
            "type": "string"
          },
          "base_attempt": {
            "type": "integer",
            "minimum": 0
          },
          "base_status": {
            "type": "string"
          },
          "base_summary": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          },
          "evidence_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "needs_user": {
            "type": "boolean"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pr",
          "kind",
          "description",
          "url"
        ],
        "properties": {
          "pr": {
            "type": "integer"
          },
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "pr",
          "summary",
          "next_action",
          "evidence_urls"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "pr": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          },
          "evidence_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
