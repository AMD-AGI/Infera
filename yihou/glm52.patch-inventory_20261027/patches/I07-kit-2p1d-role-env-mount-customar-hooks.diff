--- a/examples/sglang_2p1d_glm5.2/engine/worker.sh
+++ b/examples/sglang_2p1d_glm5.2/engine/worker.sh
@@ -115,8 +115,16 @@
     read -ra extra <<<"$DECODE_EXTRA_ARGS"
 fi
 args+=("${extra[@]}")
+# yihou llrepro: DECODE_CUSTOM_AR=1 removes --disable-custom-all-reduce on the decode (custom all-reduce on).
+if [[ "$role" == decode && "${DECODE_CUSTOM_AR:-0}" == 1 ]]; then
+    _a=(); for x in "${args[@]}"; do [[ "$x" == --disable-custom-all-reduce ]] || _a+=("$x"); done; args=("${_a[@]}")
+fi
 env_args=()
 for kv in "${env[@]}"; do env_args+=(-e "$kv"); done
+# yihou llrepro: decode-only extra env (DECODE_ENV_EXTRA, space separated K=V).
+[[ "$role" != decode ]] || for kv in ${DECODE_ENV_EXTRA:-}; do env_args+=(-e "$kv"); done
+# yihou llrepro: prefill-only extra env (PREFILL_ENV_EXTRA, space separated K=V).
+[[ "$role" != prefill ]] || for kv in ${PREFILL_ENV_EXTRA:-}; do env_args+=(-e "$kv"); done
 
 cmd=(python3 -m infera.engine.sglang "${args[@]}")
 # Both prefills run with --ipc host on one node, and RCCL names shared memory
@@ -136,6 +144,8 @@
 # v0.5.22 reads embed_tokens.embedding_dim on every PP stage, but the middle
 # stages hold a PPMissingLayer there; the patched copy reads config.hidden_size.
 [[ "$role" != prefill ]] || mounts+=(-v "$KIT/patches/deepseek_v2.py:/sgl-workspace/sglang/python/sglang/srt/models/deepseek_v2.py:ro")
+# yihou llrepro: decode-only extra mount (DECODE_MOUNT_EXTRA = src:dst:ro).
+[[ "$role" != decode ]] || for mx in ${DECODE_MOUNT_EXTRA:-}; do mounts+=(-v "$mx"); done   # yihou 10-26: space-separated list
 # Host libionic, so the entrypoint can match the host ionic kernel ABI.
 [[ ! -e /lib/x86_64-linux-gnu/libionic.so ]] ||
     mounts+=(-v /lib/x86_64-linux-gnu/libionic.so:/host-libionic/libionic.so:ro)
