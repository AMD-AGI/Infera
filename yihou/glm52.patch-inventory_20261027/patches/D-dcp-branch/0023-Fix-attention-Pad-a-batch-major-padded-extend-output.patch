From b17da53725f797fd20028c902c564e43b7b4d886 Mon Sep 17 00:00:00 2001
From: yihou <yihou@amd.com>
Date: Wed, 21 Oct 2026 19:48:29 +0000
Subject: [PATCH 23/31] [Fix] attention: Pad a batch-major padded-extend output
 on its token dim

DP attention pads an extend batch to a multiple of attention TP (49 -> 50
rows at attn_tp 2), and RadixAttention runs the backend on the real rows
only, then pads its output back. The pad matched only outputs whose dim 0
is the token count. The DSA sparse-MLA prefill kernels (triton, tilelang)
return [1, tokens, H, D], so the output stayed at 49 rows, o_proj ran on
49 and the FFN boundary failed adding the 50-row residual:
"size of tensor a (49) must match tensor b (50)". A 1-token prompt
padded to 2 hid it, since [1, 1, ...] matches on dim 0.

Pad a [1, tokens, ...] output along dim 1.

Co-Authored-By: Claude <noreply@anthropic.com>
Signed-off-by: yihou <yihou@amd.com>
(cherry picked from commit 31309dc4f1fe5866020ed8cac2821f1f7ea13881)
---
 .../srt/layers/attention/graph_utils.py       | 19 ++++++--
 .../test_radix_attention_padded_extend.py     | 48 +++++++++++++++++++
 2 files changed, 63 insertions(+), 4 deletions(-)

diff --git a/python/sglang/srt/layers/attention/graph_utils.py b/python/sglang/srt/layers/attention/graph_utils.py
index d1bd074670..7c114a90df 100644
--- a/python/sglang/srt/layers/attention/graph_utils.py
+++ b/python/sglang/srt/layers/attention/graph_utils.py
@@ -218,11 +218,22 @@ def _attention_on_real_rows(
         forward_batch._attn_output = attn_output
 
     def padded(t):
-        if not isinstance(t, torch.Tensor) or t.shape[0] != real_num_tokens:
+        if not isinstance(t, torch.Tensor) or t.dim() == 0:
             return t
-        full = t.new_empty((num_tokens, *t.shape[1:]))
-        full[:real_num_tokens].copy_(t)
-        full[real_num_tokens:].zero_()
+        if t.shape[0] == real_num_tokens:
+            dim = 0
+        elif t.dim() > 1 and t.shape[0] == 1 and t.shape[1] == real_num_tokens:
+            # Batch-major [1, tokens, ...] output (the DSA sparse-MLA prefill
+            # kernels). Left unpadded, its caller's view(-1, ...) yields the
+            # real rows only, one short of the residual's padded rows.
+            dim = 1
+        else:
+            return t
+        shape = list(t.shape)
+        shape[dim] = num_tokens
+        full = t.new_empty(shape)
+        full.narrow(dim, 0, real_num_tokens).copy_(t)
+        full.narrow(dim, real_num_tokens, num_tokens - real_num_tokens).zero_()
         return full
 
     if isinstance(ret, tuple):
diff --git a/test/registered/unit/layers/test_radix_attention_padded_extend.py b/test/registered/unit/layers/test_radix_attention_padded_extend.py
index 848a84fdbf..b82be65e7e 100644
--- a/test/registered/unit/layers/test_radix_attention_padded_extend.py
+++ b/test/registered/unit/layers/test_radix_attention_padded_extend.py
@@ -60,6 +60,20 @@ class _IndexerBackend:
         return idx_out.reshape(q.shape[0], -1), torch.ones(q.shape[0], 2)
 
 
+class _BatchMajorBackend:
+    """Stand-in with the DSA sparse-MLA prefill contract: a [1, tokens, heads,
+    d_v] output, optionally beside a [tokens, heads] LSE."""
+
+    def __init__(self, with_lse):
+        self.with_lse = with_lse
+
+    def forward(self, q, k, v, layer, forward_batch, save_kv_cache, **kwargs):
+        out = torch.ones(1, q.shape[0], 2, 3)
+        if self.with_lse:
+            return out, torch.ones(q.shape[0], 2)
+        return out
+
+
 def _rows(value):
     if isinstance(value, list):
         return [t.shape[0] for t in value]
@@ -221,6 +235,40 @@ class TestPaddedExtendAttention(CustomTestCase):
         self.assertEqual(idx_out[5:].count_nonzero().item(), 0)
         self.assertEqual(idx_out[:5].count_nonzero().item(), 5 * 128)
 
+    def test_a_batch_major_output_is_padded_on_its_token_dim(self):
+        # DP attention pads 49 rows to 50 for attention TP 2; the DSA prefill
+        # kernel's [1, 49, H, D] output must come back with 50 token rows, or
+        # the caller's view(-1, H, D) is one row short of the residual.
+        layer = SimpleNamespace(
+            qk_head_dim=4, v_head_dim=3, tp_q_head_num=2, is_cross_attention=False
+        )
+        for real, rows in ((49, 50), (5, 8), (1, 2)):
+            for with_lse in (False, True):
+                with self.subTest(real=real, with_lse=with_lse):
+                    with patch.object(
+                        radix_attention,
+                        "get_attn_backend",
+                        return_value=_BatchMajorBackend(with_lse),
+                    ):
+                        ret = radix_attention._attention_on_real_rows(
+                            layer,
+                            real,
+                            torch.zeros(rows, 2, 4),
+                            torch.zeros(rows, 1, 3),
+                            torch.zeros(rows, 1, 3),
+                            _batch(ForwardMode.EXTEND, real, rows=rows),
+                            False,
+                        )
+                    out = ret[0] if with_lse else ret
+                    out = out.view(-1, 2, 3)
+                    self.assertEqual(out.shape[0], rows)
+                    torch.testing.assert_close(out[:real], torch.ones(real, 2, 3))
+                    torch.testing.assert_close(
+                        out[real:], torch.zeros(rows - real, 2, 3)
+                    )
+                    if with_lse:
+                        self.assertEqual(tuple(ret[1].shape), (rows, 2))
+
     def test_the_output_is_written_in_place_or_copied(self):
         for in_place in (True, False):
             with self.subTest(in_place=in_place):
