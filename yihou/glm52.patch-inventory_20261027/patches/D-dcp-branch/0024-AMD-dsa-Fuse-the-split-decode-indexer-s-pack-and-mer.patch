diff --git a/test/registered/unit/test_dsa_dcp_split_indexer_triton.py b/test/registered/unit/test_dsa_dcp_split_indexer_triton.py
new file mode 100644
index 0000000000..241aa90bb5
--- /dev/null
+++ b/test/registered/unit/test_dsa_dcp_split_indexer_triton.py
@@ -0,0 +1,171 @@
+"""The Triton pack/merge of the page-split DCP decode indexer must match the
+torch reference (pack_candidates, merge_candidates, positions_to_slots) bit for
+bit, including invalid lanes, partial rows and the -1 padding. Runs the kernels
+in the Triton interpreter on CPU."""
+
+import os
+import subprocess
+import sys
+import unittest
+
+# The interpreter only takes effect for @triton.jit functions created after it is
+# set, including triton.language's own (tl.sort); if triton is already loaded in
+# this process, the kernel cases re-run this file in a fresh one instead.
+_FRESH_TRITON = "triton" not in sys.modules
+os.environ["TRITON_INTERPRET"] = "1"
+
+import torch  # noqa: E402
+
+from sglang.srt.layers.attention.dsa.dsa_dcp_split_indexer import (  # noqa: E402
+    merge_candidates,
+    pack_candidates,
+    positions_to_slots,
+    split_decode_topk,
+)
+from sglang.srt.layers.attention.dsa.dsa_dcp_split_indexer_triton import (  # noqa: E402
+    merge_candidates_triton,
+    pack_candidates_triton,
+)
+from sglang.test.ci.ci_register import register_cpu_ci  # noqa: E402
+from sglang.test.test_utils import CustomTestCase  # noqa: E402
+
+register_cpu_ci(est_time=60, suite="base-a-test-cpu")
+
+
+def _distinct_scores(*shape, seed):
+    g = torch.Generator().manual_seed(seed)
+    n = 1
+    for d in shape:
+        n *= d
+    return (torch.randperm(n, generator=g).float() / n - 0.5).view(*shape)
+
+
+def _local_case(rows, width, topk, seed):
+    """Local logits, a local top-k (with -1 and out-of-length lanes), lens."""
+    g = torch.Generator().manual_seed(seed)
+    logits = _distinct_scores(rows, width, seed=seed)
+    lens = torch.randint(0, width + 1, (rows,), generator=g, dtype=torch.int32)
+    lens[0] = width  # a full row
+    lens[1] = 0  # an empty row
+    idx = torch.randint(0, width, (rows, topk), generator=g, dtype=torch.int32)
+    idx[torch.rand(rows, topk, generator=g) < 0.2] = -1
+    return logits, idx, lens
+
+
+_needs_fresh = unittest.skipUnless(
+    _FRESH_TRITON, "triton loaded before the interpreter"
+)
+
+
+@_needs_fresh
+class TestPackTriton(CustomTestCase):
+    def test_matches_reference(self):
+        for page, w, r in ((64, 4, 0), (64, 4, 3), (16, 2, 1)):
+            logits, idx, lens = _local_case(rows=5, width=192, topk=96, seed=r)
+            ref = pack_candidates(logits, idx, lens, 96, page, w, r)
+            out = pack_candidates_triton(logits, idx, lens, 96, page, w, r)
+            self.assertTrue(torch.equal(out, ref), f"{page=} {w=} {r=}")
+
+    def test_padded_logits_view(self):
+        # The aiter logits are a row-padded view; only stride(1) == 1 is assumed.
+        logits, idx, lens = _local_case(rows=3, width=128, topk=64, seed=7)
+        padded = torch.full((3, 160), 9.0)
+        padded[:, :128] = logits
+        view = padded[:, :128]
+        ref = pack_candidates(logits, idx, lens, 64, 64, 4, 1)
+        out = pack_candidates_triton(view, idx, lens, 64, 64, 4, 1)
+        self.assertTrue(torch.equal(out, ref))
+
+
+def _gathered(rows, topk, w, n_pos, seed):
+    """Per-rank packs with distinct scores, some -inf lanes and -1 positions."""
+    g = torch.Generator().manual_seed(seed)
+    scores = _distinct_scores(w, rows, topk, seed=seed)
+    scores[torch.rand(w, rows, topk, generator=g) < 0.3] = -float("inf")
+    pos = torch.randint(0, n_pos, (w, rows, topk), generator=g, dtype=torch.int32)
+    pos[scores == -float("inf")] = -1
+    packs = torch.empty((w, 2, rows, topk), dtype=torch.int32)
+    packs[:, 0] = scores.view(torch.int32)
+    packs[:, 1] = pos
+    return packs.view(w * 2, rows, topk)
+
+
+@_needs_fresh
+class TestMergeTriton(CustomTestCase):
+    def test_positions_match_reference(self):
+        for w, topk in ((4, 64), (2, 32), (3, 16)):  # w * topk not a power of 2 too
+            gathered = _gathered(rows=4, topk=topk, w=w, n_pos=1000, seed=w)
+            ref = merge_candidates(gathered, w, topk)
+            out = merge_candidates_triton(gathered, w, topk)
+            self.assertTrue(torch.equal(out, ref.to(torch.int32)), f"{w=} {topk=}")
+
+    def test_production_shape(self):
+        # GLM-5.2: index_topk 2048 over DCP4, an 8192-wide sort per row.
+        gathered = _gathered(rows=2, topk=2048, w=4, n_pos=200_000, seed=13)
+        ref = merge_candidates(gathered, 4, 2048)
+        out = merge_candidates_triton(gathered, 4, 2048)
+        self.assertTrue(torch.equal(out, ref.to(torch.int32)))
+
+    def test_slots_match_reference(self):
+        page, n_pos = 16, 1000
+        gathered = _gathered(rows=3, topk=64, w=4, n_pos=n_pos, seed=11)
+        n_pages = -(-n_pos // page)
+        g = torch.Generator().manual_seed(3)
+        table = torch.stack(
+            [torch.randperm(8 * n_pages, generator=g)[:n_pages] for _ in range(3)]
+        ).to(torch.int32)
+        ref = positions_to_slots(merge_candidates(gathered, 4, 64), table, page)
+        out = merge_candidates_triton(gathered, 4, 64, page_table=table, page=page)
+        self.assertTrue(torch.equal(out, ref))
+
+    def test_all_invalid_row_is_all_minus_one(self):
+        gathered = _gathered(rows=2, topk=32, w=4, n_pos=100, seed=5)
+        packs = gathered.view(4, 2, 2, 32)
+        packs[:, 0, 1] = torch.tensor(-float("inf")).view(torch.int32)
+        packs[:, 1, 1] = -1
+        out = merge_candidates_triton(gathered, 4, 32)
+        self.assertTrue(torch.equal(out[1], torch.full((32,), -1, dtype=torch.int32)))
+
+
+@_needs_fresh
+class TestSplitTopkPlumbing(CustomTestCase):
+    def test_triton_fns_slot_into_split_decode_topk(self):
+        rows, page, w, r, topk = 3, 16, 4, 2, 32
+        g = torch.Generator().manual_seed(1)
+        table = torch.randperm(64, generator=g)[:40].to(torch.int32).repeat(rows, 1)
+        lens = torch.tensor([640, 300, 17], dtype=torch.int32)
+
+        def run(**fns):
+            return split_decode_topk(
+                block_tables=table,
+                lens=lens,
+                page=page,
+                topk=topk,
+                w=w,
+                r=r,
+                logits_fn=lambda t, ln, n: _distinct_scores(rows, n, seed=2),
+                local_topk_fn=lambda lg, ln, k: torch.topk(lg, k, dim=1)[1].int(),
+                # Stand-in for the W-rank gather: rank r's pack in every slot.
+                all_gather_fn=lambda pack: torch.cat([pack] * w),
+                **fns,
+            )
+
+        ref = run()
+        out = run(pack_fn=pack_candidates_triton, merge_fn=merge_candidates_triton)
+        self.assertTrue(torch.equal(out, ref.to(torch.int32)))
+
+
+@unittest.skipIf(_FRESH_TRITON, "kernel cases run in this process")
+class TestKernelsInFreshProcess(CustomTestCase):
+    def test_kernel_cases_pass(self):
+        proc = subprocess.run(
+            [sys.executable, os.path.abspath(__file__)],
+            capture_output=True,
+            text=True,
+            timeout=600,
+        )
+        self.assertEqual(proc.returncode, 0, proc.stderr[-4000:])
+
+
+if __name__ == "__main__":
+    unittest.main()
