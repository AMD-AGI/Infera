diff --git a/python/sglang/srt/layers/attention/dsa/dsa_dcp_split_indexer_triton.py b/python/sglang/srt/layers/attention/dsa/dsa_dcp_split_indexer_triton.py
new file mode 100644
index 0000000000..a1b544f471
--- /dev/null
+++ b/python/sglang/srt/layers/attention/dsa/dsa_dcp_split_indexer_triton.py
@@ -0,0 +1,170 @@
+"""Triton pack and merge for the page-split DCP decode indexer.
+
+Drop-in replacements for ``pack_candidates`` and ``merge_candidates`` (plus
+``positions_to_slots``) in ``dsa_dcp_split_indexer``: one launch each instead
+of a chain of small elementwise ops per indexer layer.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _pack_candidates_kernel(
+    logits_ptr,
+    logits_stride,
+    width,
+    idx_ptr,
+    idx_stride,
+    lens_ptr,
+    out_ptr,
+    rows,
+    TOPK: tl.constexpr,
+    BLOCK: tl.constexpr,
+    PAGE: tl.constexpr,
+    W: tl.constexpr,
+    R: tl.constexpr,
+):
+    row = tl.program_id(0)
+    offs = tl.arange(0, BLOCK)
+    lane = offs < TOPK
+    idx = tl.load(idx_ptr + row * idx_stride + offs, mask=lane, other=-1).to(tl.int64)
+    length = tl.load(lens_ptr + row).to(tl.int64)
+    valid = lane & (idx >= 0) & (idx < length) & (idx < width)
+    safe = tl.where(valid, idx, 0)
+    score = tl.load(
+        logits_ptr + row * logits_stride + safe, mask=valid, other=float("-inf")
+    ).to(tl.float32)
+    score = tl.where(valid, score, float("-inf"))
+    pos = ((safe // PAGE) * W + R) * PAGE + safe % PAGE
+    pos = tl.where(valid, pos, -1).to(tl.int32)
+    # out is [2, rows, TOPK] int32: fp32 score bits, then the request position.
+    tl.store(out_ptr + row * TOPK + offs, score.to(tl.int32, bitcast=True), mask=lane)
+    tl.store(out_ptr + (rows + row) * TOPK + offs, pos, mask=lane)
+
+
+def pack_candidates_triton(
+    local_logits: torch.Tensor,
+    local_idx: torch.Tensor,
+    local_lens: torch.Tensor,
+    topk: int,
+    page: int,
+    w: int,
+    r: int,
+) -> torch.Tensor:
+    """Same contract as ``dsa_dcp_split_indexer.pack_candidates``."""
+    rows = local_idx.shape[0]
+    out = torch.empty((2, rows, topk), dtype=torch.int32, device=local_idx.device)
+    if rows == 0:
+        return out
+    assert local_logits.stride(1) == 1 and local_idx.stride(1) == 1
+    _pack_candidates_kernel[(rows,)](
+        local_logits,
+        local_logits.stride(0),
+        local_logits.shape[1],
+        local_idx,
+        local_idx.stride(0),
+        local_lens,
+        out,
+        rows,
+        TOPK=topk,
+        BLOCK=triton.next_power_of_2(topk),
+        PAGE=page,
+        W=w,
+        R=r,
+    )
+    return out
+
+
+@triton.jit
+def _merge_candidates_kernel(
+    packs_ptr,
+    rows,
+    page_table_ptr,
+    page_table_stride,
+    out_ptr,
+    TOPK: tl.constexpr,
+    W: tl.constexpr,
+    BLOCK: tl.constexpr,
+    IDX_BITS: tl.constexpr,
+    PAGE: tl.constexpr,
+    HAS_PAGE_TABLE: tl.constexpr,
+):
+    row = tl.program_id(0)
+    cand = tl.arange(0, BLOCK)
+    lane = cand < W * TOPK
+    rank = cand // TOPK
+    j = cand % TOPK
+    # packs is [W, 2, rows, TOPK] int32 (one gathered pack per rank).
+    score_off = ((rank * 2) * rows + row) * TOPK + j
+    bits = tl.load(packs_ptr + score_off, mask=lane, other=-8388608)  # -inf bits
+    # Order-preserving map of the fp32 bits onto [0, 2^32): integer order = float
+    # order (negative floats flip all bits, others set the top bit).
+    ubits = bits.to(tl.int64) & 0xFFFFFFFF
+    ordered = tl.where(bits < 0, 0xFFFFFFFF - ubits, ubits + 0x80000000)
+    # Low bits favour the lower candidate index among equal scores.
+    key = (ordered << IDX_BITS) | (BLOCK - 1 - cand).to(tl.int64)
+    key = tl.sort(key, descending=True)
+    picked = (BLOCK - 1) - (key & (BLOCK - 1)).to(tl.int32)
+    # 0x007FFFFF is the mapped -inf; anything above it is a real score.
+    real = (key >> IDX_BITS) > 0x007FFFFF
+    p_rank = picked // TOPK
+    p_j = picked % TOPK
+    pos_off = ((p_rank * 2 + 1) * rows + row) * TOPK + p_j
+    out_lane = cand < TOPK
+    pos = tl.load(packs_ptr + pos_off, mask=out_lane & real, other=-1).to(tl.int64)
+    valid = out_lane & real & (pos >= 0)
+    if HAS_PAGE_TABLE:
+        safe = tl.where(valid, pos, 0)
+        page_id = tl.load(
+            page_table_ptr + row * page_table_stride + safe // PAGE,
+            mask=valid,
+            other=0,
+        ).to(tl.int64)
+        result = page_id * PAGE + safe % PAGE
+    else:
+        result = pos
+    result = tl.where(valid, result, -1).to(tl.int32)
+    tl.store(out_ptr + row * TOPK + cand, result, mask=out_lane)
+
+
+def merge_candidates_triton(
+    gathered: torch.Tensor,
+    w: int,
+    topk: int,
+    *,
+    page_table: Optional[torch.Tensor] = None,
+    page: int = 1,
+) -> torch.Tensor:
+    """``merge_candidates`` and, given ``page_table``, ``positions_to_slots``.
+
+    Returns [rows, topk] int32 in descending score order, -1 padded.
+    """
+    rows = gathered.shape[1]
+    out = torch.empty((rows, topk), dtype=torch.int32, device=gathered.device)
+    if rows == 0:
+        return out
+    packs = gathered.contiguous()
+    block = triton.next_power_of_2(w * topk)
+    has_page_table = page_table is not None
+    if has_page_table:
+        assert page_table.stride(1) == 1
+    _merge_candidates_kernel[(rows,)](
+        packs,
+        rows,
+        page_table if has_page_table else packs,
+        page_table.stride(0) if has_page_table else 0,
+        out,
+        TOPK=topk,
+        W=w,
+        BLOCK=block,
+        IDX_BITS=block.bit_length() - 1,
+        PAGE=page,
+        HAS_PAGE_TABLE=has_page_table,
+    )
+    return out
