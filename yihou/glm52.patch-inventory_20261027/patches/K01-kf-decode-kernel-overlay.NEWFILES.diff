+        for f in sys.meta_path:
+            if f is self:
+                continue
+            spec = getattr(f, "find_spec", lambda *a: None)(name, path, target)
+            if spec is not None:
+                spec.loader = _Loader(spec.loader, fns)
+                return spec
+        return None
