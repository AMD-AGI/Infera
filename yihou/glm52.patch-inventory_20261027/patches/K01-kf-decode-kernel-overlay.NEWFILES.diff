+        while each tile reads 136 B of A per row and K-tile instead of 512 B."""
+        BM, BN, BK = 16, 128, 256
+        KH_TILE = BK // 2
+        K_HALF = _g1c.k_half_for(K)
+        K_TILES = K // BK
+        K_GROUPS = K // 32
+        kBS_stride_n0_dw = _g1c.kbs_stride_n0_dw_for(K)
+        kBS_per_expert_dw = _g1c.kbs_per_expert_dw_for(N_OUT, K)
