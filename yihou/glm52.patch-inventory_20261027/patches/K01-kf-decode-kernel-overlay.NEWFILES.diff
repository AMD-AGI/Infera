+                    os.makedirs(_DUMP_DIR, exist_ok=True)
+                    if not _DUMP["pool"]:
+                        torch.save(kv_cache_fp8.detach().cpu(), f"{_DUMP_DIR}/kvpool.L{layer_id}.pt")
+                        _DUMP["pool"] = True
+                    torch.save(dict(q=q_fp8.detach().cpu(), w=weights.detach().cpu(), lens=lens.detach().cpu(),
+                                    bt=block_tables.detach().cpu(), page=page_size, layer=layer_id,
+                                    rows=q_fp8.shape[0]), f"{_DUMP_DIR}/call.{_DUMP['saved']:03d}.pt")
+                    _DUMP["saved"] += 1
+                    log(f"DUMP dcp_indexer call {_DUMP['saved']} rows={q_fp8.shape[0]} -> {_DUMP_DIR}")
+        except Exception as e:
+            log(f"DUMP failed: {type(e).__name__}: {e}")
+        return orig(self, q_fp8, kv_cache_fp8, weights, lens, block_tables, page_size, metadata, layer_id)
+
+    cls._dcp_split_decode_topk = _dcp_split_decode_topk
+    log(f"patched Indexer._dcp_split_decode_topk (DUMP -> {_DUMP_DIR}, layer {layer_sel})")
+
+# ------------------------------------------------------------------------------------------ import hook
