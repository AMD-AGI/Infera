+    qk = load_jit("kf_fi_qk", h, cuda_files=[f"{d}/qk_rope_hadamard_quant.cuh"],
+                  cuda_wrappers=[("indexer_qk_rope_hadamard_quant_and_cache", "QkRopeHadamardQuantKernel::run")],
