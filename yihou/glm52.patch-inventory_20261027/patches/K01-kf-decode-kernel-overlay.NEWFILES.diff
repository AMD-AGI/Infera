+        BSCALE_BYTES = _g1c.bscale_bytes_for(NE, N_OUT, K)
+        NUM_N_BLOCKS = N_OUT // BN
+        inter = N_OUT // 2
+        OUT_AS_PER_CHUNK_DW = _g1c.kas_per_chunk_dw_for(inter)
+        OUT_ROW_BYTES = _g1c.k_half_for(inter)
