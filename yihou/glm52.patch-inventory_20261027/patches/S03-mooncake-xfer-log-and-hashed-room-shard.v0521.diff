 logger = logging.getLogger(__name__)
 
+
+# [yihou] YIHOU-REGBASE diagnostic (mount patch, not upstream). Mooncake's HIP IPC
+# path registers desc.addr = ptr and relocates writes as dst - ptr + opened_base,
+# but hipIpcOpenMemHandle maps the ALLOCATION BASE. So any registered ptr that is
+# not its allocation's base would get every write shifted by (ptr - base). Log, per
+# registered region, hipMemGetAddressRange(ptr) and whether base == ptr.
+# [yihou] YIHOU_XFER_LOG -- log-only KV-transfer instrumentation (mount patch, R032).
+# 0 (default): no behaviour change. 1: per-shard per-minute aggregates of the prefill
+# sender: chunks enqueued/dequeued, queue wait (enqueue -> worker dequeue), mooncake
+# batch_transfer_sync calls with blocks / bytes / wall time, and the slowest call.
+_YIHOU_XFER_LOG = os.environ.get("YIHOU_XFER_LOG", "0").strip() == "1"
+
+# [yihou] YIHOU_XFER_SHARD -- mount patch (R036). Prefill transfer-queue sharding:
+#   dest (default) upstream: sum of destination session ports % len(queues). With 1:1 DP
+#        every chunk of a prefill rank lands in ONE queue (one worker, strict FIFO).
+#   room bootstrap_room % len(queues): all chunks of one request stay in one FIFO (non-final
+#        before final, aux/Success last); different requests spread over all
+#        SGLANG_DISAGGREGATION_QUEUE_SIZE workers. Failed-session early abort is checked per
+#        chunk inside the worker, so it still holds in any queue.
+#   mix  (g4tune 2026-10-19) like room, but the room is hashed first: in run e2f (10-10) room %
+#        len(queues) equalled the prefill DP rank for every request (DPi used only shard i), so
+#        room sharding never spread a rank's chunks. mix = ((room * 0x9E3779B97F4A7C15) mod 2^64)
+#        >> 32 % len(queues): all chunks of one request still stay in one FIFO.
+_YIHOU_XFER_SHARD = os.environ.get("YIHOU_XFER_SHARD", "dest").strip()
+if _YIHOU_XFER_SHARD not in ("dest", "room", "mix"):
+    raise ValueError(f"YIHOU_XFER_SHARD={_YIHOU_XFER_SHARD!r} (want dest|room|mix)")
+
+
+class _YihouXferStats:
+    def __init__(self):
+        self.lock = threading.Lock()
+        self.tls = threading.local()
+        self.last = time.monotonic()
+        self.reset()
+
+    def reset(self):
+        self.d = {}  # shard -> dict of counters
+
+    def _s(self, shard):
+        return self.d.setdefault(
+            shard,
+            dict(enq=0, deq=0, wait_s=0.0, wait_max=0.0, calls=0, blocks=0,
+                 blocks_max=0, bytes=0, wall_s=0.0, wall_max=0.0, slow=None,
+                 par_k=0, par_reqs=0, par_wall_s=0.0, par_group_wall_s=0.0,
+                 par_group_wall_max=0.0, sync_n=0, sync_last_n=0, sync_s=0.0,
+                 sync_max=0.0, idle_s=0.0),
+        )
+
+    def enq(self, shard):
+        with self.lock:
+            self._s(shard)["enq"] += 1
+
+    def deq(self, shard, wait_s):
+        self.tls.shard = shard
+        with self.lock:
+            s = self._s(shard)
+            s["deq"] += 1
+            s["wait_s"] += wait_s
+            s["wait_max"] = max(s["wait_max"], wait_s)
+
+    def sync(self, shard, sync_s, is_last):
+        # time the worker spent in kv_chunk.wait_event.synchronize() for one item
+        with self.lock:
+            s = self._s(shard)
+            s["sync_n"] += 1
+            s["sync_last_n"] += int(bool(is_last))
+            s["sync_s"] += sync_s
+            s["sync_max"] = max(s["sync_max"], sync_s)
+
+    def idle(self, shard, idle_s):
+        # time the worker sat blocked in queue.get() (busy = span - idle)
+        with self.lock:
+            self._s(shard)["idle_s"] += idle_s
+
+    def par(self, shard, k, wall_s, group_walls):
+        with self.lock:
+            s = self._s(shard)
+            s["par_k"] = k
+            s["par_reqs"] += 1
+            s["par_wall_s"] += wall_s
+            s["par_group_wall_s"] += sum(group_walls)
+            s["par_group_wall_max"] = max([s["par_group_wall_max"], *group_walls])
+
+    def call(self, nblocks, nbytes, wall_s, session):
+        shard = getattr(self.tls, "shard", -1)
+        with self.lock:
+            s = self._s(shard)
+            s["calls"] += 1
+            s["blocks"] += nblocks
+            s["blocks_max"] = max(s["blocks_max"], nblocks)
+            s["bytes"] += nbytes
+            s["wall_s"] += wall_s
+            if wall_s > s["wall_max"]:
+                s["wall_max"] = wall_s
+                s["slow"] = (nblocks, nbytes, wall_s, session)
+            now = time.monotonic()
+            if now - self.last < 60.0:
+                return
+            span = now - self.last
+            self.last = now
+            for sh, v in sorted(self.d.items()):
+                gb = v["bytes"] / 2**30
+                slow = v["slow"]
+                logger.info(
+                    "YIHOU-XFER shard=%s span=%.0fs enq=%d deq=%d wait_mean=%.3fs wait_max=%.3fs "
+                    "calls=%d blocks=%d blocks/call=%.0f blocks_max=%d GiB=%.2f wall=%.2fs "
+                    "GiB/s=%.2f avg_block_KiB=%.1f wall_max=%.3fs slowest=%s "
+                    "par_k=%d par_reqs=%d par_wall_mean=%.3fs par_group_wall_mean=%.3fs "
+                    "par_group_wall_max=%.3fs sync_n=%d sync_last_n=%d sync_mean=%.3fs "
+                    "sync_max=%.3fs sync_sum=%.2fs idle=%.2fs",
+                    sh, span, v["enq"], v["deq"],
+                    v["wait_s"] / max(v["deq"], 1), v["wait_max"],
+                    v["calls"], v["blocks"], v["blocks"] / max(v["calls"], 1), v["blocks_max"],
+                    gb, v["wall_s"], gb / v["wall_s"] if v["wall_s"] > 0 else 0.0,
+                    (v["bytes"] / 1024) / max(v["blocks"], 1), v["wall_max"],
+                    None if slow is None else
+                    f"(blocks={slow[0]},MiB={slow[1] / 2**20:.0f},s={slow[2]:.3f},{slow[3]})",
+                    v["par_k"], v["par_reqs"], v["par_wall_s"] / max(v["par_reqs"], 1),
+                    v["par_group_wall_s"] / max(v["par_reqs"] * max(v["par_k"], 1), 1),
+                    v["par_group_wall_max"], v["sync_n"], v["sync_last_n"],
+                    v["sync_s"] / max(v["sync_n"], 1), v["sync_max"], v["sync_s"], v["idle_s"],
+                )
+            self.reset()
+
+
+_yihou_xfer = _YihouXferStats() if _YIHOU_XFER_LOG else None
+
+# [yihou] YIHOU_XFER_PAR=k -- split one request's per-layer transfer into k contiguous
+# layer groups submitted concurrently on the request's executor (default 1 = original
+# single batch_transfer_sync). All futures are drained before returning (no write may
+# outlive the call); the chunk fails if any group fails.
+_YIHOU_XFER_PAR = max(1, int(os.environ.get("YIHOU_XFER_PAR", "1").strip() or "1"))
+
