+    const bool high = useHighPriorityStreams();
+    if (high) {
+        err = hipDeviceGetStreamPriorityRange(&least_priority,
+                                              &greatest_priority);
+        if (err != hipSuccess) {
+            LOG(ERROR) << "StreamPool: hipDeviceGetStreamPriorityRange failed: "
