# shellcheck shell=bash disable=SC2034
# E7h + llying's "B300 prefill settings" on the PREFILL role only (2026-11-21): --gpu-memory-utilization 0.93,
# --long-prefill-token-threshold 8192, --max-num-seqs 64. Second-hand: llying 40 passed his correctness gate with these and grew the
# P prefix pool 26.3M -> 41M tok/rank (research/colleagues/llying_alignment_20261120.md). Motivation: e7 c256 P queue 8.0 s/request
# was the largest stage (research/e7_c256_stage_analysis.md). argparse: later occurrence of an option wins (P_CMD_EXTRA appended).
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/e7h-pd-mooncake-1p1d-dp2-nohip.env"
CFG_ID=e7p-pd-nohip-pb300
CFG_SOURCE="e7h + P-only B300 prefill settings; e7h = $CFG_SOURCE"
P_CMD_EXTRA+=( --gpu-memory-utilization 0.93 --long-prefill-token-threshold 8192 --max-num-seqs 64 )
