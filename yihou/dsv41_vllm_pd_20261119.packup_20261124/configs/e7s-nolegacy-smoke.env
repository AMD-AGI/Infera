# shellcheck shell=bash disable=SC2034
# Debug variant (2026-11-20): e7s-pd-mooncake-1p1d-dp2-smoke with ONE change: HSA_ENABLE_IPC_MODE_LEGACY=1 removed from COMMON_ENV.
# Purpose: discriminate the cause of "Triton Error [HIP] Code 209 no kernel image" in PD role kernel warmup (crusoe v3-186, v3-129).
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/e7s-pd-mooncake-1p1d-dp2-smoke.env"
CFG_ID=e7s-nolegacy-smoke
CFG_SOURCE="e7s minus HSA_ENABLE_IPC_MODE_LEGACY; e7s = $CFG_SOURCE"
_e=(); for v in "${COMMON_ENV[@]}"; do [ "$v" = HSA_ENABLE_IPC_MODE_LEGACY=1 ] || _e+=("$v"); done; COMMON_ENV=("${_e[@]}"); unset _e v
