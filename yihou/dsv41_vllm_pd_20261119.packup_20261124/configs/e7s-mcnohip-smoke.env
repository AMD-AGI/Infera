# shellcheck shell=bash disable=SC2034
# Debug variant (2026-11-20): e7s (RDMA) + MC_DISABLE_HIP=1 on both roles (llying's pd_mooncake_common.sh always sets it:
# same-host transfers over RDMA loopback instead of Mooncake's HIP transport). Tests whether Mooncake's HIP transport init causes
# the Triton Code 209 in PD kernel warmup.
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/e7s-pd-mooncake-1p1d-dp2-smoke.env"
CFG_ID=e7s-mcnohip-smoke
CFG_SOURCE="e7s + MC_DISABLE_HIP=1; e7s = $CFG_SOURCE"
COMMON_ENV+=( MC_DISABLE_HIP=1 )
