# shellcheck shell=bash disable=SC2034
# Debug variant (2026-11-20): e7s with RDMA removed from the container (DOCKER_RDMA=0: no /dev/infiniband, IPC_LOCK, memlock) and
# Mooncake protocol tcp. Bring-up/debug only, not a perf config. Discriminates the Triton Code 209 crash (RDMA/ibverbs init vs not).
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/e7s-pd-mooncake-1p1d-dp2-smoke.env"
CFG_ID=e7s-nordma-smoke
CFG_SOURCE="e7s with DOCKER_RDMA=0 + MOONCAKE_PROTOCOL=tcp; e7s = $CFG_SOURCE"
DOCKER_RDMA=0
MOONCAKE_PROTOCOL=tcp
