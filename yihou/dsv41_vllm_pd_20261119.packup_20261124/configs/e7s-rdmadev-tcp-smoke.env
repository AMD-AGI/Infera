# shellcheck shell=bash disable=SC2034
# Debug variant (2026-11-20): e7s with RDMA devices kept in the container (DOCKER_RDMA=1) but Mooncake protocol tcp.
# (= e7se run on crusoe v3-129: Code 209). Restored 2026-11-21 after an accidental overwrite (self-sourcing).
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/e7s-pd-mooncake-1p1d-dp2-smoke.env"
CFG_ID=e7s-rdmadev-tcp-smoke
CFG_SOURCE="e7s with MOONCAKE_PROTOCOL=tcp (RDMA container setup kept); e7s = $CFG_SOURCE"
MOONCAKE_PROTOCOL=tcp
