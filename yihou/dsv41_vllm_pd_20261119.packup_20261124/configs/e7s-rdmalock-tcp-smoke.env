# shellcheck shell=bash disable=SC2034
# Debug variant (2026-11-21): e7s-rdmadev-tcp-smoke keeping only part of the RDMA container setup: IPC_LOCK + memlock only.
# Splits which part of DOCKER_RDMA triggers Triton Code 209 in PD kernel warmup.
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/e7s-rdmadev-tcp-smoke.env"
CFG_ID=e7s-rdmalock-tcp-smoke
CFG_SOURCE="e7s-rdmadev-tcp-smoke with DOCKER_RDMA_DEV=0; base = $CFG_SOURCE"
DOCKER_RDMA_DEV=0
