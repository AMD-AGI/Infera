# shellcheck shell=bash disable=SC2034
# Crusoe variant (2026-11-21) of e7p-pd-nohip-pb300: no RDMA container setup + Mooncake TCP. On crusoe nodes (no ib_peer_mem) every PD role with
# the RDMA container setup crashed at kernel warmup with Triton Code 209 (e7sa/sb/sc/se/sf); without it (e7sd) the P role came up.
# KV per request is ~0.3-0.4 GB (SYNTHESIS), same-node TCP; bring-up/throughput comparison vs RDMA e7 c256 (254k on openai).
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/e7p-pd-nohip-pb300.env"
CFG_ID=e7tp-pd-tcp
CFG_SOURCE="e7p-pd-nohip-pb300 with DOCKER_RDMA=0 + MOONCAKE_PROTOCOL=tcp; base = $CFG_SOURCE"
DOCKER_RDMA=0
MOONCAKE_PROTOCOL=tcp
