# shellcheck shell=bash disable=SC2034
# Crusoe PD variant (2026-11-21): e7 (NO MC_DISABLE_HIP) + no RDMA container setup + Mooncake TCP. e7th (with MC_DISABLE_HIP=1 + TCP)
# moved no KV: D "pulling kv_caches failed (-1)", Mooncake "tcp_transport ClientSession: no status frame/progress within 30s",
# "Local segment descriptor not found". Hypothesis (untested): TCP transport needs HIP to stage GPU buffers, which MC_DISABLE_HIP removes.
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/e7-pd-mooncake-1p1d-dp2.env"
CFG_ID=e7u-pd-tcp-hip
CFG_SOURCE="e7 + DOCKER_RDMA=0 + MOONCAKE_PROTOCOL=tcp (HIP transport allowed); e7 = $CFG_SOURCE"
DOCKER_RDMA=0
MOONCAKE_PROTOCOL=tcp
