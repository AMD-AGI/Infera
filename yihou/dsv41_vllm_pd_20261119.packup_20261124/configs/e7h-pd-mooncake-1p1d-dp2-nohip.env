# shellcheck shell=bash disable=SC2034
# E7 + MC_DISABLE_HIP=1 on both roles (2026-11-21). Evidence: e7-pd-c512-11210519 P/D logs: Mooncake HipTransport
# "hipIpcOpenMemHandle failed (Error code: 201 - invalid device context)" x99, then "submitTransfer failed ... device memory not
# registered" -> "Sending ... failed (-1)" / "pulling kv_caches failed". Same-node P->D goes through Mooncake's HIP transport
# unless MC_DISABLE_HIP=1 (llying's pd_mooncake_common.sh always sets it: same-host transfers over RDMA loopback).
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/e7-pd-mooncake-1p1d-dp2.env"
CFG_ID=e7h-pd-mooncake-1p1d-dp2-nohip
CFG_SOURCE="e7 + MC_DISABLE_HIP=1; e7 = $CFG_SOURCE"
COMMON_ENV+=( MC_DISABLE_HIP=1 )
