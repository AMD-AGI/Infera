+#!/usr/bin/env python3
+# Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.
+# SPDX-License-Identifier: MIT
+"""Give GlmMoeDsaForCausalLMNextN its own fused_shared_experts_architecture.
+
+THE DEFECT. configs/model_config.py rewrites a GLM DSA draft's architecture to
+"GlmMoeDsaForCausalLMNextN". The shared-experts fusion gate
+(models/deepseek_v2.py, shared_experts_fusion_disable_reason) compares
+`hf_config.architectures[0] != cls.fused_shared_experts_architecture`, and the
+NextN class inherits DeepseekV3ForCausalLMNextN's value, so the compare never
+matches and the draft silently runs unfused while the target is fused. Every
+sibling NextN (deepseek_nextn.py, glm4_moe_lite_nextn.py) and the GLM DSA target
+(glm4_moe.py GlmMoeDsaForCausalLM) define it; only this class was missed.
+
+NOT a correctness cure: measured not to fix the AgentX empty-response failure.
+Record: glm52.mtp.nextn.fusion.fix.packup_20260918/ (README, EVIDENCE).
+It was carried by the proven infera-sglang:v0519-yihou-0917-nextnfix-hicache
+image; still absent upstream at v0.5.21 (9f5d8712, glm4_moe.py:1279).
+
+Signal that it took effect: the engine log prints the fusion-enabled line twice
+(target + draft) instead of once.
+
+Self-locating and idempotent; exits non-zero on anchor drift.
+"""
+
+import importlib.util
+import py_compile
+import sys
+from pathlib import Path
+
+_TAG = "[glm-nextn-fusion-arch]"
+_VALUE = 'fused_shared_experts_architecture = "GlmMoeDsaForCausalLMNextN"'
+_OLD = "class GlmMoeDsaForCausalLMNextN(DeepseekV3ForCausalLMNextN):\n"
+_NEW = (
+    _OLD
+    + "    # The loader rewrites the draft arch to this name, so the inherited\n"
+    + "    # DeepseekV3 value would never match and silently disable fusion.\n"
+    + f"    {_VALUE}\n"
+)
+
+
+def main() -> int:
+    spec = importlib.util.find_spec("sglang")
+    if not spec or not spec.origin:
+        print(f"{_TAG} cannot locate sglang")
+        return 1
+    path = Path(spec.origin).parent / "srt" / "models" / "glm4_moe.py"
+    src = path.read_text()
+    if _VALUE in src:
+        print(f"{_TAG} already present — skipping")
+        return 0
+    if src.count(_OLD) != 1:
+        print(f"{_TAG} anchor found {src.count(_OLD)}x, want 1x in {path} — nothing written")
+        return 1
+    path.write_text(src.replace(_OLD, _NEW, 1))
+    py_compile.compile(str(path), doraise=True)
+    print(f"{_TAG} GlmMoeDsaForCausalLMNextN now matches its own architecture name")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
