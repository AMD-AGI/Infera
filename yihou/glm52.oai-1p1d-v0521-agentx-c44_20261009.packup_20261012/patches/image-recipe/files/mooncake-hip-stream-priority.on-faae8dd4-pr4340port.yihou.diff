+// [yihou] MC_HIP_STREAM_PRIORITY=default|high (unset = default = upstream behaviour).
+// high: create the copy streams at the device's greatest stream priority. CLR keeps
+// separate normal/high HW-queue pools (GPU_MAX_HW_QUEUES each), so the copy streams no
+// longer share an AQL queue -- and its in-order barrier bit -- with the application's
+// normal-priority compute streams, and the HW queue runs at HSA_AMD_QUEUE_PRIORITY_HIGH.
+bool useHighPriorityStreams() {
+    static const bool high = [] {
+        const char *v = std::getenv("MC_HIP_STREAM_PRIORITY");
+        bool h = v != nullptr && std::strcmp(v, "high") == 0;
+        if (v != nullptr && !h && std::strcmp(v, "default") != 0) {
+            LOG(WARNING) << "StreamPool: ignoring MC_HIP_STREAM_PRIORITY=" << v
+                         << " (want default|high)";
+        }
+        return h;
+    }();
+    return high;
+}
+
+}  // namespace
