@@ -0,0 +1,45 @@
+// [MC_HIP_BATCH_KERNEL] One kernel copies a batch of (src, dst, len) entries.
+// Used by HipTransport::tryBatchKernelCopy instead of one hipMemcpyAsync per
+// entry: per-op launch/enqueue cost dominates for page-sized KV blocks.
+#include <hip/hip_runtime.h>
+
+#include <cstddef>
+#include <cstdint>
+
+namespace {
+constexpr int kThreads = 256;
+
+__global__ void __launch_bounds__(kThreads)
+    batch_copy_kernel(const uint64_t* __restrict__ src,
+                      const uint64_t* __restrict__ dst,
+                      const uint64_t* __restrict__ len, size_t n) {
+    for (size_t i = blockIdx.x; i < n; i += gridDim.x) {
+        const char* s = reinterpret_cast<const char*>(src[i]);
+        char* d = reinterpret_cast<char*>(dst[i]);
+        const uint64_t bytes = len[i];
+        if (((reinterpret_cast<uintptr_t>(s) | reinterpret_cast<uintptr_t>(d) |
+              bytes) & 15) == 0) {
+            const uint4* s4 = reinterpret_cast<const uint4*>(s);
+            uint4* d4 = reinterpret_cast<uint4*>(d);
+            for (uint64_t j = threadIdx.x; j < bytes / 16; j += kThreads)
+                d4[j] = s4[j];
+        } else {
+            for (uint64_t j = threadIdx.x; j < bytes; j += kThreads) d[j] = s[j];
+        }
+    }
+    // Peer stores must be visible system-wide before the completion event.
+    __threadfence_system();
+}
+}  // namespace
+
+extern "C" hipError_t mooncake_hip_batch_copy(const uint64_t* d_src,
+                                              const uint64_t* d_dst,
+                                              const uint64_t* d_len, size_t n,
+                                              int grid, hipStream_t stream) {
+    if (n == 0) return hipSuccess;
+    if (grid <= 0) grid = 256;
+    if ((size_t)grid > n) grid = (int)n;
+    hipLaunchKernelGGL(batch_copy_kernel, dim3(grid), dim3(kThreads), 0, stream,
+                       d_src, d_dst, d_len, n);
+    return hipGetLastError();
+}
