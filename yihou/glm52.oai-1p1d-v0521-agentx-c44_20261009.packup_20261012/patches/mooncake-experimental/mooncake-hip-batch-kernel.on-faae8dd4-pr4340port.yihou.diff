+namespace {
+struct BatchKernelConfig {
+    bool enabled = false;
+    size_t min_entries = 64;
+    int grid = 256;
+};
+const BatchKernelConfig& batchKernelConfig() {
+    static const BatchKernelConfig cfg = [] {
+        BatchKernelConfig c;
+        const char* e = getenv("MC_HIP_BATCH_KERNEL");
+        c.enabled = e && strcmp(e, "1") == 0;
+        if (const char* m = getenv("MC_HIP_BATCH_KERNEL_MIN")) {
+            long v = strtol(m, nullptr, 10);
+            if (v > 0) c.min_entries = (size_t)v;
+        }
+        if (const char* g = getenv("MC_HIP_BATCH_KERNEL_GRID")) {
+            long v = strtol(g, nullptr, 10);
+            if (v > 0 && v <= 65535) c.grid = (int)v;
+        }
+        if (c.enabled)
+            LOG(INFO) << "HipTransport: MC_HIP_BATCH_KERNEL on (min_entries="
+                      << c.min_entries << ", grid=" << c.grid << ")";
+        return c;
+    }();
+    return cfg;
+}
+
+// Per-thread device scratch for the (src, dst, len) arrays, grown on demand.
+struct BatchScratch {
+    int device = -1;
+    uint64_t* d_buf = nullptr;
+    size_t capacity = 0;  // entries
+    ~BatchScratch() {
+        if (d_buf) (void)hipFree(d_buf);
+    }
+};
+thread_local BatchScratch tls_batch_scratch;
+thread_local std::vector<uint64_t> tls_batch_host;
+}  // namespace
