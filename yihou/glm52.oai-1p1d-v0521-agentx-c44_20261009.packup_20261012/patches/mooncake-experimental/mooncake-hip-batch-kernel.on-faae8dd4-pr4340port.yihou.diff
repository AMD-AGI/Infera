+bool HipTransport::tryBatchKernelCopy(
+    const std::vector<std::pair<const TransferRequest*, TransferTask*>>& items,
+    Status& status) {
+    const auto& cfg = batchKernelConfig();
+    if (!cfg.enabled || items.size() < cfg.min_entries || use_fabric_mem_)
+        return false;
+    for (const auto& it : items) {
+        // WRITE to a peer segment only; reads / local copies keep the
+        // per-request path.
+        if (it.first->opcode != TransferRequest::WRITE ||
+            it.first->target_id == LOCAL_SEGMENT_ID || it.first->length == 0)
+            return false;
+    }
+
+    HipDeviceGuard device_guard;
+    int device_id = -1;
+    // One device context for the whole batch: the first and last sources must
+    // agree (sglang batches come from one KV pool on one device).
+    if (setDeviceContext(items.front().first->source, device_id) != 0)
+        return false;
+    int last_device = -1;
+    if (items.size() > 1) {
+        HipDeviceGuard probe_guard;
+        if (setDeviceContext(items.back().first->source, last_device) != 0 ||
+            last_device != device_id)
+            return false;
+    }
+
+    const size_t n = items.size();
+    auto& host = tls_batch_host;
+    host.resize(3 * n);
+    for (size_t i = 0; i < n; ++i) {
+        const auto& req = *items[i].first;
+        uint64_t dest_addr = req.target_offset;
+        if (relocateSharedMemoryAddress(dest_addr, req.length, req.target_id)) {
+            status = Status::Memory("device memory not registered");
+            return true;  // handled (failed); caller must not retry
+        }
+        host[i] = (uint64_t)req.source;
+        host[n + i] = dest_addr;
+        host[2 * n + i] = req.length;
+    }
+
+    auto& scratch = tls_batch_scratch;
+    if (scratch.device != device_id || scratch.capacity < n) {
+        if (scratch.d_buf) (void)hipFree(scratch.d_buf);
+        scratch.d_buf = nullptr;
+        scratch.capacity = 0;
+        size_t cap = n < 4096 ? 4096 : n;
+        if (!checkHip(hipMalloc((void**)&scratch.d_buf, 3 * cap * sizeof(uint64_t)),
+                      "HipTransport: batch scratch hipMalloc failed")) {
+            return false;  // fall back to the per-request path
+        }
+        scratch.device = device_id;
+        scratch.capacity = cap;
+    }
+
+    // Slices: same bookkeeping as startAsyncTransfer, one per request.
+    std::vector<Slice*> slices;
+    slices.reserve(n);
+    for (size_t i = 0; i < n; ++i) {
+        const auto& req = *items[i].first;
+        auto& task = *items[i].second;
+        task.total_bytes = req.length;
+        Slice* slice = getSliceCache().allocate();
+        slice->source_addr = (char*)req.source;
+        slice->local.dest_addr = (char*)host[n + i];  // relocated, as in startAsyncTransfer
+        slice->length = req.length;
+        slice->opcode = req.opcode;
+        slice->task = &task;
+        slice->target_id = req.target_id;
+        slice->status = Slice::PENDING;
+        task.slice_list.push_back(slice);
+        __sync_fetch_and_add(&task.slice_count, 1);
+        slices.push_back(slice);
+    }
+    auto fail_all = [&](const char* what) {
+        for (auto* sl : slices) sl->markFailed();
+        status = Status::Memory(what);
+        return true;
+    };
+
+    hipStream_t stream = stream_pool_.getNextStream(device_id);
+    hipEvent_t event = event_pool_.getEvent(device_id);
+    if (stream == nullptr || event == nullptr) {
+        if (event) event_pool_.putEvent(event, device_id);
+        return fail_all("HipTransport: no stream/event for batch kernel");
+    }
+    hipError_t err =
+        hipMemcpyAsync(scratch.d_buf, host.data(), 3 * n * sizeof(uint64_t),
+                       hipMemcpyHostToDevice, stream);
+    if (checkHip(err, "HipTransport: batch descriptor upload failed")) {
+        err = mooncake_hip_batch_copy(scratch.d_buf, scratch.d_buf + n,
+                                      scratch.d_buf + 2 * n, n, cfg.grid, stream);
+        checkHip(err, "HipTransport: batch copy kernel launch failed");
+    }
+    if (err == hipSuccess) err = hipEventRecord(event, stream);
+    if (err == hipSuccess) err = hipEventSynchronize(event);
+    event_pool_.putEvent(event, device_id);
+    if (err != hipSuccess) return fail_all("HipTransport: batch copy failed");
+    for (auto* sl : slices) sl->markSuccess();
+    status = Status::OK();
+    return true;
+}
