+    def _yihou_par_process_layers(self, process_layers, layers_params, executor) -> int:
+        """[yihou] YIHOU_XFER_PAR: run k contiguous layer groups concurrently on the
+        request's executor; drain ALL futures (no early return), first non-zero wins."""
+        k = min(_YIHOU_XFER_PAR, len(layers_params))
+        n = len(layers_params)
+        bounds = [(i * n) // k for i in range(k + 1)]
+        groups = [layers_params[bounds[i] : bounds[i + 1]] for i in range(k)]
+        shard = getattr(_yihou_xfer.tls, "shard", -1) if _yihou_xfer is not None else -1
+        walls = [0.0] * k
+
+        def run(i, group):
+            if _yihou_xfer is not None:
+                _yihou_xfer.tls.shard = shard
+            t0 = time.perf_counter()
+            try:
+                return process_layers(group)
+            finally:
+                walls[i] = time.perf_counter() - t0
+
+        t0 = time.perf_counter()
+        futures = [executor.submit(run, i, g) for i, g in enumerate(groups)]
+        concurrent.futures.wait(futures)
+        ret = 0
+        for f in futures:
+            try:
+                status = f.result()
+            except Exception as e:  # a raised group fails the chunk, like rc != 0
+                logger.error("YIHOU-XFER-PAR group raised: %r", e)
+                status = -1
+            if status != 0 and ret == 0:
+                ret = status
+        if _yihou_xfer is not None:
+            _yihou_xfer.par(shard, k, time.perf_counter() - t0, walls)
+        return ret
+
