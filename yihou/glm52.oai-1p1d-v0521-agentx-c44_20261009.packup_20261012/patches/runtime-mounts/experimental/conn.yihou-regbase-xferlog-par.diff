+class _YihouXferStats:
+    def __init__(self):
+        self.lock = threading.Lock()
+        self.tls = threading.local()
+        self.last = time.monotonic()
+        self.reset()
+
+    def reset(self):
+        self.d = {}  # shard -> dict of counters
+
+    def _s(self, shard):
+        return self.d.setdefault(
+            shard,
+            dict(enq=0, deq=0, wait_s=0.0, wait_max=0.0, calls=0, blocks=0,
+                 blocks_max=0, bytes=0, wall_s=0.0, wall_max=0.0, slow=None,
+                 par_k=0, par_reqs=0, par_wall_s=0.0, par_group_wall_s=0.0,
+                 par_group_wall_max=0.0),
+        )
+
+    def enq(self, shard):
+        with self.lock:
+            self._s(shard)["enq"] += 1
+
+    def deq(self, shard, wait_s):
+        self.tls.shard = shard
+        with self.lock:
+            s = self._s(shard)
+            s["deq"] += 1
+            s["wait_s"] += wait_s
+            s["wait_max"] = max(s["wait_max"], wait_s)
+
+    def par(self, shard, k, wall_s, group_walls):
+        with self.lock:
+            s = self._s(shard)
+            s["par_k"] = k
+            s["par_reqs"] += 1
+            s["par_wall_s"] += wall_s
+            s["par_group_wall_s"] += sum(group_walls)
+            s["par_group_wall_max"] = max([s["par_group_wall_max"], *group_walls])
+
+    def call(self, nblocks, nbytes, wall_s, session):
+        shard = getattr(self.tls, "shard", -1)
+        with self.lock:
+            s = self._s(shard)
+            s["calls"] += 1
+            s["blocks"] += nblocks
+            s["blocks_max"] = max(s["blocks_max"], nblocks)
+            s["bytes"] += nbytes
+            s["wall_s"] += wall_s
+            if wall_s > s["wall_max"]:
+                s["wall_max"] = wall_s
+                s["slow"] = (nblocks, nbytes, wall_s, session)
+            now = time.monotonic()
+            if now - self.last < 60.0:
+                return
+            span = now - self.last
+            self.last = now
