 logger = logging.getLogger(__name__)
 
+# [yihou] YIHOU_NONFINAL_EVENT -- mount patch (R036), not upstream. Selects the wait_event
+# handed to the mooncake transfer worker for an overlap-mode NON-FINAL chunk:
+#   orig   (default) identical to the image: event recorded on forward_stream inside
+#          process_batch_result(N). Under overlap batch N+1 is already launched, so it
+#          covers N's forward AND N+1's forward; the worker waits for both.
+#   launch event recorded on forward_stream right after run_batch(N). Covers everything
+#          enqueued on forward_stream through N's forward (the chunk's KV / DSA / draft
+#          writes), not N+1. Falls back to orig if the batch result carries no event.
+#   off    no event. Relies only on copy_done.synchronize() at the top of
+#          process_batch_result_disagg_prefill (copy_done is recorded after N's forward:
+#          on forward_stream on HIP, on copy_stream after wait_stream(forward_stream) else).
+# Logs YIHOU-NONFINAL once a minute: chunks per mode, fallbacks, and how many events
+# were already complete when handed over (query() at send time).
+import os as _yihou_os
+import time as _yihou_time
+
+_YIHOU_NONFINAL_EVENT = _yihou_os.environ.get("YIHOU_NONFINAL_EVENT", "orig").strip()
+if _YIHOU_NONFINAL_EVENT not in ("orig", "launch", "off"):
+    raise ValueError(
+        f"YIHOU_NONFINAL_EVENT={_YIHOU_NONFINAL_EVENT!r} (want orig|launch|off)"
+    )
+
+
+class _YihouNonfinalStats:
+    def __init__(self):
+        self.last = _yihou_time.monotonic()
+        self.n = self.fallback = self.done_at_send = 0
+
+    def note(self, ev, fallback=False):
+        self.n += 1
+        self.fallback += int(fallback)
+        if ev is not None and ev.query():
+            self.done_at_send += 1
+        now = _yihou_time.monotonic()
+        if now - self.last >= 60.0:
+            logger.info(
+                "YIHOU-NONFINAL mode=%s span=%.0fs nonfinal_chunks=%d fallback=%d "
+                "event_done_at_send=%d",
+                _YIHOU_NONFINAL_EVENT, now - self.last, self.n, self.fallback,
+                self.done_at_send,
+            )
+            self.last = now
+            self.n = self.fallback = self.done_at_send = 0
+
+
+_yihou_nonfinal_stats = _YihouNonfinalStats()
+logger.info("YIHOU-NONFINAL mode=%s (import)", _YIHOU_NONFINAL_EVENT)
+
 # TP=1 yield between polls of a pending result. An initial heuristic rather
 # than a tuned value: long enough that the bootstrap, transfer and cache
 # threads reliably win the GIL even when the input socket is empty, and far
