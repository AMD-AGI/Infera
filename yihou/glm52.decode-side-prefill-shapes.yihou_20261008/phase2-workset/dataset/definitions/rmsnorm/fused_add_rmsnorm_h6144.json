  "reference": "import torch\n\n\n@torch.no_grad()\ndef run(hidden_states, residual, weight):\n    x = hidden_states.float() + residual.float()\n    y = x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + 1e-5) * weight.float()\n    return y.to(hidden_states.dtype)\n"
