CFG_SOURCE='e7-pd-mooncake-1p1d-dp2 role p <- r1-dp2-c128 (CI row 448240) + PD changes 1-10 above; router per IX #5090 / srt-slurm#669'
IMAGE='vllm/vllm-openai-rocm:nightly-60bd6dd2edd175a1c55fd3488f871e4c3d2ef27d@sha256:67a3a0fb79893fc5a0fcff5f9b739ba8fec7e920875a12e0574c2e9f50cd814c'
IPC=host
CONCURRENCY=128
BENCH_TP=4
DP_SIZE=2
UMBP_ENABLE=0
CFG_ID=e7-pd-mooncake-1p1d-dp2-p
PD_ROLE=prefill
ENGINE_ENABLE=1
GPUS_NEEDED=2
GPU_SELECT=device-ids
DOCKER_RDMA=1
DOCKER_IONIC_PROVIDER=0
PORT=6100
VLLM_PORT=20000
NIXL_PORT=5400
KV_EVENT_PORT=3000
ROUTER_ENABLE=0
PD_BOOTSTRAP_PORT=8998
VLLM_ENV=(
  'AITER_TRITON_LOG_LEVEL=ERROR'
  'DYN_VLLM_KV_EVENT_PORT=@KV_EVENT_PORT@'
  'HEAD_NODE_IP=@NODE_IP@'
  'OMP_NUM_THREADS=1'
  'PYTHONUNBUFFERED=1'
  'ROUTER_VERSION=0.1.14'
  'VLLM_NIXL_SIDE_CHANNEL_HOST=@NODE_IP@'
  'VLLM_NIXL_SIDE_CHANNEL_PORT=@NIXL_PORT@'
  'VLLM_PORT=@VLLM_PORT@'
  'VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=NONE'
  'VLLM_ROCM_USE_AITER=1'
  'VLLM_ROCM_USE_AITER_MOE=1'
  'VLLM_ROCM_USE_AITER_TRITON_SPARSE_MLA=True'
  'VLLM_USE_BREAKABLE_CUDAGRAPH=1'
  'VLLM_USE_RUST_FRONTEND=1'
  'VLLM_HOST_IP=@NODE_IP@'
  'VLLM_MOONCAKE_CONNECTOR_TIMEOUT=600'
  'PYTHONHASHSEED=0'
  'HSA_ENABLE_IPC_MODE_LEGACY=1'
  'MC_MAX_CONCURRENT_REG_MR=1'
  'VLLM_HTTP_TIMEOUT_KEEP_ALIVE=3600'
  'VLLM_MOONCAKE_BOOTSTRAP_PORT=8998'
)
VLLM_CMD=(
  'vllm'
  'serve'
  '@MODEL@'
  '--host'
  '0.0.0.0'
  '--port'
  '@PORT@'
  '--device-ids'
  '@DEVICE_IDS@'
  '--attention-config'
  '{"indexer_kv_dtype":"mxfp4","indexer_sparse_logits":true}'
  '--block-size'
  '128'
  '--data-parallel-size'
  '2'
  '--data-parallel-rpc-port'
  '29550'
  '--disable-uvicorn-access-log'
  '--enable-auto-tool-choice'
  '--engram-config'
  '{"cpu_offload":true}'
  '--gpu-memory-utilization'
  '0.9'
  '--kv-cache-dtype'
  'fp8_ds_mla'
  '--kv-transfer-config'
  '{"kv_connector":"MooncakeConnector","kv_role":"kv_producer","kv_load_failure_policy":"fail","kv_connector_extra_config":{"mooncake_protocol":"rdma","device_name":"","num_workers":10}}'
  '--language-model-only'
  '--max-cudagraph-capture-size'
  '1024'
  '--max-model-len'
  '1048576'
  '--max-num-batched-tokens'
  '16384'
  '--moe-backend'
  'aiter'
  '--prefill-schedule-interval'
  '11'
  '--reasoning-parser'
  'deepseek_v41'
  '--served-model-name'
  'deepseek-ai/DeepSeek-V4.1-Flash'
  '--speculative-config'
  '{"method": "dspark", "num_speculative_tokens": 5, "draft_sample_method": "probabilistic", "rejection_sample_method": "synthetic", "enable_adaptive_verification": false, "synthetic_acceptance_length": 3.51}'
  '--tensor-parallel-size'
  '1'
  '--tokenizer-mode'
  'deepseek_v41'
  '--tool-call-parser'
  'deepseek_v41'
)
