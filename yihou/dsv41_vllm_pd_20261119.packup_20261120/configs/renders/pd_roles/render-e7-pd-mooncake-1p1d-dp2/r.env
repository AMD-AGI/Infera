  '3600'
  '--policy'
  'consistent_hash'
  '--prefill-policy'
  'consistent_hash'
  '--decode-policy'
  'consistent_hash'
  '--prometheus-host'
  '127.0.0.1'
  '--prometheus-port'
  '@ROUTER_PROM_PORT@'
  '--request-timeout-secs'
