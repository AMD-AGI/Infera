# shellcheck shell=bash disable=SC2034
# Config r4-tp2-c32 -- vLLM TP2 c32, CI-exact recipe of InferenceX CI job 114309765517 (107,989 tok/s/GPU).
# SOURCE (verbatim args + env):
#   /perf_apps/chaox/DeepSeek_V4.1_Flash/conc32/official_ci/server_logs/x/config_tp2_c32.yaml   (CI srtctl recipe)
#   cross-checked with the live "non-default args" line of the chaox repro (107,583):
#   /perf_apps/chaox/DeepSeek_V4.1_Flash/conc32/baseline/server.log, and baseline/launch_server.sh (HIP_VISIBLE_DEVICES).
# NOTE (first-hand): this recipe has max-num-batched-tokens 16384 and NO max-num-seqs. The "max-num-seqs 8,
#   max-num-batched-tokens 8192" c32 point is the LATER InferenceX agentic.yaml override_tp2_c32 (db3fc796) -> see
#   r4-tp2-c32-s8.env. Image has no digest in the CI artifacts (tag only; tag availability on Docker Hub unverified).
# REVIEW 2026-11-19: argv/env now token-identical to the CI launch record (/perf_apps/chaox/DeepSeek_V4.1_Flash/conc32/official_ci/server_logs/x/logs/sweep_48308.log:119-120)
#   incl. --device-ids and the srtctl-injected env (HEAD_NODE_IP, DYN_VLLM_KV_EVENT_PORT=5200, VLLM_NIXL_SIDE_CHANNEL_*,
#   VLLM_PORT); the pre-review version used HIP_VISIBLE_DEVICES like chaox launch_server.sh (debug/review/*.pre-review).
# Sourced by scripts/kit/serve.sh. Tokens @X@ are substituted at render time.
CFG_ID=r4-tp2-c32
CFG_SOURCE="/perf_apps/chaox/DeepSeek_V4.1_Flash/conc32/official_ci/server_logs/x/config_tp2_c32.yaml"
IMAGE="vllm/vllm-openai-rocm:nightly-rocm100-7d0b4e57aac4c4323225b0eee9ae960ce75ffffe"
GPUS_NEEDED=2
GPU_SELECT=device-ids           # CI: --device-ids 0,1 (sweep_48308.log:120); all node GPUs visible in the container
IPC=host
DOCKER_RDMA=0
CONCURRENCY=32
BENCH_TP=2                      # harness TP env = GPU denominator (CI TP: '2')
PORT=8000                       # client endpoint (no router)
DP_SIZE=1
VLLM_PORT=20000                 # srtctl-injected worker env (CI)
NIXL_PORT=5400                  # srtctl-injected worker env (CI)
KV_EVENT_PORT=5200              # srtctl-injected worker env (CI r4: 5200, not 3000)

VLLM_ENV=(
  AITER_TRITON_LOG_LEVEL=ERROR
  DYN_VLLM_KV_EVENT_PORT=@KV_EVENT_PORT@
  HEAD_NODE_IP=@NODE_IP@
  OMP_NUM_THREADS=1
  PYTHONUNBUFFERED=1
  VLLM_ENGINE_READY_TIMEOUT_S=3600
  VLLM_NIXL_SIDE_CHANNEL_HOST=@NODE_IP@
  VLLM_NIXL_SIDE_CHANNEL_PORT=@NIXL_PORT@
  VLLM_PORT=@VLLM_PORT@
  VLLM_ROCM_MONO_DECODE=1
  VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=INT4
  VLLM_ROCM_USE_AITER=1
  VLLM_ROCM_USE_AITER_MOE=1
  VLLM_ROCM_USE_AITER_TRITON_SPARSE_MLA=True
  VLLM_USE_BREAKABLE_CUDAGRAPH=1
  VLLM_USE_RUST_FRONTEND=1
)
VLLM_CMD=(
  vllm serve @MODEL@ --host 0.0.0.0 --port @PORT@ --device-ids @DEVICE_IDS@
  --attention-config '{"indexer_kv_dtype":"mxfp4","indexer_sparse_logits":true}'
  --block-size 128
  --disable-uvicorn-access-log
  --enable-auto-tool-choice
  --engram-config '{"cpu_offload":true}'
  --gpu-memory-utilization 0.9
  --language-model-only
  --max-cudagraph-capture-size 1024
  --max-model-len 1048576
  --max-num-batched-tokens 16384
  --moe-backend aiter
  --no-swa-bounded-replay
  --reasoning-parser deepseek_v41
  --served-model-name deepseek-ai/DeepSeek-V4.1-Flash
  --speculative-config '{"method": "dspark", "num_speculative_tokens": 5, "draft_sample_method": "probabilistic", "rejection_sample_method": "synthetic", "enable_adaptive_verification": false, "synthetic_acceptance_length": 3.51}'
  --tensor-parallel-size 2
  --tokenizer-mode deepseek_v41
  --tool-call-parser deepseek_v41
)
ROUTER_ENABLE=0
UMBP_ENABLE=0
