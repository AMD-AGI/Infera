# shellcheck shell=bash disable=SC2034
# Config e7s-pd-mooncake-1p1d-dp2-smoke -- E7 CORRECTNESS SMOKE variant of e7-pd-mooncake-1p1d-dp2 (not a perf point).
# = e7 (sourced below, so every PD flag stays in one place) with ONE change on BOTH roles: rejection_sample_method "standard"
#   instead of "synthetic" (synthetic accepts drafts at a calibrated random rate regardless of the target,
#   V/vllm/config/speculative.py:655-677 -> greedy outputs are not comparable). Default "standard" = speculative.py:656.
#   Draft layers / num_speculative_tokens unchanged, so the KV-cache group set (target + DSpark draft SWA groups) that Mooncake
#   moves is the same as in e7 (g3 s1). Reference server: configs/e7r-colo-dsmla-ref-smoke.env (same spec change).
#   UNVERIFIED: that DSpark + "standard" rejection starts on this ROCm image; fallback in PD_README (drop the spec config on
#   P, D and reference together).
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/e7-pd-mooncake-1p1d-dp2.env"
CFG_ID=e7s-pd-mooncake-1p1d-dp2-smoke
CFG_SOURCE="e7-pd-mooncake-1p1d-dp2 with rejection_sample_method standard on P and D (pd_smoke); e7 = $CFG_SOURCE"
SPEC_CONFIG='{"method": "dspark", "num_speculative_tokens": 5, "draft_sample_method": "probabilistic", "rejection_sample_method": "standard", "enable_adaptive_verification": false}'
