# shellcheck shell=bash disable=SC2034
# Config r2-dp2-umbp-c384 -- vLLM TP1 x DP2 + UMBP standalone host-DRAM KV tier, c384 (427,451 tok/s/GPU, CI row 448242,
#   2026-11-18, InferenceX PR #5036, run 43861172833 attempt 2).
# SOURCE (verbatim: service/worker/frontend argv + env, image@digest):
#   notes/ix/reproduce_448242.json  (= GET https://inferencex.semianalysis.com/api/v1/reproduce?id=448242)
#     .logs.launch.steps[] (umbp-server service, agg worker, vllm-router frontend), .logs.config_files[] (config.yaml:
#     services.umbp-server.env, container_mounts /dev/shm:/umbp-host, environment ROUTER_VERSION=0.1.14, setup_script vllm-router.sh)
#   source/InferenceX/inferencex-e2e/benchmarks/single_node/srt-slurm-recipes/dsv41flash/vllm/mi355x-fp4-mtp/agentic.yaml:288-360
#   source/InferenceX/inferencex-e2e/benchmarks/multi_node/srt-slurm-recipes/configs/vllm-router.sh (pip install vllm-router==$ROUTER_VERSION)
# Kit deviations (infra only, flags untouched): model path /models/DeepSeek-V4.1-Flash instead of HF id; /umbp-host is a node-local
#   per-tag dir (CI mounted host /dev/shm there "so both srtctl steps see the socket"; we run all three processes in ONE container);
#   HEAD_NODE_IP / VLLM_NIXL_SIDE_CHANNEL_HOST / router --worker-urls use this node's IP (srtctl-injected values in CI).
CFG_ID=r2-dp2-umbp-c384
CFG_SOURCE="notes/ix/reproduce_448242.json (row 448242) + InferenceX db3fc796 agentic.yaml override_dp2_umbp_c384"
IMAGE="vllm/vllm-openai-rocm:nightly-60bd6dd2edd175a1c55fd3488f871e4c3d2ef27d@sha256:67a3a0fb79893fc5a0fcff5f9b739ba8fec7e920875a12e0574c2e9f50cd814c"
GPUS_NEEDED=2
GPU_SELECT=device-ids           # CI: --device-ids 0,1 (srtctl); all node GPUs visible in the container
IPC=host
DOCKER_RDMA=0
CONCURRENCY=384
BENCH_TP=2                      # CI benchmark env TP: '2' (= total GPUs of the DP2 server)
PORT=6100                       # engine (metrics: http://<node>:@PORT@/metrics)
DP_SIZE=2
VLLM_PORT=20000                 # srtctl-injected worker env (CI)
NIXL_PORT=5400                  # srtctl-injected worker env (CI)
KV_EVENT_PORT=3000              # srtctl-injected worker env (CI)

VLLM_ENV=(
  AITER_TRITON_LOG_LEVEL=ERROR
  DYN_VLLM_KV_EVENT_PORT=@KV_EVENT_PORT@
  HEAD_NODE_IP=@NODE_IP@
  OMP_NUM_THREADS=1
  PYTHONUNBUFFERED=1
  ROUTER_VERSION=0.1.14
  VLLM_NIXL_SIDE_CHANNEL_HOST=@NODE_IP@
  VLLM_NIXL_SIDE_CHANNEL_PORT=@NIXL_PORT@
  VLLM_PORT=@VLLM_PORT@
  VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=NONE
  VLLM_ROCM_USE_AITER=1
  VLLM_ROCM_USE_AITER_MOE=1
  VLLM_ROCM_USE_AITER_TRITON_SPARSE_MLA=True
  VLLM_USE_BREAKABLE_CUDAGRAPH=1
  VLLM_USE_RUST_FRONTEND=1
)
VLLM_CMD=(
  vllm serve @MODEL@ --host 0.0.0.0 --port @PORT@ --device-ids @DEVICE_IDS@
  --attention-config '{"indexer_kv_dtype":"mxfp4","indexer_sparse_logits":true}'
  --block-size 128
  --data-parallel-size 2
  --disable-uvicorn-access-log
  --enable-auto-tool-choice
  --engram-config '{"cpu_offload":true}'
  --gpu-memory-utilization 0.9
  --kv-cache-dtype fp8_e4m3
  --kv-transfer-config '{"kv_connector":"UMBPStoreConnector","kv_role":"kv_both","kv_load_failure_policy":"recompute","kv_connector_extra_config":{"mode":"standalone","endpoint":"unix:///umbp-host/umbp/standalone.grpc.sock"}}'
  --language-model-only
  --max-cudagraph-capture-size 1024
  --max-model-len 1048576
  --max-num-batched-tokens 16384
  --moe-backend aiter
  --prefill-schedule-interval 11
  --reasoning-parser deepseek_v41
  --served-model-name deepseek-ai/DeepSeek-V4.1-Flash
  --speculative-config '{"method": "dspark", "num_speculative_tokens": 5, "draft_sample_method": "probabilistic", "rejection_sample_method": "synthetic", "enable_adaptive_verification": false, "synthetic_acceptance_length": 3.51}'
  --tensor-parallel-size 1
  --tokenizer-mode deepseek_v41
  --tool-call-parser deepseek_v41
)

ROUTER_ENABLE=1
ROUTER_VERSION=0.1.14           # CI: pip install vllm-router==0.1.14 into the image at setup (vllm-router.sh)
ROUTER_PORT=8000                # client endpoint
ROUTER_PROM_PORT=18000
ROUTER_CMD=(
  vllm-router --worker-urls http://@NODE_IP@:@PORT@ --host 0.0.0.0 --port @ROUTER_PORT@
  --intra-node-data-parallel-size 2 --worker-startup-timeout-secs 3600 --policy consistent_hash
  --prometheus-host 127.0.0.1 --prometheus-port @ROUTER_PROM_PORT@ --request-timeout-secs 14400 --disable-retries
)

UMBP_ENABLE=1
UMBP_ENV=(
  UMBP_STANDALONE_ADDRESS=unix:///umbp-host/umbp/standalone.grpc.sock
  UMBP_DRAM_CAPACITY=449000000000
  UMBP_DRAM_USE_HUGEPAGES=0
  UMBP_SSD_ENABLED=0
  MORI_UMBP_LOG_LEVEL=INFO
)
UMBP_PREAMBLE='mkdir -p /umbp-host/umbp'
UMBP_CMD=(
  bash -c 'P=$(python3 -c '"'"'import mori, os; print(os.path.dirname(mori.__file__))'"'"') && LD_LIBRARY_PATH=$P:$LD_LIBRARY_PATH exec $P/umbp_standalone_server unix:///umbp-host/umbp/standalone.grpc.sock'
)
UMBP_READY_PATTERN='\[StandaloneServer\] listening'
UMBP_READY_TIMEOUT_S=1800       # CI: "Faulting in a ~450 GB pool on 4 KiB pages takes several minutes"
UMBP_HOST_DRAM_GB=449           # CI TOTAL_CPU_DRAM_GB for the 2-GPU share

# ---- appended by serve.sh: effective values for this tag (port-offset 20) ----
PORT=6120
ROUTER_PORT=8020
ROUTER_PROM_PORT=18020
VLLM_PORT=20020
NIXL_PORT=5420
KV_EVENT_PORT=3020
KIT_PORT_OFFSET=20
KIT_GPU_LIST=4,5
KIT_NODE_IP=192.168.3.72
