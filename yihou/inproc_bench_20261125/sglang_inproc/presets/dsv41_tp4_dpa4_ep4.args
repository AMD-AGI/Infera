--trust-remote-code --tensor-parallel-size 4 --data-parallel-size 4 --enable-dp-attention --expert-parallel-size 4
--enable-dp-lm-head --enable-dp-attention-local-control-broadcast --enforce-shared-experts-fusion --fp8-gemm-backend aiter
--mem-fraction-static 0.85 --chunked-prefill-size 65536 --cuda-graph-backend-prefill disabled
--enable-decoder-swa-bounded-replay --swa-prefix-tails 12288
