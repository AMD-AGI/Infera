+copied_back=0
+copy_back() {
+    # NODE_RW_ROOT: copy the node-local client output back (base64: the spur shim mangles
+    # binary stdout). Runs on success and, via record_exit, on failure too.
+    [[ -n "$node_rw" && "$copied_back" == 0 ]] || return 0
+    copied_back=1
+    ssh_run "$CONTROL_NODE" bash -c "tar -C $(printf '%q' "$client_out") -cf - . | base64 -w0" |
+        base64 -d | tar -C "$OUT_DIR" -xf - ||
+        echo "copy-back of $client_out from $CONTROL_NODE failed" >&2
+}
