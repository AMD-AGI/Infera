+    """Request positions -> KV slots, as the fused paged top-k emits them."""
+    p = pos.to(torch.int64)
+    safe = p.clamp(min=0)
+    pages = real_page_table.to(torch.int64).gather(1, safe // page)
+    slots = pages * page + safe % page
+    return torch.where(p >= 0, slots, torch.full_like(slots, -1)).to(torch.int32)
+
