+            local_logits, (0, topk - local_logits.shape[1]), value=-float("inf")
+        )
+    local_idx = local_topk_fn(local_logits, local_lens, topk)
+    pack = pack_fn(local_logits, local_idx, local_lens, topk, page, w, r)
+    return merge_fn(all_gather_fn(pack), w, topk)
