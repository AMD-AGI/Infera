+    expected = entry.get("arguments", {})
+    if not isinstance(expected, str):
+        try:
+            expected = json.dumps(expected, ensure_ascii=False)
+        except (TypeError, ValueError):
+            return ""
+    if not expected.startswith(streamed):
+        return ""
+    return expected[len(streamed) :]
