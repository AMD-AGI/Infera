new file mode 100644
index 0000000000..36f576248a
--- /dev/null
+++ b/test/registered/unit/test_dsa_dcp_split_indexer.py
@@ -0,0 +1,165 @@
+"""Page-split DSA decode indexer under DCP: the merged top-k must equal the
+top-k a single rank computes over the whole replicated index K."""
+
+import unittest
+
+import torch
+
+from sglang.srt.layers.attention.dsa.dsa_dcp_split_indexer import (
+    OwnedInputsCache,
+    owned_inputs,
+    owned_lens,
+    owned_page_table,
+    positions_to_slots,
+    split_decode_topk,
+)
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cpu_ci(est_time=10, suite="base-a-test-cpu")
+
+
+def _local_topk(logits, lens, k):
+    """Column indices of the top-k among the first ``lens`` columns, -1 padded."""
+    cols = torch.arange(logits.shape[1]).view(1, -1)
+    masked = torch.where(cols < lens.view(-1, 1).long(), logits, -float("inf"))
+    best, idx = torch.topk(masked, k, dim=1)
+    return torch.where(best > -float("inf"), idx, torch.full_like(idx, -1))
+
+
+def _split(scores, lens, page, topk, w, garbage=1e9):
+    """Run every rank of the split on a [rows, positions] score matrix."""
+    rows, n_pos = scores.shape
+    n_pages = -(-n_pos // page)
+    # Arbitrary physical page ids; the scores are keyed by request position.
+    block_tables = torch.randperm(4 * n_pages + 3)[:n_pages].repeat(rows, 1)
+
+    packs = {}
+
+    def run(r, gather):
+        def logits_fn(tables, local_lens, max_len):
+            out = torch.full((rows, max_len), garbage)
+            for c in range(max_len):
+                gpos = ((c // page) * w + r) * page + c % page
+                if gpos < n_pos:
+                    out[:, c] = scores[:, gpos]
+            return out
+
+        return split_decode_topk(
+            block_tables=block_tables,
+            lens=lens,
+            page=page,
+            topk=topk,
+            w=w,
+            r=r,
+            logits_fn=logits_fn,
+            local_topk_fn=_local_topk,
+            all_gather_fn=gather,
+        )
+
+    # Pass 1 collects every rank's pack; pass 2 merges the gathered packs.
+    for r in range(w):
+
+        def collect(pack, r=r):
+            packs[r] = pack
+            return torch.cat([pack] * w, dim=0)
+
+        run(r, collect)
+    gathered = torch.cat([packs[r] for r in range(w)], dim=0)
+    return [run(r, lambda _pack: gathered) for r in range(w)], block_tables
+
+
+class TestDcpSplitDecodeIndexer(CustomTestCase):
+    def _check(self, scores, lens, page, topk, w):
+        results, _ = _split(scores, lens, page, topk, w)
+        for r in range(1, w):
+            self.assertTrue(torch.equal(results[0], results[r]), "ranks disagree")
+        got = results[0]
+        for row in range(scores.shape[0]):
+            n = int(lens[row])
+            want = torch.sort(scores[row, :n], descending=True).values[: min(topk, n)]
+            sel = got[row][got[row] >= 0]
+            self.assertEqual(sel.numel(), min(topk, n), f"row {row} count")
+            self.assertEqual(sel.unique().numel(), sel.numel(), f"row {row} dup")
+            self.assertTrue(bool((sel < n).all()), f"row {row} past length")
+            # Equal score multisets: exact up to the order of tied scores.
+            got_scores = torch.sort(scores[row, sel.long()], descending=True).values
+            self.assertTrue(torch.equal(got_scores, want), f"row {row} scores")
+
+    def test_random_scores_partial_pages(self):
+        torch.manual_seed(0)
+        page, topk, w = 4, 16, 4
+        lens = torch.tensor([0, 1, 3, 4, 5, 15, 16, 17, 31, 63, 64, 65, 100, 129])
+        scores = torch.randn(lens.numel(), 140)
+        self._check(scores, lens, page, topk, w)
+
+    def test_ties(self):
+        torch.manual_seed(1)
+        page, topk, w = 4, 8, 4
+        lens = torch.tensor([7, 33, 50, 97])
+        scores = torch.randint(0, 3, (4, 100)).float()
+        self._check(scores, lens, page, topk, w)
+
+    def test_mtp_verify_rows(self):
+        # Six verify rows per request: causal lengths seq_len - 5 .. seq_len.
+        torch.manual_seed(2)
+        page, topk, w = 8, 32, 4
+        lens = torch.cat([torch.arange(s - 5, s + 1) for s in (40, 77, 300)])
+        scores = torch.randn(lens.numel(), 320)
+        self._check(scores, lens, page, topk, w)
+
+    def test_owned_lens_partition(self):
+        page, w = 64, 4
+        lens = torch.arange(0, 2000, 7)
+        total = sum(owned_lens(lens, page, w, r).long() for r in range(w))
+        self.assertTrue(torch.equal(total, lens))
+
+    def test_positions_to_slots_matches_fused_contract(self):
+        page = 4
+        table = torch.tensor([[7, 2, 9], [1, 0, 5]])
+        pos = torch.tensor([[0, 5, 11, -1], [3, 4, -1, 8]])
+        slots = positions_to_slots(pos, table, page)
+        want = torch.tensor([[28, 9, 39, -1], [7, 0, -1, 20]], dtype=torch.int32)
+        self.assertTrue(torch.equal(slots, want))
+
+
+class TestOwnedInputsPerForward(CustomTestCase):
+    """The owned page table and lens are computed once per forward and reused by
+    later indexer layers, but never carried into the next forward."""
+
+    def _call(self, cache, metadata, layer_id, tables, lens):
+        return owned_inputs(
+            cache,
+            metadata=metadata,
+            layer_id=layer_id,
+            block_tables=tables,
+            lens=lens,
+            page=4,
+            w=4,
+            r=1,
+        )
+
+    def test_reuse_within_forward_recompute_across(self):
+        tables = torch.arange(3 * 9, dtype=torch.int32).view(3, 9)
+        lens = torch.tensor([5, 17, 33], dtype=torch.int32)
+        meta, cache = object(), OwnedInputsCache()
+        first = self._call(cache, meta, 0, tables, lens)
+        self.assertTrue(torch.equal(first[0], owned_page_table(tables, 4, 1)))
+        self.assertTrue(torch.equal(first[1], owned_lens(lens, 4, 4, 1)))
+        # A slice of the same storage, as each layer passes, still hits.
+        again = self._call(cache, meta, 6, tables[:3], lens[:3])
+        self.assertIs(again[0], first[0])
+        # Non-increasing layer id: the next forward (e.g. the next draft step on
+        # the same metadata object) recomputes from the updated lens.
+        lens.add_(1)
+        nxt = self._call(cache, meta, 6, tables, lens)
+        self.assertIsNot(nxt[0], first[0])
+        self.assertTrue(torch.equal(nxt[1], owned_lens(lens, 4, 4, 1)))
+        # Another forward's metadata, or different rows, recomputes too.
+        self.assertIsNot(self._call(cache, object(), 10, tables, lens)[0], nxt[0])
+        other = self._call(cache, meta, 20, tables[:2], lens[:2])
+        self.assertEqual(other[0].shape[0], 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/test/registered/unit/test_dsa_dcp_split_indexer_triton.py b/test/registered/unit/test_dsa_dcp_split_indexer_triton.py
new file mode 100644
index 0000000000..5e1701e2aa
--- /dev/null
+++ b/test/registered/unit/test_dsa_dcp_split_indexer_triton.py
@@ -0,0 +1,180 @@
+"""The Triton pack/merge of the page-split DCP decode indexer must match the
+torch reference (pack_candidates, merge_candidates, positions_to_slots): the pack
+bit for bit, the merge as the same per-row set (it does not sort), including
+invalid lanes, partial rows and the -1 padding. Runs the kernels
+in the Triton interpreter on CPU."""
+
+import os
+import subprocess
+import sys
+import unittest
+
+# The interpreter only takes effect for @triton.jit functions created after it is
+# set, including triton.language's own (tl.sort); if triton is already loaded in
+# this process, the kernel cases re-run this file in a fresh one instead.
+_FRESH_TRITON = "triton" not in sys.modules
+os.environ["TRITON_INTERPRET"] = "1"
+
+import torch  # noqa: E402
+
+from sglang.srt.layers.attention.dsa.dsa_dcp_split_indexer import (  # noqa: E402
+    merge_candidates,
+    pack_candidates,
+    positions_to_slots,
+    split_decode_topk,
+)
+from sglang.srt.layers.attention.dsa.dsa_dcp_split_indexer_triton import (  # noqa: E402
+    merge_candidates_triton,
+    pack_candidates_triton,
+)
+from sglang.test.ci.ci_register import register_cpu_ci  # noqa: E402
+from sglang.test.test_utils import CustomTestCase  # noqa: E402
+
+register_cpu_ci(est_time=60, suite="base-a-test-cpu")
+
+
+def _distinct_scores(*shape, seed):
+    g = torch.Generator().manual_seed(seed)
+    n = 1
+    for d in shape:
+        n *= d
+    return (torch.randperm(n, generator=g).float() / n - 0.5).view(*shape)
+
+
+def _local_case(rows, width, topk, seed):
+    """Local logits, a local top-k (with -1 and out-of-length lanes), lens."""
+    g = torch.Generator().manual_seed(seed)
+    logits = _distinct_scores(rows, width, seed=seed)
+    lens = torch.randint(0, width + 1, (rows,), generator=g, dtype=torch.int32)
+    lens[0] = width  # a full row
+    lens[1] = 0  # an empty row
+    idx = torch.randint(0, width, (rows, topk), generator=g, dtype=torch.int32)
+    idx[torch.rand(rows, topk, generator=g) < 0.2] = -1
+    return logits, idx, lens
+
+
+_needs_fresh = unittest.skipUnless(
+    _FRESH_TRITON, "triton loaded before the interpreter"
+)
+
+
+@_needs_fresh
+class TestPackTriton(CustomTestCase):
+    def test_matches_reference(self):
+        for page, w, r in ((64, 4, 0), (64, 4, 3), (16, 2, 1)):
+            logits, idx, lens = _local_case(rows=5, width=192, topk=96, seed=r)
+            ref = pack_candidates(logits, idx, lens, 96, page, w, r)
+            out = pack_candidates_triton(logits, idx, lens, 96, page, w, r)
+            self.assertTrue(torch.equal(out, ref), f"{page=} {w=} {r=}")
+
+    def test_padded_logits_view(self):
+        # The aiter logits are a row-padded view; only stride(1) == 1 is assumed.
+        logits, idx, lens = _local_case(rows=3, width=128, topk=64, seed=7)
+        padded = torch.full((3, 160), 9.0)
+        padded[:, :128] = logits
+        view = padded[:, :128]
+        ref = pack_candidates(logits, idx, lens, 64, 64, 4, 1)
+        out = pack_candidates_triton(view, idx, lens, 64, 64, 4, 1)
+        self.assertTrue(torch.equal(out, ref))
+
+
+def _same_rows(a, b):
+    """Equal as per-row multisets: the merge keeps candidate order, not score order."""
+    a, b = a.to(torch.int32), b.to(torch.int32)
+    return a.shape == b.shape and torch.equal(
+        a.sort(dim=1).values, b.sort(dim=1).values
+    )
+
+
+def _gathered(rows, topk, w, n_pos, seed):
+    """Per-rank packs with distinct scores, some -inf lanes and -1 positions."""
+    g = torch.Generator().manual_seed(seed)
+    scores = _distinct_scores(w, rows, topk, seed=seed)
+    scores[torch.rand(w, rows, topk, generator=g) < 0.3] = -float("inf")
+    pos = torch.randint(0, n_pos, (w, rows, topk), generator=g, dtype=torch.int32)
+    pos[scores == -float("inf")] = -1
+    packs = torch.empty((w, 2, rows, topk), dtype=torch.int32)
+    packs[:, 0] = scores.view(torch.int32)
+    packs[:, 1] = pos
+    return packs.view(w * 2, rows, topk)
+
+
+@_needs_fresh
+class TestMergeTriton(CustomTestCase):
+    def test_positions_match_reference(self):
+        for w, topk in ((4, 64), (2, 32), (3, 16)):  # w * topk not a power of 2 too
+            gathered = _gathered(rows=4, topk=topk, w=w, n_pos=1000, seed=w)
+            ref = merge_candidates(gathered, w, topk)
+            out = merge_candidates_triton(gathered, w, topk)
