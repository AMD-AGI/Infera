@@ -0,0 +1,189 @@
+"""Split the DSA decode indexer across a DCP group over a replicated index K.
+
+Every DCP rank holds the whole index K, so the paged MQA scoring of a decode,
+target-verify or draft-extend row can be divided by context page: rank ``r``
+scores request pages ``r, r + W, ...``, keeps a local top-k, and the ranks
+all-gather (score, position) candidates and merge them. The merge is exact: a
+token in the global top-k is in the local top-k of the rank that scored it.
+"""
+
+from __future__ import annotations
+
+from typing import Callable, Optional, Tuple
+
+import msgspec
+import torch
+
+
+def owned_page_table(block_tables: torch.Tensor, w: int, r: int) -> torch.Tensor:
+    """[rows, pages] request page table -> the pages rank ``r`` scores."""
+    return block_tables[:, r::w].contiguous()
+
+
+def owned_lens(lens: torch.Tensor, page: int, w: int, r: int) -> torch.Tensor:
+    """Tokens of ``[0, lens)`` that fall in pages ``r, r + w, ...`` (int32).
+
+    Only the page holding position ``lens - 1`` can be partial, and owned pages
+    are scored in order, so the owned positions are a prefix of the local logits.
+    """
+    lens = lens.to(torch.int64).clamp(min=0)
+    full = lens // page
+    rem = lens % page
+    owned_full = ((full - r + w - 1) // w).clamp(min=0)
+    tail = torch.where(full % w == r, rem, torch.zeros_like(rem))
+    return (owned_full * page + tail).to(torch.int32)
+
+
+def local_to_global_pos(
+    local_idx: torch.Tensor, page: int, w: int, r: int
+) -> torch.Tensor:
+    """Local logits column -> request position; negative stays -1."""
+    idx = local_idx.to(torch.int64)
+    pos = ((idx // page) * w + r) * page + idx % page
+    return torch.where(idx >= 0, pos, torch.full_like(pos, -1)).to(torch.int32)
+
+
+def pack_candidates(
+    local_logits: torch.Tensor,
+    local_idx: torch.Tensor,
+    local_lens: torch.Tensor,
+    topk: int,
+    page: int,
+    w: int,
+    r: int,
+) -> torch.Tensor:
+    """[2, rows, topk] int32: fp32 score bits (-inf if invalid), global pos (-1)."""
+    rows = local_idx.shape[0]
+    idx = local_idx.to(torch.int64)
+    valid = (idx >= 0) & (idx < local_lens.view(rows, 1).to(torch.int64))
+    safe = torch.where(valid, idx, torch.zeros_like(idx))
+    width = local_logits.shape[1]
+    if width == 0:
+        scores = torch.full(
+            (rows, topk), -float("inf"), dtype=torch.float32, device=idx.device
+        )
+    else:
+        scores = local_logits.float().gather(1, safe.clamp(max=width - 1))
+    scores = torch.where(valid, scores, torch.full_like(scores, -float("inf")))
+    pos = torch.where(
+        valid,
+        local_to_global_pos(safe, page, w, r).to(torch.int64),
+        torch.full_like(idx, -1),
+    )
+    out = torch.empty((2, rows, topk), dtype=torch.int32, device=idx.device)
+    out[0] = scores.contiguous().view(torch.int32)
+    out[1] = pos.to(torch.int32)
+    return out
+
+
+def merge_candidates(gathered: torch.Tensor, w: int, topk: int) -> torch.Tensor:
+    """[w * 2, rows, topk] gathered packs -> [rows, topk] global positions (-1 padded)."""
+    packs = gathered.view(w, 2, gathered.shape[1], topk)
+    scores = packs[:, 0].contiguous().view(torch.float32)  # [w, rows, topk]
+    pos = packs[:, 1]
+    rows = packs.shape[2]
+    scores = scores.permute(1, 0, 2).reshape(rows, w * topk)
+    pos = pos.permute(1, 0, 2).reshape(rows, w * topk)
+    best, pick = torch.topk(scores, topk, dim=1)
+    chosen = pos.gather(1, pick)
+    return torch.where(best > -float("inf"), chosen, torch.full_like(chosen, -1))
