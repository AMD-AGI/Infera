From da6e38351384b9d79aad96808746a9d3cb749d07 Mon Sep 17 00:00:00 2001
From: yihou <yihou@amd.com>
Date: Wed, 21 Oct 2026 20:18:42 +0000
Subject: [PATCH 27/31] [Fix] dsa: Skip the indexer on an eager idle DP rank on
 ROCm too

An eager IDLE forward (a DP-attention rank padded with no requests) has no
valid page-table rows or lengths for the indexer to score. The short
circuit that returns all-invalid top-k rows was gated on CUDA only, so on
ROCm the idle rank ran the indexer on its padding rows. Under DP2 x DCP2
the NextN draft's idle forward then hit a memory access fault in the
paged top-k v2 kernel (_topk_transform_v2_paged), found with
AMD_SERIALIZE_KERNEL=3.

Take the same short circuit on HIP.

Co-Authored-By: Claude <noreply@anthropic.com>
Signed-off-by: yihou <yihou@amd.com>
(cherry picked from commit fdf73b6fb20ddc46b85c09876b6f2a670fe6b5cb)
---
 .../srt/layers/attention/dsa/dsa_indexer.py    | 18 +++++++++++++-----
 .../layers/attention/test_dsa_indexer_idle.py  | 10 +++++++++-
 2 files changed, 22 insertions(+), 6 deletions(-)

diff --git a/python/sglang/srt/layers/attention/dsa/dsa_indexer.py b/python/sglang/srt/layers/attention/dsa/dsa_indexer.py
index 21d0989945..879892b0f6 100644
--- a/python/sglang/srt/layers/attention/dsa/dsa_indexer.py
+++ b/python/sglang/srt/layers/attention/dsa/dsa_indexer.py
@@ -236,6 +236,18 @@ def _broadcast_indexer_topk_from_rank0(
     return topk_indices
 
 
+def _skips_eager_idle(forward_batch: ForwardBatch) -> bool:
+    """Whether the indexer returns all-invalid rows without running: an eager
+    IDLE forward (a DP-attention rank padded with no requests) has no valid
+    page-table rows or lengths to score. On ROCm the paged top-k v2 kernel
+    faulted on them in the idle NextN draft forward under DP2 x DCP2."""
+    return (
+        (_is_cuda or _is_hip)
+        and forward_batch.forward_mode.is_idle()
+        and not get_is_capture_mode()
+    )
+
+
 def _make_eager_idle_topk_result(
     x: torch.Tensor, index_topk: int, return_indices: bool
 ) -> Optional[torch.Tensor]:
@@ -2125,11 +2137,7 @@ class Indexer(DSANPUIndexerMixin, BaseFusedOp):
         # DSA page-table rows to index. Return invalid rows with the physical DP
         # shape so later MLP/EP collectives still agree across ranks.
         x_meta = x[0] if isinstance(x, tuple) else x
-        if (
-            _is_cuda
-            and forward_batch.forward_mode.is_idle()
-            and not get_is_capture_mode()
-        ):
+        if _skips_eager_idle(forward_batch):
             topk_result = _make_eager_idle_topk_result(
                 x_meta, self.index_topk, return_indices
             )
diff --git a/test/registered/unit/layers/attention/test_dsa_indexer_idle.py b/test/registered/unit/layers/attention/test_dsa_indexer_idle.py
index 3af04bf07c..2b5c2a10fa 100644
--- a/test/registered/unit/layers/attention/test_dsa_indexer_idle.py
+++ b/test/registered/unit/layers/attention/test_dsa_indexer_idle.py
@@ -38,11 +38,19 @@ class TestDSAIndexerIdle(unittest.TestCase):
         )
 
     def test_eager_idle_short_circuits_before_paged_mqa(self):
+        for is_cuda, is_hip in ((True, False), (False, True)):
+            with self.subTest(is_cuda=is_cuda, is_hip=is_hip):
+                self._check_eager_idle_short_circuits(is_cuda, is_hip)
+
+    def _check_eager_idle_short_circuits(self, is_cuda, is_hip):
+        # On ROCm the idle rank of a DP2 x DCP2 server faulted in the paged
+        # top-k v2 kernel when the indexer ran on its padding rows.
         indexer = SimpleNamespace(index_topk=4)
         batch = SimpleNamespace(forward_mode=ForwardMode.IDLE)
 
         with (
-            patch(f"{_INDEXER}._is_cuda", True),
+            patch(f"{_INDEXER}._is_cuda", is_cuda),
+            patch(f"{_INDEXER}._is_hip", is_hip),
             patch(f"{_INDEXER}.get_is_capture_mode", return_value=False),
             patch(
                 f"{_INDEXER}._broadcast_indexer_topk_from_rank0",
-- 
