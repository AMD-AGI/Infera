+class _FakeGlooGroup:
+    """Two in-process ranks whose all_reduce rendezvous across threads."""
+
+    def __init__(self, world_size=2):
+        self.world_size = world_size
+        self.barrier = threading.Barrier(world_size)
+        self.slots = [None] * world_size
+        self.calls = [0] * world_size
+
+    def rank_handle(self, rank):
+        return SimpleNamespace(group=self, rank=rank)
+
+    @staticmethod
+    def all_reduce(tensor, op, group):
+        import torch
+
+        g, rank = group.group, group.rank
+        g.calls[rank] += 1
+        g.slots[rank] = tensor.clone()
+        g.barrier.wait()
+        stacked = torch.stack(g.slots)
+        if op == torch.distributed.ReduceOp.MIN:
+            reduced = stacked.min(dim=0).values
+        else:
+            reduced = stacked.max(dim=0).values
+        g.barrier.wait()
+        tensor.copy_(reduced)
+
+
+def _run_ranks(fns):
+    errors = []
+
+    def run(fn):
+        try:
+            fn()
+        except BaseException as e:  # surfaced to the test thread below
+            errors.append(e)
+
+    threads = [threading.Thread(target=run, args=(fn,)) for fn in fns]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join(timeout=10)
+    return errors
+
+
+class TestRankConsistentDeferredRelease(CustomTestCase):
+    """Attn-TP ranks must free deferred KV in the same iteration: a rank-local
+    ack or deadline decision diverges prealloc admission and hangs the poll
+    all-reduce (TP ranks stuck in different collectives after client cancels)."""
+
+    def _ranks(self):
+        group = _FakeGlooGroup()
+        ranks = []
+        for rank in range(2):
+            mgr = _make_manager()
+            q = _make_queue(timeout=30.0)
+            q.gloo_group = group.rank_handle(rank)
+            q.gloo_world_size = 2
+            q.tp_rank = rank
+            dreq = _make_decode_req(room=500, idx=6, mgr=mgr)
+            generation = mgr.register_deferred_abort_room(500)
+            ranks.append((q, mgr, dreq, generation))
+        return group, ranks
+
+    def _resolve_all(self, ranks, now):
+        with (
+            patch.object(decode_mod.time, "monotonic", return_value=now),
+            patch("torch.distributed.all_reduce", _FakeGlooGroup.all_reduce),
+            patch.object(decode_mod, "release_kv_cache"),
+        ):
+            errors = _run_ranks([q.resolve_deferred_releases for q, *_ in ranks])
+        self.assertEqual(errors, [])
+        return [len(q._deferred_releases) for q, *_ in ranks]
+
+    def test_ack_on_one_rank_holds_every_rank(self):
+        _, ranks = self._ranks()
+        for q, _, dreq, _ in ranks:
+            q._deferred_releases.append((dreq, 0.0, 30.0, 6, 1))
+        q0, mgr0, _, gen0 = ranks[0]
+        mgr0.note_abort_ack(500, 0, gen0)
+        self.assertEqual(self._resolve_all(ranks, now=1.0), [1, 1])
+        _, mgr1, _, gen1 = ranks[1]
+        mgr1.note_abort_ack(500, 0, gen1)
+        self.assertEqual(self._resolve_all(ranks, now=2.0), [0, 0])
+
+    def test_deadline_on_one_rank_holds_every_rank(self):
+        _, ranks = self._ranks()
+        # Rank 0 armed earlier, so its local deadline passes first.
+        ranks[0][0]._deferred_releases.append((ranks[0][2], 0.0, 10.0, 6, 1))
+        ranks[1][0]._deferred_releases.append((ranks[1][2], 5.0, 15.0, 6, 1))
+        self.assertEqual(self._resolve_all(ranks, now=12.0), [1, 1])
+        self.assertEqual(self._resolve_all(ranks, now=16.0), [0, 0])
+
+
+class TestPopTransferredQueueLengthConsensus(CustomTestCase):
+    """pop_transferred must not skip its poll all-reduce on a rank-local empty
+    queue while a peer enters it."""
+
+    def _queue(self, group, rank, n):
+        mgr = _make_manager()
+        q = _make_pop_queue(mgr)
+        q.gloo_group = group.rank_handle(rank)
+        q.gloo_world_size = 2
+        q.tp_rank = rank
+        q.queue = [
+            _make_failed_req(mgr, room=900 + i, idx=i, abort_notified=True)
+            for i in range(n)
+        ]
+        q._poll_with_metadata_gate = lambda: [KVPoll.Transferring] * len(q.queue)
+        return q
+
+    def _pop_all(self, queues):
+        results = [None] * len(queues)
+
+        def pop(i):
+            def fn():
+                results[i] = queues[i].pop_transferred()
+
+            return fn
+
+        with patch("torch.distributed.all_reduce", _FakeGlooGroup.all_reduce):
+            errors = _run_ranks([pop(i) for i in range(len(queues))])
+        return results, errors
+
+    def test_all_empty_returns_after_one_collective(self):
+        group = _FakeGlooGroup()
+        results, errors = self._pop_all([self._queue(group, r, 0) for r in range(2)])
+        self.assertEqual(errors, [])
+        self.assertEqual(results, [[], []])
+        self.assertEqual(group.calls, [1, 1])
+
+    def test_equal_lengths_proceed_to_poll(self):
+        group = _FakeGlooGroup()
+        queues = [self._queue(group, r, 2) for r in range(2)]
+        results, errors = self._pop_all(queues)
+        self.assertEqual(errors, [])
+        self.assertEqual(results, [[], []])
+        self.assertEqual([len(q.queue) for q in queues], [2, 2])
+
+    def test_divergent_lengths_fail_loudly_on_every_rank(self):
+        group = _FakeGlooGroup()
+        queues = [self._queue(group, 0, 0), self._queue(group, 1, 2)]
+        _, errors = self._pop_all(queues)
+        self.assertEqual(len(errors), 2)
+        for e in errors:
+            self.assertIsInstance(e, RuntimeError)
+            self.assertIn("diverged across attn-TP ranks", str(e))
+
+
