+class TestOwnedInputsPerForward(CustomTestCase):
+    """The owned page table and lens are computed once per forward and reused by
+    later indexer layers, but never carried into the next forward."""
+
+    def _call(self, cache, metadata, layer_id, tables, lens):
+        return owned_inputs(
+            cache,
+            metadata=metadata,
+            layer_id=layer_id,
+            block_tables=tables,
+            lens=lens,
+            page=4,
+            w=4,
+            r=1,
+        )
+
+    def test_reuse_within_forward_recompute_across(self):
+        tables = torch.arange(3 * 9, dtype=torch.int32).view(3, 9)
+        lens = torch.tensor([5, 17, 33], dtype=torch.int32)
+        meta, cache = object(), OwnedInputsCache()
+        first = self._call(cache, meta, 0, tables, lens)
+        self.assertTrue(torch.equal(first[0], owned_page_table(tables, 4, 1)))
+        self.assertTrue(torch.equal(first[1], owned_lens(lens, 4, 4, 1)))
+        # A slice of the same storage, as each layer passes, still hits.
+        again = self._call(cache, meta, 6, tables[:3], lens[:3])
+        self.assertIs(again[0], first[0])
+        # Non-increasing layer id: the next forward (e.g. the next draft step on
+        # the same metadata object) recomputes from the updated lens.
+        lens.add_(1)
+        nxt = self._call(cache, meta, 6, tables, lens)
+        self.assertIsNot(nxt[0], first[0])
+        self.assertTrue(torch.equal(nxt[1], owned_lens(lens, 4, 4, 1)))
+        # Another forward's metadata, or different rows, recomputes too.
+        self.assertIsNot(self._call(cache, object(), 10, tables, lens)[0], nxt[0])
+        other = self._call(cache, meta, 20, tables[:2], lens[:2])
+        self.assertEqual(other[0].shape[0], 2)
+
+
 if __name__ == "__main__":
     unittest.main()
