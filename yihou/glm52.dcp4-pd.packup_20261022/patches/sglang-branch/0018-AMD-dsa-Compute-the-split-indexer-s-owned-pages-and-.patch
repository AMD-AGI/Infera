 import torch
 
 
@@ -99,6 +100,53 @@ def positions_to_slots(
     return torch.where(p >= 0, slots, torch.full_like(slots, -1)).to(torch.int32)
 
 
+class OwnedInputsCache(msgspec.Struct):
+    """Per-forward reuse of the owned page table and lens across indexer layers.
+
+    They depend only on the forward's page table and lens, not on the layer. A
+    new forward is detected by a different forward metadata object, a layer id
+    that does not increase, or a different (pointer, shape) of either input.
+    """
+
+    metadata: object = None
+    layer_id: int = -1
+    key: Optional[Tuple] = None
+    tables: Optional[torch.Tensor] = None
+    lens: Optional[torch.Tensor] = None
+
+
+def _input_key(block_tables: torch.Tensor, lens: torch.Tensor) -> Tuple:
+    return (
+        block_tables.data_ptr(),
+        tuple(block_tables.shape),
+        lens.data_ptr(),
+        tuple(lens.shape),
+    )
+
+
+def owned_inputs(
+    cache: OwnedInputsCache,
+    *,
+    metadata: object,
+    layer_id: int,
+    block_tables: torch.Tensor,
+    lens: torch.Tensor,
+    page: int,
+    w: int,
+    r: int,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    key = _input_key(block_tables, lens)
+    if not (
+        cache.metadata is metadata and layer_id > cache.layer_id and cache.key == key
+    ):
+        cache.metadata = metadata
+        cache.key = key
+        cache.tables = owned_page_table(block_tables, w, r)
+        cache.lens = owned_lens(lens, page, w, r)
+    cache.layer_id = layer_id
+    return cache.tables, cache.lens
+
+
 def split_decode_topk(
     *,
     block_tables: torch.Tensor,
@@ -110,16 +158,19 @@ def split_decode_topk(
     logits_fn: Callable[[torch.Tensor, torch.Tensor, int], torch.Tensor],
     local_topk_fn: Callable[[torch.Tensor, torch.Tensor, int], torch.Tensor],
     all_gather_fn: Callable[[torch.Tensor], torch.Tensor],
+    owned: Optional[Tuple[torch.Tensor, torch.Tensor]] = None,
 ) -> torch.Tensor:
     """Global top-k request positions [rows, topk] (-1 padded) for every row.
 
     ``logits_fn(owned_block_tables, owned_lens, max_len)`` scores this rank's
     pages; ``local_topk_fn(logits, lens, k)`` returns column indices;
     ``all_gather_fn`` concatenates the [2, rows, topk] packs of all W ranks
-    along dim 0 in rank order.
+    along dim 0 in rank order. ``owned`` passes precomputed
+    (``owned_page_table``, ``owned_lens``) for these inputs.
     """
-    local_tables = owned_page_table(block_tables, w, r)
-    local_lens = owned_lens(lens, page, w, r)
+    if owned is None:
+        owned = (owned_page_table(block_tables, w, r), owned_lens(lens, page, w, r))
+    local_tables, local_lens = owned
     local_logits = logits_fn(local_tables, local_lens, local_tables.shape[1] * page)
     if local_logits.shape[1] < topk:
         local_logits = torch.nn.functional.pad(
@@ -128,3 +179,8 @@ def split_decode_topk(
     local_idx = local_topk_fn(local_logits, local_lens, topk)
     pack = pack_candidates(local_logits, local_idx, local_lens, topk, page, w, r)
     return merge_candidates(all_gather_fn(pack), w, topk)
+
+
+# One per process: draft and target forwards use different forward metadata
+# objects, so they never share an entry.
+OWNED_INPUTS_CACHE = OwnedInputsCache()
