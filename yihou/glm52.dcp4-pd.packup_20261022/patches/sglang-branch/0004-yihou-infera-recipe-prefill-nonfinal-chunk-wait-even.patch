From e11f97495d8204258123759ea7ef90cc48c93e8e Mon Sep 17 00:00:00 2001
From: yihou <yihou@amd.com>
Date: Wed, 21 Oct 2026 13:09:14 +0000
Subject: [PATCH 04/31] [yihou] infera recipe: prefill nonfinal-chunk wait
 event

Infera image patch patch_prefill_nonfinal_chunk_wait_event.py.

Co-Authored-By: Claude <noreply@anthropic.com>
Signed-off-by: yihou <yihou@amd.com>
---
 python/sglang/srt/disaggregation/prefill.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/python/sglang/srt/disaggregation/prefill.py b/python/sglang/srt/disaggregation/prefill.py
index 5f85be3815..11e1963392 100644
--- a/python/sglang/srt/disaggregation/prefill.py
+++ b/python/sglang/srt/disaggregation/prefill.py
@@ -1097,6 +1097,13 @@ class SchedulerDisaggregationPrefillMixin:
                     assert req.metadata_buffer_index >= 0, (
                         f"Req {req.rid} does not have metadata buffer allocated"
                     )
+                    # Non-final chunks are handed over while later chunks are
+                    # already running on forward_stream, and the transfer worker
+                    # reads device memory outside the CUDA stream. Gate the read
+                    # on this chunk's writes completing.
+                    _infera_nonfinal_chunk_wait_event = torch.cuda.Event()
+                    _infera_nonfinal_chunk_wait_event.record(self.forward_stream)
+                    req.disagg_kv_sender._early_send_wait_event = _infera_nonfinal_chunk_wait_event
                     self.send_kv_chunk(req, last_chunk=False, end_idx=req.tmp_end_idx)
                 req.time_stats.set_last_chunked_prefill_finish_time()
 
