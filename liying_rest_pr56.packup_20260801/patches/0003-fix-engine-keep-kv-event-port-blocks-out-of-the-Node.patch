From eef9bfcbd7658879f28eab0dbe3036160a2964ed Mon Sep 17 00:00:00 2001
From: yihou <yihou@amd.com>
Date: Sat, 1 Aug 2026 05:56:08 +0000
Subject: [PATCH 3/3] fix(engine): keep kv-event port blocks out of the
 NodePort range

`free_tcp_port_block` scans below the ephemeral range, which on a default host
means it can hand back a block inside 30000-32767 -- the Kubernetes NodePort
range. Any Service in the cluster can claim a port in that window at any time,
and kube-proxy in IPVS mode then owns it on *every* node address with no real
server behind it here, so traffic to the node IP is swallowed before it reaches
our listener and the kernel answers RST.

The bind probe cannot see this: the port is free, it binds, and loopback works.
Only a peer dialing the address we advertise breaks, which is exactly the router
subscribing to a worker's kv-events -- so the router's cache view stays empty
and kv-aware routing quietly degrades to load balancing.

Skip the window during the scan, overridable with `$INFERA_NODEPORT_RANGE` for a
cluster that moved the range (`none` drops the guard); a malformed value keeps
the default rather than dropping it.

Adapted from liyingli's PR #56 (d63e48b), which does not apply as-is: 826619b on
this branch rewrote the same loop to randomise the scan start (a fixed start
made two PD legs on one host pick the same base deterministically). Both fixes
belong to that one loop, so this keeps `itertools.chain(randomised, exhaustive)`
and adds the reserved-window skip as the first statement of the loop body -- the
guard applies to the random probes and the fallback scan alike.

For the same reason liying's separate `tests/unit/common/test_net_ports.py` is
folded into the existing `test_net_port_block.py` rather than added alongside
it: same function, same subject, and two files asserting on one loop would only
conflict again. The merged suite asserts both properties together, since a base
must now be both spread out and outside the window.

Verified in the built image on chi2879: 40 consecutive `free_tcp_port_block(8)`
calls, none overlapping 30000-32767, more than one distinct base; `none` drops
the guard and `not-a-range` keeps it. 10 passed.

Co-authored-by: liyingli <liyingli@amd.com>
Co-Authored-By: Claude <noreply@anthropic.com>
---
 infera/common/net.py                     | 49 +++++++++++++++++++
 manual/reference/environment.md          |  7 +++
 tests/unit/common/test_net_port_block.py | 60 +++++++++++++++++++++---
 3 files changed, 109 insertions(+), 7 deletions(-)

diff --git a/infera/common/net.py b/infera/common/net.py
index 1fe61dd..346bfc7 100644
--- a/infera/common/net.py
+++ b/infera/common/net.py
@@ -6,13 +6,54 @@
 from __future__ import annotations
 
 import itertools
+import logging
+import os
 import random
 import socket
 
+logger = logging.getLogger(__name__)
+
 # How many randomly-chosen bases free_tcp_port_block tries before falling back
 # to an exhaustive scan.
 _PORT_BLOCK_TRIES = 64
 
+# Kubernetes' default --service-node-port-range. A port in this window can be
+# claimed cluster-wide by any Service at any time; kube-proxy in IPVS mode then
+# creates an IPVS service for it on *every* node address, with no real server
+# backing it on this node. Traffic to a node IP is then swallowed by IPVS before
+# it reaches a local 0.0.0.0 listener and the kernel answers RST, so the port
+# stays bindable and reachable over loopback while being "connection refused"
+# from the node IP -- which is the address we advertise to peers.
+_NODEPORT_RANGE_DEFAULT = "30000-32767"
+
+
+def _parse_port_range(spec: str) -> tuple[int, int] | None:
+    lo, _, hi = spec.partition("-")
+    try:
+        return int(lo), int(hi)
+    except ValueError:
+        return None
+
+
+def _reserved_nodeport_range() -> tuple[int, int] | None:
+    """The port window to keep out of, or None when the caller opted out.
+
+    ``INFERA_NODEPORT_RANGE="lo-hi"`` for a cluster that moved the range,
+    ``"none"`` to drop the guard. An unparseable value keeps the default
+    rather than silently dropping the guard.
+    """
+    spec = os.environ.get("INFERA_NODEPORT_RANGE", _NODEPORT_RANGE_DEFAULT).strip()
+    if spec.lower() in ("", "none", "off"):
+        return None
+    parsed = _parse_port_range(spec)
+    if parsed is None:
+        logger.warning(
+            "INFERA_NODEPORT_RANGE=%r is not a 'lo-hi' range; using the default %s",
+            spec,
+            _NODEPORT_RANGE_DEFAULT,
+        )
+    return parsed or _parse_port_range(_NODEPORT_RANGE_DEFAULT)
+
 
 def free_tcp_port() -> int:
     """Bind to port 0 to let the kernel assign a free port, then release.
@@ -48,6 +89,9 @@ def free_tcp_port_block(count: int) -> int:
     from the same place, both saw the same free block, and the second died with
     ``ZMQError: Address already in use`` on ``base + rank``. Randomising spreads
     the picks so concurrent callers land on different blocks.
+
+    The scan also skips the Kubernetes NodePort range, which a loopback bind
+    probe cannot rule out on its own.
     """
     if count <= 1:
         return free_tcp_port()
@@ -55,12 +99,17 @@ def free_tcp_port_block(count: int) -> int:
         low = int(open("/proc/sys/net/ipv4/ip_local_port_range").read().split()[0])
     except (OSError, ValueError, IndexError):
         low = 32768
+    reserved = _reserved_nodeport_range()
     # Candidate window: [1024, low - count]. Probe randomly-chosen bases first,
     # then fall back to an exhaustive downward scan so we never fail while a
     # block is still available.
     highest = low - count
     randomised = [random.randint(1024, highest) for _ in range(_PORT_BLOCK_TRIES)]
     for base in itertools.chain(randomised, range(highest, 1024, -1)):
+        # A block inside the NodePort range binds and answers on loopback here,
+        # so only skipping it up front keeps it out of the advertised endpoint.
+        if reserved and base + count - 1 >= reserved[0] and base <= reserved[1]:
+            continue
         socks: list[socket.socket] = []
         try:
             for off in range(count):
