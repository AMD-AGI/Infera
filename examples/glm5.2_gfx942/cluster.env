#!/usr/bin/env bash
# Cluster overlay for tus1-p15-g43 / tus1-p15-g61 (MI325X, gfx942).
# Source this BEFORE any script here, on the host and inside the container:
#   source cluster.env && bash launch/launch_prefill.sh
# It only exports the values env.sh takes from the environment; env.sh still owns
# the tuned recipe.

# --- topology ---------------------------------------------------------------
# The tw-ethN NICs are the RoCE fabric; eno0/eno1 are management and must not be
# advertised (README gotcha 5). Rail 0 is tw-eth0 <-> rdma0 on both nodes, and
# the ip rule "from 10.115.x.100/31 lookup 100" keeps traffic sourced there on
# that rail rather than falling through the destination rules to tw-eth3.
export PREFILL_NODE=tus1-p15-g43
export DECODE_NODE=tus1-p15-g61
export PREFILL_IP=10.115.43.101
export DECODE_IP=10.115.61.101

# g43 is an RKE2 server node and its control-plane etcd already holds 2379/2380
# (on 127.0.0.1 and the eno0 management IP). Move PD's own etcd off both.
export ETCD_ENDPOINT=10.115.43.101:12379

# --- fabric -----------------------------------------------------------------
# This cluster names its HCAs rdma0..rdma7, not mlx5_N. GID 3 is the RoCE v2
# IPv4 entry on rdma0 (gid_attrs/types/3 = "RoCE v2", ::ffff:10.115.43.101).
export IB_DEVICE=rdma0
export MC_GID_INDEX=3

# --- model / image ----------------------------------------------------------
export MODEL=/shared_silo/scratch/models/zai-org/GLM-5.2-FP8
# Built here by build_image.sh from this checkout, not the amdsiloai image the
# nodes came with: that one dates to 2026-08-04 and predates the sglang_rocm
# hicache patches (merged 08-11), so its sglang tree is not this repo's.
# The tag carries the commit so a running container can be traced back to source.
export IMAGE=infera:sglang-gfx942-glm52-5c9cb3f
