#!/usr/bin/env bash
# Cluster overlay. Copy to cluster.env and fill in for your cluster:
#
#   cp cluster.env.example cluster.env    # then edit
#
# Nothing else to do -- env.sh reads cluster.env first, and every script here
# sources env.sh. The same file serves the host and the container, because the
# repo is bind-mounted at the same path in both.
#
# This file holds only the values env.sh takes from the environment. env.sh still
# owns the tuned recipe; do not edit env.sh to adapt to a cluster.
#
# Every value below has a way to find it rather than guess it, given inline. Three
# of them fail SILENTLY when wrong -- MC_GID_INDEX, the advertised IPs, and
# ETCD_ENDPOINT -- so they are worth the two minutes each.

# --- topology ---------------------------------------------------------------
# One prefill node, which also hosts etcd and the router, and one decode node.
export PREFILL_NODE=node-0
export DECODE_NODE=node-1

# These MUST be the nodes' addresses on the DATA network, not the management one.
# A management IP does not fail at startup: both legs register happily and the
# hole only opens at the first KV hand-off -- which is after the weights load, so
# discovering it costs a full cold start.
#
#   ip -4 addr show <data-nic>    # the NIC that carries your RoCE fabric
export PREFILL_IP=10.0.0.1
export DECODE_IP=10.0.0.2

# etcd for prefill/decode discovery, on the prefill node. 2379 is the default and
# is fine unless something already holds it -- a Kubernetes control plane on the
# same node is the usual collision, and it takes the port on both 127.0.0.1 and
# the management IP. launch_etcd.sh derives the peer port as client port + 1.
#
#   ss -lntp | grep -E ':2379|:2380'
export ETCD_ENDPOINT=${PREFILL_IP}:2379

# --- fabric -----------------------------------------------------------------
# The RoCE HCA Mooncake moves KV over. Naming varies: mlx5_0 on Mellanox/ConnectX,
# rdma0..rdma7 on some AMD/IONIC configurations.
#
#   ibstat -l          # or: rdma link
#
# Pick a rail that is ACTIVE on BOTH nodes. A rail that is down on one side does
# not report a transport error -- the decode leg loads weights, allocates KV,
# starts serving, and then dies in PD warmup with `Memory access fault by GPU
# node-N`, thousands of log lines after the three info lines that explain it.
export IB_DEVICE=mlx5_0

# The RoCE v2 GID index ON THAT RAIL. This is the single most expensive value to
# get wrong: a wrong index does not error, it just runs 4-110x slower. It is also
# NOT portable between clusters -- index 3 is the RoCE v2 entry on some and the
# management NIC on others.
#
#   for i in $(seq 0 7); do
#     echo "$i $(cat /sys/class/infiniband/$IB_DEVICE/ports/1/gid_attrs/types/$i 2>/dev/null)" \
#          "$(cat /sys/class/infiniband/$IB_DEVICE/ports/1/gids/$i 2>/dev/null)"
#   done
#
# Take the index whose type is `RoCE v2` and whose GID is the IPv4-mapped form of
# this node's data IP (::ffff:10.0.0.1). If the rails carry no IPv4 at all, every
# entry is fe80::, and the RoCE v2 one is usually index 1 -- see the k8s guide,
# which also has to pin Mooncake to one rail in that case.
export MC_GID_INDEX=3

# --- model / image ----------------------------------------------------------
# A local directory, mounted read-only. May be a HuggingFace snapshot path or a
# symlink into one; host_container.sh detects that and mounts the repo root so
# the snapshot's links into blobs/ still resolve.
export MODEL=/your/path/GLM-5.2-FP8

# Build it with build_image.sh -- do not use a vendor-preinstalled GLM-5.2 image.
# Tagging with the source commit is what lets a running container be traced back
# to the tree it was built from.
export IMAGE=infera:sglang-gfx942-glm52

# Where the agentic trace is written and read. Defaults to ./data under this
# directory; point it at scratch if you would rather not keep ~1 GB in the repo.
# export DATA_DIR=/your/path/agentic-data

# --- operating point --------------------------------------------------------
# env.sh defaults to DP=8 / CHUNK=8192, which is the batch point: it was tuned at
# concurrency 16 and delivers the best aggregate throughput. Uncomment the pair
# below for the interactive point, which trades ~24% of aggregate throughput for
# roughly 2x the per-user speed at concurrency 1 -- the configuration to use when
# the target is single-stream responsiveness rather than total tokens served.
#
# Set BOTH, on BOTH nodes. CHUNK is a global budget that SGLang divides by dp_size
# only while dp-attention is on, so leaving it at 8192 with DP=1 asks for 8x the
# activation memory rather than the same amount.
#
# export DP=1          # DP=1 disables dp-attention: the flag is only added when DP>1
# export CHUNK=2048    # largest value measured here that does not OOM at DP=1

# ----------------------------------------------------------------------------
# A worked example -- the validated 2x MI325X pair this recipe was measured on:
#
#   export PREFILL_NODE=gpu-node-0       # also the RKE2 control-plane node
#   export DECODE_NODE=gpu-node-1
#   export PREFILL_IP=10.0.43.101        # a dedicated RoCE NIC carries these;
#   export DECODE_IP=10.0.61.101         # the onboard NICs are management
#   export ETCD_ENDPOINT=10.0.43.101:12379     # 2379/2380 taken by RKE2's etcd
#   export IB_DEVICE=rdma0               # HCAs are rdma0..rdma7, not mlx5_N
#   export MC_GID_INDEX=3                # RoCE v2 IPv4 entry on rdma0
